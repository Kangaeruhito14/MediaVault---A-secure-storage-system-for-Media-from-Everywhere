# MediaVault configuration — copy to .env and adjust.
# Every value is optional; MediaVault runs with zero configuration.

# Canonical public URL of the deployment (used for SEO tags, sitemap, robots.txt).
# Leave unset to derive it from each request.
#PUBLIC_SITE_URL=https://vault.example.com

# Dropbox connector (optional). Set this to your Dropbox app's "App key" to show
# the "Connect Dropbox" button. PKCE is used, so NO app secret is needed and no
# token ever passes through the server. Leave unset to hide the connector.
# Register the app at https://www.dropbox.com/developers/apps (Scoped access,
# App folder) and add redirect URI: <your-origin>/app/connect/dropbox
#PUBLIC_DROPBOX_CLIENT_ID=your_dropbox_app_key

# Hard cap on total vault storage, in bytes (0 or unset = unlimited).
# Example below = 100 GB.
#MEDIAVAULT_MAX_STORAGE=107374182400

# Port for the production server (default 4321).
#PORT=4321

# Bind address. Use 0.0.0.0 to allow other devices on your network.
#HOST=127.0.0.1
