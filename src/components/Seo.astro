---
/**
 * Seo.astro — central SEO head block: canonical, robots, Open Graph,
 * Twitter Cards, and JSON-LD structured data.
 *
 * Canonical URLs derive from the live request origin (with optional
 * PUBLIC_SITE_URL override), so every deployment gets correct
 * absolute URLs without configuration.
 */
interface Props {
  title: string;
  description: string;
  /** Pathname for the canonical URL; defaults to the current request path. */
  path?: string;
  /** OG type, e.g. "website" or "article". */
  type?: string;
  /** Absolute or root-relative OG image. Defaults to the brand card. */
  image?: string;
  /** Suppress indexing (auth pages, app interior). */
  noindex?: boolean;
  /** Page-specific keywords appended to the site-wide set. */
  keywords?: string[];
  /** JSON-LD structured data objects, rendered one script tag each. */
  jsonLd?: Record<string, unknown>[];
}

// Site-wide keyword cluster — the core terms every page should rank for.
// (Google largely ignores the keywords meta today; the real ranking work is in
// titles, on-page copy, structured-data alternateName, and per-cluster pages.
// This stays as a broad, de-duplicated synonym set — harmless and complete.)
const BASE_KEYWORDS = [
  // Brand + name variants
  'Media Reservoir', 'Media Vault', 'MediaVault', 'Open Media Vault', 'media reservoir app',
  // "media + container" synonyms
  'media vault', 'media store', 'media storage', 'media repository', 'media archive',
  'media library', 'media locker', 'media safe', 'media reserve', 'media cloud',
  'media backup', 'media hub', 'media depot', 'media trove', 'media haven', 'media stash',
  // asset variants
  'asset vault', 'asset reserve', 'asset haven', 'asset locker', 'digital asset vault',
  // photo/video specific
  'photo vault', 'video vault', 'private photo vault', 'encrypted photo vault',
  'photo locker', 'private photo storage', 'private video storage',
  // encryption / security intent
  'encrypted media vault', 'encrypted media storage', 'encrypted photo storage',
  'encrypted cloud storage', 'end-to-end encrypted media storage',
  'end-to-end encrypted photo storage', 'zero-knowledge media storage',
  'zero-knowledge photo storage', 'zero-knowledge vault', 'AES-256 encrypted storage',
  'client-side encryption', 'secure media storage', 'secure photo storage',
  'private media storage', 'private media library', 'private cloud storage',
  'private encrypted vault', 'encrypted gallery', 'encrypted photo backup',
  // storage model
  'bring your own storage', 'self-hosted photo storage', 'own your data storage',
  'S3 encrypted storage', 'Cloudflare R2 photo storage', 'Backblaze B2 photo storage',
  // competitor / alternative queries
  'encrypted Google Photos alternative', 'Google Photos alternative', 'iCloud alternative',
  'Dropbox alternative', 'private Google Photos', 'self-hosted Google Photos',
  'Proton Drive alternative', 'Ente alternative', 'Immich alternative', 'PhotoPrism alternative',
  'open source media vault', 'open storage',
];

const {
  title,
  description,
  path = Astro.url.pathname,
  type = 'website',
  image = '/og-image.png',
  noindex = false,
  keywords = [],
  jsonLd = [],
} = Astro.props;

const keywordContent = [...new Set([...BASE_KEYWORDS, ...keywords])].join(', ');

const origin = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '') || Astro.url.origin;
const canonical = new URL(path, origin).href;
const imageUrl = image.startsWith('http') ? image : new URL(image, origin).href;
---

<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
<meta name="keywords" content={keywordContent} />
<meta name="application-name" content="Media Reservoir (Open Media Vault)" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Media Reservoir" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1731" />
<meta property="og:image:height" content="909" />
<meta property="og:image:alt" content="Media Reservoir — end-to-end encrypted media vault over storage you own" />
<meta property="og:locale" content="en_US" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{jsonLd.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
