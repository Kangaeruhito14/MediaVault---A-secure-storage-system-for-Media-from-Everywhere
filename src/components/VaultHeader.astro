---
import { isAuthenticated, isPasswordSet } from '../lib/auth';

const authed = isAuthenticated(Astro.request);
const passwordSet = isPasswordSet();
const currentPath = Astro.url.pathname;
const isGridPage = currentPath === '/vault' || currentPath === '/vault/';

const resourcesLinks = [
  { name: 'About & Tutorial', path: '/about' },
  { name: 'Frequently Asked Questions', path: '/faq' },
  { name: 'Contact Support', path: '/contact' },
  { name: 'Terms of Service', path: '/terms' },
  { name: 'Privacy Policy', path: '/privacy' }
];
---

<header class="vault-header">
  <div class="vault-header-container">
    <!-- Left Section: Logo, Back Mobile (contextual), Vertical Divider, & Dropdown -->
    <div class="header-left">
      <a href="/vault" class="vault-logo" aria-label="MediaVault Vault">
        <div class="logo-icon-box">
          <svg width="14" height="14" viewBox="0 0 28 28" fill="none">
            <rect x="7" y="13" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.8" fill="none"/>
            <path d="M10 13V10a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/>
            <circle cx="14" cy="18" r="1.5" fill="currentColor"/>
          </svg>
        </div>
        <span class="logo-text">MediaVault</span>
      </a>

      {!isGridPage && (
        <a href="/vault" class="back-to-vault-mobile-btn" aria-label="Back to vault" title="Back to vault">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M13 8H3M7 12L3 8l4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
        </a>
      )}

      <div class="divider-vertical"></div>

      <!-- Resources Dropdown -->
      <div class="resources-dropdown">
        <button class="dropdown-trigger" aria-haspopup="true" aria-expanded="false">
          <span>Resources</span>
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" class="arrow-icon">
            <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="dropdown-menu-panel">
          <div class="dropdown-menu-header">PUBLIC PAGES</div>
          {resourcesLinks.map(link => (
            <a href={link.path} class="dropdown-item">{link.name}</a>
          ))}
        </div>
      </div>
    </div>

    <!-- Center Section: Contextual Search & Filters or Back Button -->
    <div class="header-center">
      {isGridPage ? (
        <div class="search-filter-group">
          <!-- Search input -->
          <div class="search-input-wrapper">
            <svg class="search-icon" width="14" height="14" viewBox="0 0 14 14" fill="none">
              <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.3"/>
              <path d="M10 10L13 13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            </svg>
            <input
              id="vault-search-input"
              type="search"
              placeholder="Search files..."
              autocomplete="off"
            />
          </div>

          <!-- Filter tabs -->
          <div class="filter-tabs">
            {[
              { id: 'all',    label: 'All' },
              { id: 'images', label: 'Images' },
              { id: 'videos', label: 'Videos' },
              { id: 'music',  label: 'Music' },
            ].map(({ id, label }) => (
              <button
                class={`filter-tab${id === 'all' ? ' active' : ''}`}
                data-filter={id}
              >{label}</button>
            ))}
          </div>
        </div>
      ) : (
        <a href="/vault" class="back-to-vault-link">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="back-arrow">
            <path d="M13 8H3M7 12L3 8l4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Back to Vault</span>
        </a>
      )}
    </div>

    <!-- Right Section: Actions -->
    <div class="header-right">
      <!-- Theme Toggle -->
      <button
        id="vault-theme-toggle"
        class="action-btn"
        aria-label="Toggle dark/light theme"
        title="Toggle theme"
      >
        <svg id="vault-icon-sun" class="theme-icon" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.4"/>
          <path d="M8 1.5V3M8 13v1.5M1.5 8H3M13 8h1.5M3.5 3.5l1 1M11.5 11.5l1 1M12.5 3.5l-1 1M4.5 11.5l-1 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
        <svg id="vault-icon-moon" class="theme-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" style="display: none;">
          <path d="M13.5 9a6 6 0 0 1-7.5-7.5A6 6 0 1 0 13.5 9z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
        </svg>
      </button>

      <!-- Go to Vault link (shown when NOT on vault grid page, e.g. on media detail) -->
      {!isGridPage && (
        <a href="/vault" class="vault-dash-link" title="Go to Vault">
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
            <rect x="1.5" y="1.5" width="4" height="4" rx="1" stroke="currentColor" stroke-width="1.2"/>
            <rect x="7.5" y="1.5" width="4" height="4" rx="1" stroke="currentColor" stroke-width="1.2"/>
            <rect x="1.5" y="7.5" width="4" height="4" rx="1" stroke="currentColor" stroke-width="1.2"/>
            <rect x="7.5" y="7.5" width="4" height="4" rx="1" stroke="currentColor" stroke-width="1.2"/>
          </svg>
          <span class="vault-dash-label">My Vault</span>
        </a>
      )}

      <!-- Settings button -->
      <button
        id="vault-settings-btn"
        class="action-btn"
        aria-label="Change master password"
        title="Settings"
      >
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none">
          <path d="M7.5 9.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" stroke="currentColor" stroke-width="1.2"/>
          <path d="M12.1 9.5a.9.9 0 0 0 .18 1l.65.65a1 1 0 0 1 0 1.41l-.88.88a1 1 0 0 1-1.41 0l-.65-.65a.9.9 0 0 0-1-.18 4.2 4.2 0 0 1-1 .42.9.9 0 0 0-.69.87V15H5.69v-.9a.9.9 0 0 0-.69-.87 4.2 4.2 0 0 1-1-.42.9.9 0 0 0-1 .18l-.65.65a1 1 0 0 1-1.41 0l-.88-.88a1 1 0 0 1 0-1.41l.65-.65a.9.9 0 0 0 .18-1 4.2 4.2 0 0 1-.42-1A.9.9 0 0 0 0 8.81V7.69h.92a.9.9 0 0 0 .87-.69 4.2 4.2 0 0 1 .42-1 .9.9 0 0 0-.18-1l-.65-.65a1 1 0 0 1 0-1.41l.88-.88a1 1 0 0 1 1.41 0l.65.65a.9.9 0 0 0 1 .18 4.2 4.2 0 0 1 1-.42A.9.9 0 0 0 7.19 2V1h1.62v.9a.9.9 0 0 0 .69.87c.35.11.68.25 1 .42a.9.9 0 0 0 1-.18l.65-.65a1 1 0 0 1 1.41 0l.88.88a1 1 0 0 1 0 1.41l-.65.65a.9.9 0 0 0-.18 1c.17.32.31.65.42 1a.9.9 0 0 0 .87.69H15v1.62h-.92a.9.9 0 0 0-.87.69c-.11.35-.25.68-.42 1z" stroke="currentColor" stroke-width="1.1"/>
        </svg>
      </button>

      <!-- Lock/Logout button -->
      <button
        id="vault-lock-btn"
        class="lock-action-btn"
        title="Lock Vault"
      >
        <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
          <rect x="2.5" y="6" width="8" height="6" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
          <path d="M4.5 6V4.5a2 2 0 0 1 4 0V6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
        <span class="lock-label">Lock</span>
      </button>
    </div>
  </div>

  <!-- Mobile Sub-Header: Search & Filters (Only visible on /vault grid page and small screens) -->
  {isGridPage && (
    <div class="vault-mobile-sub-header">
      <div class="search-filter-group-mobile">
        <div class="search-input-wrapper">
          <svg class="search-icon" width="14" height="14" viewBox="0 0 14 14" fill="none">
            <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.3"/>
            <path d="M10 10L13 13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          </svg>
          <input
            id="vault-search-input-mobile"
            type="search"
            placeholder="Search files..."
            autocomplete="off"
          />
        </div>
        <div class="filter-tabs-wrapper-mobile">
          <div class="filter-tabs">
            {[
              { id: 'all',    label: 'All' },
              { id: 'images', label: 'Images' },
              { id: 'videos', label: 'Videos' },
              { id: 'music',  label: 'Music' },
            ].map(({ id, label }) => (
              <button
                class={`filter-tab${id === 'all' ? ' active' : ''}`}
                data-filter-mobile={id}
              >{label}</button>
            ))}
          </div>
        </div>
      </div>
    </div>
  )}
</header>

<!-- Change Password Modal -->
<div id="settings-modal" class="modal-backdrop" style="display:none;">
  <div class="modal-box" style="max-width: 400px;">
    <div style="margin-bottom: 20px;">
      <h2 style="font-size: 18px; font-weight: 600; color: var(--text-primary); margin-bottom: 4px; letter-spacing: -0.04em;">Change Password</h2>
      <p style="font-size: 13px; color: var(--text-muted);">Enter your current password, then choose a new one.</p>
    </div>
    <form id="change-pw-form" style="display: flex; flex-direction: column; gap: 10px;">
      <!-- Current password -->
      <div style="position: relative;">
        <input id="cp-current" type="password" class="form-input" placeholder="Current password" autocomplete="current-password" required style="padding-right: 44px;" />
        <button type="button" class="pw-toggle" data-target="cp-current" aria-label="Show/hide" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--text-faint);padding:4px;display:flex;align-items:center;transition:color 0.15s;" onmouseenter="this.style.color='var(--text-primary)'" onmouseleave="this.style.color='var(--text-faint)'">
          <svg class="eye-svg" width="17" height="17" viewBox="0 0 17 17" fill="none"><path d="M1 8.5c1.7-3.8 4.3-5.7 7.5-5.7S15.3 4.7 17 8.5c-1.7 3.8-4.3 5.7-7.5 5.7S2.7 12.3 1 8.5z" stroke="currentColor" stroke-width="1.3"/><circle cx="8.5" cy="8.5" r="2.3" stroke="currentColor" stroke-width="1.3"/></svg>
        </button>
      </div>
      <!-- New password -->
      <div style="position: relative;">
        <input id="cp-new" type="password" class="form-input" placeholder="New password (min 8 chars)" autocomplete="new-password" required minlength="8" style="padding-right: 44px;" />
        <button type="button" class="pw-toggle" data-target="cp-new" aria-label="Show/hide" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--text-faint);padding:4px;display:flex;align-items:center;transition:color 0.15s;" onmouseenter="this.style.color='var(--text-primary)'" onmouseleave="this.style.color='var(--text-faint)'">
          <svg class="eye-svg" width="17" height="17" viewBox="0 0 17 17" fill="none"><path d="M1 8.5c1.7-3.8 4.3-5.7 7.5-5.7S15.3 4.7 17 8.5c-1.7 3.8-4.3 5.7-7.5 5.7S2.7 12.3 1 8.5z" stroke="currentColor" stroke-width="1.3"/><circle cx="8.5" cy="8.5" r="2.3" stroke="currentColor" stroke-width="1.3"/></svg>
        </button>
      </div>
      <!-- Confirm password -->
      <div style="position: relative;">
        <input id="cp-confirm" type="password" class="form-input" placeholder="Confirm new password" autocomplete="new-password" required style="padding-right: 44px;" />
        <button type="button" class="pw-toggle" data-target="cp-confirm" aria-label="Show/hide" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--text-faint);padding:4px;display:flex;align-items:center;transition:color 0.15s;" onmouseenter="this.style.color='var(--text-primary)'" onmouseleave="this.style.color='var(--text-faint)'">
          <svg class="eye-svg" width="17" height="17" viewBox="0 0 17 17" fill="none"><path d="M1 8.5c1.7-3.8 4.3-5.7 7.5-5.7S15.3 4.7 17 8.5c-1.7 3.8-4.3 5.7-7.5 5.7S2.7 12.3 1 8.5z" stroke="currentColor" stroke-width="1.3"/><circle cx="8.5" cy="8.5" r="2.3" stroke="currentColor" stroke-width="1.3"/></svg>
        </button>
      </div>
      <div id="cp-error" style="display:none; font-size:13px; color: var(--destructive); background: var(--destructive-bg); border-radius: 6px; padding: 8px 12px;"></div>
      <div style="display: flex; gap: 8px; margin-top: 4px;">
        <button type="button" id="cp-cancel" class="btn-secondary" style="flex:1;">Cancel</button>
        <button type="submit" id="cp-submit" class="btn-primary" style="flex:2;">Update Password</button>
      </div>
    </form>
  </div>
</div>

<style>
  .vault-header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    border-bottom: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  :global(html[data-theme="dark"]) .vault-header {
    background: rgba(10, 10, 10, 0.75);
  }

  .vault-header-container {
    max-width: 1400px;
    height: 64px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  /* Left Section */
  .header-left {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .vault-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .vault-logo:hover .logo-icon-box {
    opacity: 0.9;
  }

  .logo-icon-box {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--text-primary);
    color: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .logo-text {
    font-weight: 600;
  }

  .back-to-vault-mobile-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--border-med);
    background: var(--card);
    color: var(--text-body);
    transition: all 0.15s ease;
    text-decoration: none;
  }
  .back-to-vault-mobile-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
    background: var(--bg-inset);
  }

  .divider-vertical {
    width: 1px;
    height: 20px;
    background: var(--border-med);
  }

  /* Resources Dropdown */
  .resources-dropdown {
    position: relative;
    display: inline-block;
  }

  .dropdown-trigger {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-body);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 6px 12px;
    border-radius: 100px;
    transition: all 0.15s ease;
  }
  .dropdown-trigger:hover {
    color: var(--text-primary);
    background: rgba(0, 0, 0, 0.04);
  }
  :global(html[data-theme="dark"]) .dropdown-trigger:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .arrow-icon {
    transition: transform 0.2s ease;
  }
  .resources-dropdown.open .arrow-icon {
    transform: rotate(180deg);
  }

  .dropdown-menu-panel {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 220px;
    background: var(--card);
    border: 1px solid var(--border-med);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
    padding: 8px;
    display: none;
    flex-direction: column;
    gap: 2px;
    z-index: 105;
    animation: dropdown-fade-in 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .resources-dropdown.open .dropdown-menu-panel {
    display: flex;
  }

  .dropdown-menu-header {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 600;
    color: var(--text-muted);
    padding: 6px 10px;
    letter-spacing: 0.05em;
  }

  .dropdown-item {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-body);
    padding: 8px 10px;
    border-radius: var(--radius-md);
    transition: all 0.15s ease;
    text-decoration: none;
  }
  .dropdown-item:hover {
    color: var(--text-primary);
    background: var(--bg-inset);
  }

  @keyframes dropdown-fade-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Center Section */
  .header-center {
    flex-grow: 1;
    display: flex;
    justify-content: center;
    max-width: 620px;
  }

  .search-filter-group {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
  }

  .search-input-wrapper {
    position: relative;
    flex-grow: 1;
    max-width: 320px;
  }

  .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-faint);
    pointer-events: none;
  }

  .search-input-wrapper input {
    width: 100%;
    height: 34px;
    padding: 0 12px 0 34px;
    font-size: 13px;
    font-family: inherit;
    color: var(--text-primary);
    background: var(--bg-inset);
    border: 1px solid var(--border);
    border-radius: 100px;
    outline: none;
    transition: all 0.15s ease;
  }
  .search-input-wrapper input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-subtle);
    background: var(--surface);
  }

  .back-to-vault-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-body);
    padding: 6px 16px;
    border-radius: 100px;
    border: 1px solid var(--border-med);
    transition: all 0.15s ease;
    background: var(--card);
    text-decoration: none;
  }
  .back-to-vault-link:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
    background: var(--bg-inset);
  }

  .back-arrow {
    transition: transform 0.15s ease;
  }
  .back-to-vault-link:hover .back-arrow {
    transform: translateX(-3px);
  }

  /* Right Section */
  .header-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .action-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--border-med);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
  }
  .action-btn:hover {
    border-color: var(--border-strong);
    color: var(--text-primary);
    background: rgba(0, 0, 0, 0.02);
  }
  :global(html[data-theme="dark"]) .action-btn:hover {
    background: rgba(255, 255, 255, 0.04);
  }

  .lock-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 14px;
    height: 34px;
    font-size: 13px;
    font-weight: 500;
    font-family: inherit;
    color: var(--text-muted);
    background: var(--card);
    border: 1px solid var(--border-med);
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .lock-action-btn:hover {
    color: var(--destructive);
    border-color: rgba(248, 113, 113, 0.3);
    background: var(--destructive-bg);
  }

  /* Mobile Sub Header (second row on small screens) */
  .vault-mobile-sub-header {
    display: none;
    border-top: 1px solid var(--border);
    padding: 8px 16px;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  :global(html[data-theme="dark"]) .vault-mobile-sub-header {
    background: rgba(10, 10, 10, 0.8);
  }

  .search-filter-group-mobile {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }
  .search-filter-group-mobile .search-input-wrapper {
    max-width: 100%;
  }

  .filter-tabs-wrapper-mobile {
    overflow-x: auto;
    scrollbar-width: none; /* Hide scrollbar for Firefox */
    -ms-overflow-style: none; /* Hide scrollbar for IE/Edge */
    padding: 2px 0;
  }
  .filter-tabs-wrapper-mobile::-webkit-scrollbar {
    display: none; /* Hide scrollbar for Chrome/Safari */
  }

  .filter-tabs-wrapper-mobile .filter-tabs {
    width: max-content;
  }

  /* Change Password eye toggle style */
  .pw-toggle {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-faint);
    padding: 4px;
    display: flex;
    align-items: center;
    transition: color 0.15s;
  }

  /* Vault dashboard link (on detail pages) */
  .vault-dash-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-body);
    padding: 0 14px;
    height: 34px;
    border-radius: 100px;
    border: 1px solid var(--border-med);
    background: var(--card);
    transition: all 0.15s ease;
    text-decoration: none;
  }
  .vault-dash-link:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
    background: var(--bg-inset);
  }

  /* Responsive breakpoints */
  @media (max-width: 1024px) {
    .header-center {
      display: none; /* Hide desktop search/filters and back link */
    }
    .back-to-vault-mobile-btn {
      display: flex;
    }
    .vault-mobile-sub-header {
      display: block; /* Show second row with search/filters on mobile */
    }
  }

  @media (max-width: 768px) {
    .resources-dropdown .dropdown-trigger span {
      display: none;
    }
    .resources-dropdown .dropdown-trigger {
      padding: 6px 10px;
    }
    .divider-vertical {
      margin: 0 4px;
    }
    .lock-label {
      display: none;
    }
    .lock-action-btn {
      padding: 0 10px;
      border-radius: 50%;
      width: 34px;
      height: 34px;
      justify-content: center;
    }
    .vault-header-container {
      padding: 0 16px;
    }
    .vault-dash-label {
      display: none;
    }
    .vault-dash-link {
      padding: 0;
      width: 34px;
      height: 34px;
      justify-content: center;
      border-radius: 50%;
    }
  }

  @media (max-width: 480px) {
    .vault-header-container {
      padding: 0 12px;
      gap: 8px;
    }
    .header-right {
      gap: 6px;
    }
    .logo-text {
      display: none;
    }
  }
</style>

<script>
  // ── Resources Dropdown Toggle ───────────────────────────────────────────────
  const dropdownTrigger = document.querySelector('.dropdown-trigger');
  const dropdownContainer = document.querySelector('.resources-dropdown');

  dropdownTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = dropdownContainer?.classList.contains('open');
    if (isOpen) {
      dropdownContainer?.classList.remove('open');
      dropdownTrigger.setAttribute('aria-expanded', 'false');
    } else {
      dropdownContainer?.classList.add('open');
      dropdownTrigger.setAttribute('aria-expanded', 'true');
    }
  });

  // Close dropdown on click outside
  document.addEventListener('click', (e) => {
    if (dropdownContainer?.classList.contains('open')) {
      const target = e.target as HTMLElement;
      if (!dropdownContainer.contains(target)) {
        dropdownContainer.classList.remove('open');
        dropdownTrigger?.setAttribute('aria-expanded', 'false');
      }
    }
  });

  // ── Lock vault ────────────────────────────────────────────────────────────────
  document.getElementById('vault-lock-btn')?.addEventListener('click', async () => {
    await fetch('/api/auth/logout', { method: 'POST' });
    window.location.href = '/login';
  });

  // ── Search & Filter State Sync (desktop & mobile) ───────────────────────────
  const searchDesktop = document.getElementById('vault-search-input') as HTMLInputElement | null;
  const searchMobile = document.getElementById('vault-search-input-mobile') as HTMLInputElement | null;
  
  function syncSearch(value: string) {
    if (searchDesktop && searchDesktop.value !== value) searchDesktop.value = value;
    if (searchMobile && searchMobile.value !== value) searchMobile.value = value;
    document.dispatchEvent(new CustomEvent('search-change', { detail: value.toLowerCase() }));
  }

  searchDesktop?.addEventListener('input', (e) => syncSearch((e.target as HTMLInputElement).value));
  searchMobile?.addEventListener('input', (e) => syncSearch((e.target as HTMLInputElement).value));

  const filterTabsDesktop = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const filterTabsMobile = document.querySelectorAll<HTMLButtonElement>('[data-filter-mobile]');

  function syncFilters(filterId: string) {
    filterTabsDesktop.forEach(btn => {
      if (btn.dataset.filter === filterId) btn.classList.add('active');
      else btn.classList.remove('active');
    });
    filterTabsMobile.forEach(btn => {
      if (btn.dataset.filterMobile === filterId) btn.classList.add('active');
      else btn.classList.remove('active');
    });
    document.dispatchEvent(new CustomEvent('filter-change', { detail: filterId }));
  }

  filterTabsDesktop.forEach(btn => {
    btn.addEventListener('click', () => syncFilters(btn.dataset.filter!));
  });
  filterTabsMobile.forEach(btn => {
    btn.addEventListener('click', () => syncFilters(btn.dataset.filterMobile!));
  });

  // ── Theme toggle ──────────────────────────────────────────────────────────────
  const htmlElement = document.documentElement;
  const sunIconVault = document.getElementById('vault-icon-sun');
  const moonIconVault = document.getElementById('vault-icon-moon');

  function updateVaultThemeUI(theme: string) {
    if (sunIconVault && moonIconVault) {
      if (theme === 'dark') {
        sunIconVault.style.display = 'block';
        moonIconVault.style.display = 'none';
      } else {
        sunIconVault.style.display = 'none';
        moonIconVault.style.display = 'block';
      }
    }
  }

  // Set theme from parent page load (BaseLayout sets html data-theme first)
  const themeObserver = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.type === 'attributes' && mutation.attributeName === 'data-theme') {
        const theme = htmlElement.getAttribute('data-theme') || 'dark';
        updateVaultThemeUI(theme);
      }
    });
  });

  themeObserver.observe(htmlElement, { attributes: true });
  updateVaultThemeUI(htmlElement.getAttribute('data-theme') || 'dark');

  document.getElementById('vault-theme-toggle')?.addEventListener('click', () => {
    const current = htmlElement.getAttribute('data-theme') || 'dark';
    const nextTheme = current === 'dark' ? 'light' : 'dark';
    htmlElement.setAttribute('data-theme', nextTheme);
    localStorage.setItem('mv-theme', nextTheme);
  });

  // ── Eye toggles (change-password modal) ──────────────────────────────────────
  const EYE_OPEN = `<path d="M1 8.5c1.7-3.8 4.3-5.7 7.5-5.7S15.3 4.7 17 8.5c-1.7 3.8-4.3 5.7-7.5 5.7S2.7 12.3 1 8.5z" stroke="currentColor" stroke-width="1.3"/><circle cx="8.5" cy="8.5" r="2.3" stroke="currentColor" stroke-width="1.3"/>`;
  const EYE_OFF  = `<path d="M1 8.5c1.7-3.8 4.3-5.7 7.5-5.7S15.3 4.7 17 8.5c-1.7 3.8-4.3 5.7-7.5 5.7S2.7 12.3 1 8.5z" stroke="currentColor" stroke-width="1.3"/><line x1="2" y1="2" x2="15" y2="15" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>`;

  document.querySelectorAll<HTMLButtonElement>('.pw-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.dataset.target!;
      const input    = document.getElementById(targetId) as HTMLInputElement | null;
      if (!input) return;
      const show     = input.type === 'password';
      input.type     = show ? 'text' : 'password';
      const svg      = btn.querySelector('.eye-svg');
      if (svg) svg.innerHTML = show ? EYE_OFF : EYE_OPEN;
    });
  });

  // ── Settings modal ────────────────────────────────────────────────────────────
  const modal    = document.getElementById('settings-modal')!;
  const form     = document.getElementById('change-pw-form') as HTMLFormElement;
  const cpError  = document.getElementById('cp-error')!;
  const cpSubmit = document.getElementById('cp-submit') as HTMLButtonElement;

  document.getElementById('vault-settings-btn')?.addEventListener('click', () => {
    modal.style.display = 'flex';
    (document.getElementById('cp-current') as HTMLInputElement).focus();
  });
  document.getElementById('cp-cancel')?.addEventListener('click', () => closeModal());
  modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

  function closeModal() {
    modal.style.display = 'none';
    form.reset();
    cpError.style.display = 'none';
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    cpError.style.display = 'none';

    const currentPassword = (document.getElementById('cp-current') as HTMLInputElement).value;
    const newPassword     = (document.getElementById('cp-new')     as HTMLInputElement).value;
    const confirm         = (document.getElementById('cp-confirm') as HTMLInputElement).value;

    if (newPassword !== confirm) {
      cpError.textContent = 'New passwords do not match.';
      cpError.style.display = 'block';
      return;
    }
    if (newPassword.length < 8) {
      cpError.textContent = 'New password must be at least 8 characters.';
      cpError.style.display = 'block';
      return;
    }

    cpSubmit.disabled = true;
    cpSubmit.textContent = 'Updating…';

    try {
      const res = await fetch('/api/auth/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ currentPassword, newPassword }),
      });
      const data = await res.json() as { ok?: boolean; error?: string };

      if (!res.ok) {
        cpError.textContent = data.error ?? 'Failed to update password.';
        cpError.style.display = 'block';
        return;
      }

      closeModal();
      document.dispatchEvent(new CustomEvent('toast', { detail: { type: 'success', message: 'Password updated successfully.' } }));
    } catch {
      cpError.textContent = 'Network error. Please try again.';
      cpError.style.display = 'block';
    } finally {
      cpSubmit.disabled = false;
      cpSubmit.textContent = 'Update Password';
    }
  });
</script>
