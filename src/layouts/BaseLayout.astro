---
import Seo from '../components/Seo.astro';
// Self-hosted fonts (privacy: no request to Google; perf: no third-party dependency).
import '@fontsource-variable/inter/index.css';
import '@fontsource/jetbrains-mono/400.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  keywords?: string[];
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = 'Media Reservoir is a free, end-to-end encrypted media vault — store private photos, videos, and audio in cloud storage you own, encrypted in your browser with AES-256 so not even we can read it.',
  image,
  noindex = false,
  keywords = [],
  jsonLd = [],
} = Astro.props;

// Pages that already brand themselves keep their exact title;
// everything else gets the suffix for consistent SERP display.
const fullTitle = title.includes('Media Reservoir') ? title : `${title} | Media Reservoir`;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Media Reservoir" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Reservoir" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <Seo title={fullTitle} description={description} image={image} noindex={noindex} keywords={keywords} jsonLd={jsonLd} />
    <!-- Apply saved theme before page renders to avoid flash -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('mv-theme');
        const preferred = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', saved || preferred);
        document.documentElement.classList.add('js'); // gates reveal animations (content visible without JS)
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <!-- PWA: register the offline-capable service worker (never caches /api or /vault) -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
