---
import BaseLayout from './BaseLayout.astro';
import PublicHeader from '../components/PublicHeader.astro';
import PublicFooter from '../components/PublicFooter.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  keywords?: string[];
  jsonLd?: Record<string, unknown>[];
}
const { title, description, image, noindex, keywords, jsonLd } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} noindex={noindex} keywords={keywords} jsonLd={jsonLd}>
  <div class="public-layout-wrapper">
    <PublicHeader />
    <main class="public-main-content">
      <slot />
    </main>
    <PublicFooter />
  </div>
</BaseLayout>

<style>
  .public-layout-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .public-main-content {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }
</style>
