---
import { ClientRouter } from 'astro:transitions';
import BaseLayout from './BaseLayout.astro';
import PublicHeader from '../components/PublicHeader.astro';
import PublicFooter from '../components/PublicFooter.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  keywords?: string[];
  jsonLd?: Record<string, unknown>[];
  /** Optional: pin a page to dark (kept for pages that need it). Default off —
      the marketing site now supports both light and dark via the theme toggle. */
  forceDark?: boolean;
}
const { title, description, image, noindex, keywords, jsonLd, forceDark = false } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} noindex={noindex} keywords={keywords} jsonLd={jsonLd} forceDark={forceDark}>
  <ClientRouter slot="head" />
  <div class="public-layout-wrapper">
    <PublicHeader forceDark={forceDark} />
    <main class="public-main-content">
      <slot />
    </main>
    <PublicFooter />
  </div>
</BaseLayout>

<!-- Scroll-reveal: elements with [data-reveal] fade/rise in as they enter view.
     Fully disabled under prefers-reduced-motion. Re-runs after each View
     Transition navigation. -->
<script>
  function initReveal() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const els = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.revealed)');
    if (reduce) {
      els.forEach((el) => el.classList.add('revealed'));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            const el = e.target as HTMLElement;
            const delay = el.dataset.revealDelay;
            if (delay) el.style.transitionDelay = `${delay}ms`;
            el.classList.add('revealed');
            io.unobserve(el);
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
    );
    els.forEach((el) => io.observe(el));
  }
  document.addEventListener('astro:page-load', initReveal); // fires on load + after each transition
</script>

<style>
  .public-layout-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .public-main-content {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  /* Hidden state only applies when JS is on (html.js), so no-JS users always
     see content. */
  :global(html.js [data-reveal]) {
    opacity: 0;
    transform: translateY(30px) scale(0.985);
    filter: blur(6px);
    transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1), transform 0.75s cubic-bezier(0.16, 1, 0.3, 1), filter 0.75s ease;
    will-change: opacity, transform, filter;
  }
  :global(html.js [data-reveal].revealed) {
    opacity: 1;
    transform: none;
    filter: none;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js [data-reveal]) {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
