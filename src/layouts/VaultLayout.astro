---
import VaultHeader from '../components/VaultHeader.astro';
import BaseLayout from './BaseLayout.astro';
import PublicFooter from '../components/PublicFooter.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;

// Auth + sealed-vault gating happens in src/middleware.ts before any
// vault page renders — no per-page or per-layout guards needed.
---
<BaseLayout title={title} description={description} noindex={true}>
  <div class="vault-layout-wrapper">
    <VaultHeader />
    <main id="main-content" class="vault-main-content">
      <slot />
    </main>
    <PublicFooter />
  </div>
</BaseLayout>

<style>
  .vault-layout-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .vault-main-content {
    flex-grow: 1;
    padding-bottom: 40px;
  }
</style>
