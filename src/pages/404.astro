---
import PublicLayout from '../layouts/PublicLayout.astro';

// Static timestamp evaluated at request time (SSR)
const ts = new Date().toISOString();
---

<PublicLayout title="Page Not Found" description="The requested path was not found on MediaVault." noindex={true}>
  <!-- ── Error body ── -->
  <main id="main-content" style="
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 24px 120px;
    background: var(--bg);
    text-align: center;
    flex-grow: 1;
  ">
    <div style="
      max-width: 580px; width: 100%;
      display: flex; flex-direction: column;
      align-items: center; gap: 28px;
    ">

      <!-- Error pill badge -->
      <span style="
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px; font-weight: 400;
        color: #f87171;
        background: rgba(248,113,113,0.1);
        border: 1px solid rgba(248,113,113,0.25);
        padding: 4px 12px;
        border-radius: 100px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      ">404 · Page Not Found</span>

      <!-- Headline -->
      <h1 style="
        font-size: clamp(30px, 5vw, 42px);
        font-weight: 600;
        color: var(--text-primary);
        letter-spacing: -0.04em;
        line-height: 1.1;
        margin: 0;
        text-wrap: balance;
      ">
        Lost in the vault.
      </h1>

      <!-- Sub-copy -->
      <p style="
        font-size: 15px;
        color: var(--text-body);
        line-height: 1.65;
        margin: 0;
        max-width: 440px;
        text-wrap: pretty;
      ">
        The path you requested doesn&rsquo;t exist or has been removed.
        Double-check the URL, or head back to your vault.
      </p>

      <!-- Dark terminal mockup -->
      <div style="
        width: 100%;
        background: #0c0c0e;
        border: 1px solid #1e1e22;
        border-radius: 14px;
        overflow: hidden;
        box-shadow:
          0 2px 2px rgba(0,0,0,0.06),
          0 8px 24px rgba(0,0,0,0.22),
          0 32px 64px rgba(0,0,0,0.16);
        text-align: left;
      ">
        <!-- Title bar -->
        <div style="
          display: flex; align-items: center; justify-content: space-between;
          padding: 10px 16px;
          border-bottom: 1px solid #1e1e22;
          background: #0f0f12;
        ">
          <div style="display: flex; gap: 6px; align-items: center;">
            <div style="width:10px;height:10px;border-radius:50%;background:#ef4444;"></div>
            <div style="width:10px;height:10px;border-radius:50%;background:#f5a623;"></div>
            <div style="width:10px;height:10px;border-radius:50%;background:#22c55e;"></div>
          </div>
          <span style="
            font-family: 'JetBrains Mono', monospace;
            font-size: 10px; color: #444;
            letter-spacing: 0.02em;
          ">error_response.json</span>
          <span style="width: 42px;"></span>
        </div>

        <!-- Code content (rendered via set:html for proper escaping) -->
        <pre id="error-code" style="
          margin: 0;
          padding: 20px 24px;
          font-family: 'JetBrains Mono', monospace;
          font-size: 13px;
          line-height: 1.6;
          overflow-x: auto;
          white-space: pre-wrap;
          word-break: break-all;
        " set:html={`<code style="color:#a7f3d0;">`
  + `<span style="color:#888;">&#123;</span>\n`
  + `  <span style="color:#f87171;">&quot;status&quot;</span>: <span style="color:#fb923c;">404</span>,\n`
  + `  <span style="color:#f87171;">&quot;error&quot;</span>:  <span style="color:#fbbf24;">&quot;Not Found&quot;</span>,\n`
  + `  <span style="color:#f87171;">&quot;message&quot;</span>: <span style="color:#34d399;">&quot;The requested path was not found.&quot;</span>,\n`
  + `  <span style="color:#f87171;">&quot;path&quot;</span>:    <span style="color:#38bdf8;" id="path-display">&quot;…&quot;</span>,\n`
  + `  <span style="color:#f87171;">&quot;timestamp&quot;</span>: <span style="color:#c084fc;">&quot;${ts}&quot;</span>\n`
  + `<span style="color:#888;">&#125;</span>`
  + `</code>`}
        />
      </div>

      <!-- Action buttons -->
      <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap; justify-content: center; margin-top: 4px;">
        <a href="/app" class="btn-primary" style="
          text-decoration: none;
          display: inline-flex; align-items: center; justify-content: center; gap: 6px;
          height: 40px; padding: 0 20px;
          border-radius: 100px;
          font-size: 14px; font-weight: 500;
          background: var(--text-primary);
          color: var(--bg);
        ">
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
            <path d="M8 2L3 6.5 8 11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back to Vault
        </a>
        <a href="javascript:history.back()" style="
          text-decoration: none;
          display: inline-flex; align-items: center; justify-content: center;
          height: 40px; padding: 0 18px;
          border-radius: 100px;
          font-size: 14px; font-weight: 500;
          color: var(--text-body);
          background: var(--card);
          border: 1px solid var(--border-med);
          transition: border-color 0.15s;
        "
          onmouseenter="this.style.borderColor='var(--border-strong)'"
          onmouseleave="this.style.borderColor='var(--border-med)'"
        >
          Go back
        </a>
      </div>

    </div>
  </main>
</PublicLayout>

<script>
// Show the real path in the code block
const pathEl = document.getElementById('path-display');
if (pathEl) {
  pathEl.textContent = `"${window.location.pathname}"`;
}
</script>
