---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout title="Server Error" description="An unexpected error occurred on Media Reservoir." noindex={true}>
  <main id="main-content" class="err-page">
    <div class="err-inner">
      <div class="err-badge"><span class="err-dot"></span>500 · Server error</div>
      <div class="err-code" aria-hidden="true">500</div>
      <h1 class="err-title">Something went sideways.</h1>
      <p class="err-lead">
        An unexpected error occurred on our end. Your files and encryption keys are
        untouched — nothing here can read them. Try again in a moment.
      </p>
      <div class="err-actions">
        <a href="/" class="err-btn err-btn-primary">
          Back to home
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <button type="button" class="err-btn err-btn-ghost" onclick="location.reload()">Try again</button>
      </div>
    </div>
  </main>
</PublicLayout>

<style>
  .err-page {
    position: relative; flex-grow: 1; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    padding: 96px 24px 120px; text-align: center;
    min-height: calc(100vh - 64px);
    background:
      linear-gradient(180deg, rgba(247,248,252,0.45) 0%, rgba(247,248,252,0.15) 40%, var(--bg) 85%),
      url('/ornament-light.png') center top / cover no-repeat;
  }
  :global(html[data-theme='dark']) .err-page {
    background:
      linear-gradient(180deg, rgba(9,10,15,0.58) 0%, rgba(9,10,15,0.4) 42%, var(--bg) 85%),
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(99,102,241,0.18), transparent 70%),
      url('/ornament.png') center top / cover no-repeat;
  }

  .err-inner { position: relative; z-index: 2; max-width: 560px; display: flex; flex-direction: column; align-items: center; }

  .err-badge {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-body);
    background: var(--surface); border: 1px solid var(--border-med);
    padding: 6px 14px; border-radius: 100px; box-shadow: var(--shadow-sm);
  }
  :global(html[data-theme='dark']) .err-badge { background: rgba(255,255,255,0.04); box-shadow: none; }
  .err-dot { width: 7px; height: 7px; border-radius: 50%; background: #fbbf24; box-shadow: 0 0 8px #fbbf24; }

  .err-code {
    font-size: clamp(96px, 22vw, 168px); font-weight: 700; line-height: 0.9;
    letter-spacing: -0.06em; margin: 22px 0 6px;
    background: linear-gradient(135deg, #6366f1, #a855f7 60%, #7c3aed);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
  }
  .err-title { font-size: clamp(26px, 3.6vw, 34px); font-weight: 600; letter-spacing: -0.035em; color: var(--text-primary); margin: 0 0 14px; }
  .err-lead { font-size: 16px; line-height: 1.65; color: var(--text-body); max-width: 440px; margin: 0 0 30px; }

  .err-actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .err-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    height: 46px; padding: 0 24px; border-radius: 100px; font-size: 14.5px; font-weight: 600;
    cursor: pointer; font-family: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .err-btn-primary {
    background: linear-gradient(135deg, #6366f1, #7c3aed); color: #fff; border: none;
    box-shadow: 0 10px 30px -8px rgba(109,74,232,0.6), inset 0 1px 0 rgba(255,255,255,0.18);
  }
  .err-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 16px 40px -10px rgba(109,74,232,0.75); color: #fff; }
  .err-btn-ghost {
    background: var(--surface); color: var(--text-primary);
    border: 1px solid var(--border-med); box-shadow: var(--shadow-sm);
  }
  .err-btn-ghost:hover { border-color: var(--border-strong); background: var(--bg-inset); transform: translateY(-1px); }
  :global(html[data-theme='dark']) .err-btn-ghost { background: rgba(255,255,255,0.05); box-shadow: none; }
</style>
