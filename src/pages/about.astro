---
import PublicLayout from '../layouts/PublicLayout.astro';

const origin = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '') || Astro.url.origin;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: origin + '/' },
      { '@type': 'ListItem', position: 2, name: 'About', item: origin + '/about' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to set up and use MediaVault',
    description: 'Set up an end-to-end encrypted media vault over your own cloud storage in minutes.',
    totalTime: 'PT3M',
    step: [
      { '@type': 'HowToStep', position: 1, name: 'Create your account', text: 'Sign up; your password derives your encryption key in the browser, and a one-time recovery key is generated — save it offline.' },
      { '@type': 'HowToStep', position: 2, name: 'Connect your storage', text: 'Link your own cloud bucket (Cloudflare R2, Backblaze B2, Wasabi, or S3). Credentials are stored encrypted and used only in your browser.' },
      { '@type': 'HowToStep', position: 3, name: 'Upload & organize', text: 'Drag in images, videos, or audio. Each file is encrypted locally, then sent straight to your bucket; browse thumbnails, search, and bookmark.' },
      { '@type': 'HowToStep', position: 4, name: 'View & stream', text: 'Open the in-page viewer to see photos or stream encrypted video/audio, with instant seeking.' },
    ],
  },
];
---

<PublicLayout
  title="About MediaVault — How End-to-End Encrypted Media Storage Works"
  description="How MediaVault keeps private photos and videos safe: end-to-end AES-256 encryption in your browser, storage you own, recovery-key resets, and a zero-knowledge design. Step-by-step setup guide included."
  jsonLd={jsonLd}
>
  <article class="about-page">
    <!-- Hero Header -->
    <header class="about-hero">
      <div class="container-sm">
        <span class="page-eyebrow">Our Philosophy</span>
        <h1 class="page-title">Ownership of your digital life.</h1>
        <p class="page-lead">
          MediaVault is the private layer over the cloud storage you already own. We believe your private photos, videos, and voice memos shouldn't live in a corporate cloud that scans them — so we encrypt everything in your browser and keep it in storage only you control.
        </p>
      </div>
    </header>

    <!-- Main Content Grid -->
    <div class="about-content container-sm">

      <!-- Core Architecture -->
      <section class="about-section">
        <h2>How MediaVault Works</h2>
        <p>
          MediaVault is <strong>end-to-end encrypted and zero-knowledge by design</strong>. Files are encrypted in your browser before upload and stored in cloud storage you connect. We run only a thin control plane that holds an encrypted index — never your files, your keys, or your storage credentials.
        </p>

        <div class="info-card-list">
          <div class="info-card">
            <h4>🔒 Encrypted in your browser</h4>
            <p>Every file is encrypted with AES-256 on your device before it's uploaded. Your encryption key is derived from your password with Argon2id and never leaves the browser, so we only ever handle ciphertext we can't read.</p>
          </div>
          <div class="info-card">
            <h4>☁️ Your own storage</h4>
            <p>You connect your own cloud bucket — Cloudflare R2, Backblaze B2, Wasabi, or any S3-compatible storage. Files move directly between your browser and your bucket; they never pass through our servers.</p>
          </div>
          <div class="info-card">
            <h4>⚡ Seekable encrypted streaming</h4>
            <p>A Service Worker decrypts only the byte ranges you're watching, so you can jump anywhere in a large video instantly — even though the file is encrypted end-to-end.</p>
          </div>
        </div>
      </section>

      <!-- Step by step How to Use -->
      <section class="about-section guide-section">
        <h2>How to Use MediaVault</h2>
        <p>Setting up and operating your vault takes less than two minutes. Follow these simple steps:</p>
        
        <div class="steps-flow">
          <div class="step-item">
            <div class="step-num">01</div>
            <div class="step-text">
              <h4>Create your account</h4>
              <p>Sign up with an email and password. Your password derives your encryption key right in the browser, and a one-time recovery key is generated — copy or print it and store it offline.</p>
            </div>
          </div>

          <div class="step-item">
            <div class="step-num">02</div>
            <div class="step-text">
              <h4>Connect your storage</h4>
              <p>Link a cloud bucket you own (Cloudflare R2, Backblaze B2, Wasabi, or S3). It's tested, then stored encrypted — your credentials are only ever used in your browser.</p>
            </div>
          </div>

          <div class="step-item">
            <div class="step-num">03</div>
            <div class="step-text">
              <h4>Upload, organize & play</h4>
              <p>Drag in images, videos, and audio — each is encrypted locally, then sent straight to your bucket. Browse encrypted thumbnails, search, bookmark, and open the in-page viewer to stream media.</p>
            </div>
          </div>

          <div class="step-item">
            <div class="step-num">04</div>
            <div class="step-text">
              <h4>5-Second Delete Undo</h4>
              <p>Accidentally deleted a file? Use the built-in undo banner. When you click delete, the card is hidden from search and stats immediately, but we wait 5 seconds before permanently wiping it from storage.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Security details -->
      <section class="about-section warning-box">
        <h3>🔒 Security & Privacy Notice</h3>
        <p>
          Your files live in <strong>your own cloud storage</strong>, encrypted end-to-end. Because the encryption keys are derived from your password and never leave your device, <strong>only you can decrypt your media</strong> — not us, not your cloud provider. The trade-off is real: if you lose both your password and your recovery key, your files cannot be recovered, because there is no backdoor. Save your recovery key, and rely on your storage provider's own durability/backup options.
        </p>
      </section>
      
    </div>
  </article>
</PublicLayout>

<style>
  .container-sm {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .about-hero {
    padding: 96px 0 64px;
    text-align: center;
    border-bottom: 1px solid var(--border);
    background: var(--bg-inset);
  }

  .page-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--accent);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 12px;
  }

  .page-title {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 600;
    letter-spacing: -0.04em;
    color: var(--text-primary);
    line-height: 1.1;
    margin-bottom: 24px;
  }

  .page-lead {
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-body);
    max-width: 600px;
    margin: 0 auto;
  }

  .about-content {
    padding: 64px 24px 96px;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .about-section h2 {
    font-size: 24px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 16px;
    letter-spacing: -0.03em;
  }

  .about-section p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-body);
    margin-bottom: 24px;
  }

  .info-card-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 32px;
  }

  .info-card {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 24px;
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
  }

  .info-card h4 {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .info-card p {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-body);
    margin-bottom: 0;
  }

  /* Guide flow steps */
  .steps-flow {
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin-top: 32px;
  }

  .step-item {
    display: flex;
    gap: 24px;
  }

  .step-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 24px;
    font-weight: 600;
    color: var(--accent);
    line-height: 1;
  }

  .step-text h4 {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 6px;
  }

  .step-text p {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-body);
    margin-bottom: 0;
  }

  /* Warning container card */
  .warning-box {
    background: rgba(245, 166, 35, 0.06);
    border: 1px solid rgba(245, 166, 35, 0.25);
    padding: 24px;
    border-radius: 12px;
  }

  .warning-box h3 {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .warning-box p {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-body);
    margin: 0;
  }
</style>
