---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Toast from '../../components/Toast.astro';

// The authenticated SPA. The account key is derived and held only in the
// browser; the server only ever sees encrypted blobs. This page is a static
// shell — all state (signed-out / locked / connected / vault) is decided by the
// client script based on /api/auth/me and the in-memory key.

// Dropbox connector is gated behind its public OAuth client ID: with no ID set
// (the default), the button never renders and nothing about Dropbox ships.
const dropboxEnabled = !!import.meta.env.PUBLIC_DROPBOX_CLIENT_ID;
---
<BaseLayout title="Your Vault" description="Your end-to-end encrypted MediaVault." noindex={true}>
  <div class="app-bg" aria-hidden="true">
    <div class="app-orb app-orb-1"></div>
    <div class="app-orb app-orb-2"></div>
  </div>

  <div class="appbar">
    <a href="/" class="appbar-logo" aria-label="MediaVault home">
      <span class="logo-mark">
        <svg width="16" height="16" viewBox="0 0 28 28" fill="none"><rect x="7" y="13" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M10 13V10a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="14" cy="18" r="1.5" fill="currentColor"/></svg>
      </span>
      MediaVault
    </a>
    <div class="appbar-right">
      <span id="storage-label" class="storage-label" hidden></span>
      <button id="app-theme-toggle" class="icon-btn" aria-label="Toggle theme" title="Toggle theme">
        <svg id="app-icon-sun" width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.4"/><path d="M8 1.5V3M8 13v1.5M1.5 8H3M13 8h1.5M3.5 3.5l1 1M11.5 11.5l1 1M12.5 3.5l-1 1M4.5 11.5l-1 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        <svg id="app-icon-moon" width="16" height="16" viewBox="0 0 16 16" fill="none" style="display:none"><path d="M13.5 9a6 6 0 0 1-7.5-7.5A6 6 0 1 0 13.5 9z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
      </button>
      <div id="appbar-actions" class="appbar-actions" hidden>
        <button id="trash-btn" class="btn-ghost" title="Trash">Trash</button>
        <button id="account-btn" class="btn-ghost">Account</button>
        <button id="lock-btn" class="btn-ghost">Lock</button>
      </div>
    </div>
  </div>

  <main class="app-main">
    <!-- Signed out -->
    <section id="auth-view" class="centered" hidden>
      <div class="card">
        <div class="tabs">
          <button type="button" class="tab active" data-tab="signin">Sign in</button>
          <button type="button" class="tab" data-tab="signup">Create account</button>
        </div>
        <form id="auth-form" class="stack">
          <input id="email" class="inp" type="email" placeholder="Email" autocomplete="username" required />
          <input id="password" class="inp" type="password" placeholder="Password" autocomplete="current-password" required minlength="8" />
          <div id="pw-strength" class="pw-strength" hidden>
            <div class="pw-track"><div id="pw-fill" class="pw-fill"></div></div>
            <span id="pw-label" class="pw-label"></span>
          </div>
          <input id="password2" class="inp" type="password" placeholder="Confirm password" autocomplete="new-password" hidden />
          <button id="auth-submit" class="btn-primary" type="submit">Sign in</button>
        </form>
        <p class="hint">Your password derives your encryption key on this device. We never see it.</p>
        <p id="auth-error" class="error" hidden></p>
        <button id="forgot-link" type="button" class="link" hidden>Forgot password? Use your recovery key</button>
      </div>
    </section>

    <!-- Forgot password → reset with recovery key -->
    <section id="reset-view" class="centered" hidden>
      <div class="card">
        <h2 class="card-h">Reset with recovery key</h2>
        <p class="muted">Enter your recovery key and a new password. We'll give you a fresh recovery key afterwards.</p>
        <form id="reset-form" class="stack">
          <input id="reset-email" class="inp" type="email" placeholder="Email" autocomplete="username" required />
          <textarea id="reset-reckey" class="inp reckey-input" placeholder="Recovery key (XXXXXXXX-XXXXXXXX-…)" rows="2" required></textarea>
          <input id="reset-password" class="inp" type="password" placeholder="New password" autocomplete="new-password" required minlength="8" />
          <input id="reset-password2" class="inp" type="password" placeholder="Confirm new password" autocomplete="new-password" required minlength="8" />
          <button class="btn-primary btn-block" type="submit">Reset password</button>
        </form>
        <p id="reset-error" class="error" hidden></p>
        <button id="reset-back" type="button" class="link">Back to sign in</button>
      </div>
    </section>

    <!-- Recovery key (after signup) -->
    <section id="recovery-view" class="centered" hidden>
      <div class="card">
        <h2 class="card-h">Save your recovery key</h2>
        <p class="muted">This is the <strong>only</strong> way to reset your password — we can't recover it for you. Store it offline.</p>
        <code id="recovery-key" class="reckey"></code>
        <div class="reckey-actions">
          <button id="copy-key" type="button" class="btn-outline">Copy</button>
          <a id="print-kit" href="/recovery-kit" target="_blank" rel="noopener" class="btn-outline">Print kit</a>
        </div>
        <button id="recovery-continue" class="btn-primary btn-block">I've saved it — continue</button>
      </div>
    </section>

    <!-- Unlock (session present, key not in memory) -->
    <section id="unlock-view" class="centered" hidden>
      <div class="card">
        <h2 class="card-h">Unlock your vault</h2>
        <p class="muted">Enter your password to decrypt your library on this device.</p>
        <form id="unlock-form" class="stack">
          <input id="unlock-email" class="inp" type="email" placeholder="Email" autocomplete="username" required />
          <input id="unlock-password" class="inp" type="password" placeholder="Password" autocomplete="current-password" required />
          <label class="keep-row">
            <input id="keep-unlocked" type="checkbox" />
            <span>Stay unlocked in this tab <em>(until you close it)</em></span>
          </label>
          <button class="btn-primary btn-block" type="submit">Unlock</button>
        </form>
        <p id="unlock-error" class="error" hidden></p>
        <button id="unlock-logout" type="button" class="link">Sign out instead</button>
      </div>
    </section>

    <!-- Two-factor code (second step of login when 2FA is on) -->
    <section id="twofa-view" class="centered" hidden>
      <div class="card">
        <h2 class="card-h">Two-factor authentication</h2>
        <p class="muted">Enter the 6-digit code from your authenticator app. You can also enter one of your backup codes.</p>
        <form id="twofa-form" class="stack">
          <input id="twofa-code" class="inp" inputmode="numeric" autocomplete="one-time-code" placeholder="123456 or backup code" required autofocus />
          <button class="btn-primary btn-block" type="submit">Verify</button>
        </form>
        <p id="twofa-error" class="error" hidden></p>
        <button id="twofa-cancel" type="button" class="link">Cancel</button>
      </div>
    </section>

    <!-- Connect storage -->
    <section id="connect-view" class="centered" hidden>
      <div class="card card-wide">
        <h2 class="card-h">Connect your storage</h2>
        <p class="muted">Files live in <strong>your own</strong> cloud storage. They're encrypted in your browser first — we never receive your files or your credentials in readable form.</p>
        {dropboxEnabled && (
          <>
            <button id="connect-dropbox" type="button" class="btn-primary provider-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 2 0 6l6 4 6-4-6-4Zm12 0-6 4 6 4 6-4-6-4ZM0 14l6 4 6-4-6-4-6 4Zm18-4-6 4 6 4 6-4-6-4ZM6 19.5l6 4 6-4-6-4-6 4Z"/></svg>
              Connect Dropbox
            </button>
            <div class="provider-divider"><span>or use S3-compatible storage</span></div>
          </>
        )}
        <p class="muted s3-hint">S3-compatible: Cloudflare R2, Backblaze B2, Wasabi, or AWS S3.</p>
        <form id="connect-form" class="stack">
          <input id="c-endpoint" class="inp" placeholder="Endpoint URL (https://…)" required />
          <div class="row">
            <input id="c-region" class="inp" placeholder="Region" value="auto" required />
            <input id="c-bucket" class="inp" placeholder="Bucket name" required />
          </div>
          <input id="c-key" class="inp" placeholder="Access key ID" required />
          <input id="c-secret" class="inp" type="password" placeholder="Secret access key" autocomplete="off" required />
          <input id="c-label" class="inp" placeholder="Label (optional)" />
          <button class="btn-primary" type="submit">Test &amp; connect</button>
        </form>
        <p id="connect-error" class="error" hidden></p>
      </div>
    </section>

    <!-- Vault -->
    <section id="vault-view" hidden>
      <div class="vault-toolbar">
        <input id="search" class="inp search" placeholder="Search your files…" />
        <button id="upload-open" type="button" class="btn-primary upload-label">Upload</button>
        <input id="file-input" type="file" multiple accept="image/*,video/*,audio/*,.pdf,.txt,.md,.rtf,.csv,.json,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.odt,application/pdf,text/plain" hidden />
      </div>

      <!-- Folder selector -->
      <div id="folder-bar" class="folder-bar" hidden>
        <span class="folder-ico" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
        </span>
        <select id="folder-select" class="sort-select" aria-label="Filter by folder"></select>
        <button id="folder-new" class="btn-outline btn-sm" type="button">＋ New folder</button>
        <button id="folder-rename" class="btn-outline btn-sm" type="button" hidden>Rename</button>
        <button id="folder-delete" class="btn-outline btn-sm" type="button" hidden>Delete folder</button>
      </div>

      <!-- Category tabs + sort -->
      <div id="filter-bar" class="filter-bar" hidden>
        <div class="cat-tabs" role="tablist">
          <button class="cat-tab active" data-cat="all" type="button">All</button>
          <button class="cat-tab" data-cat="image" type="button">Images</button>
          <button class="cat-tab" data-cat="video" type="button">Videos</button>
          <button class="cat-tab" data-cat="audio" type="button">Audio</button>
          <button class="cat-tab" data-cat="doc" type="button">Docs</button>
        </div>
        <div class="fb-right">
          <select id="sort-select" class="sort-select" aria-label="Sort files">
            <option value="new">Newest first</option>
            <option value="old">Oldest first</option>
            <option value="az">Name A–Z</option>
            <option value="za">Name Z–A</option>
            <option value="big">Largest first</option>
            <option value="small">Smallest first</option>
          </select>
          <button id="view-toggle" class="view-toggle" type="button" title="Toggle grid / list view" aria-label="Toggle grid or list view"></button>
        </div>
      </div>

      <div id="upload-status" class="upload-status" hidden></div>

      <!-- Delete + undo banner -->
      <div id="undo-bar" class="undo-bar" hidden>
        <span id="undo-text" class="undo-text"></span>
        <button id="undo-btn" type="button" class="btn-ghost undo-btn">Undo</button>
      </div>

      <!-- Selection action bar (appears when items are selected) -->
      <div id="select-bar" class="select-bar" hidden>
        <span id="select-count" class="select-count">0 selected</span>
        <div class="select-actions">
          <button id="select-clear" type="button" class="btn-ghost">Clear</button>
          <button id="select-delete" type="button" class="btn-danger">Delete selected</button>
        </div>
      </div>

      <div id="grid" class="grid"></div>

      <!-- Empty (filtered) note -->
      <p id="no-match" class="muted no-match" hidden>No files match this filter.</p>

      <!-- Upload-more affordance (shown when the library has files) -->
      <div id="more-bar" class="more-bar" hidden>
        Want to upload more? <button id="upload-more" type="button" class="link">Click here</button>
      </div>

      <!-- Empty state: a real drag-and-drop zone, not a bare line of text. -->
      <button id="empty" class="dropzone" type="button" hidden>
        <span class="dropzone-icon" aria-hidden="true">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
        </span>
        <span class="dropzone-title">Drop files here, or click to upload</span>
        <span class="dropzone-sub">Photos, videos, audio, PDFs &amp; documents — encrypted in your browser before they leave this device.</span>
      </button>

      <div class="center"><span id="lib-status" class="lib-status" hidden></span></div>

      <!-- Drag & drop overlay -->
      <div id="drop-overlay" class="drop-overlay" hidden>
        <div class="drop-inner">Drop to encrypt &amp; upload</div>
      </div>
    </section>
  </main>

  <footer class="app-footer">
    <span>&copy; {new Date().getFullYear()} MediaVault — end-to-end encrypted.</span>
    <nav class="app-footer-links">
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/report">Report</a>
      <a href="/contact">Contact</a>
    </nav>
  </footer>

  <!-- In-page viewer -->
  <div id="viewer" class="viewer" hidden>
    <button id="v-close" class="v-close" aria-label="Close">✕</button>
    <button id="v-prev" class="v-nav v-prev" aria-label="Previous">‹</button>
    <div id="v-stage" class="v-stage"><div id="v-spin" class="v-spin">Decrypting…</div></div>
    <button id="v-next" class="v-nav v-next" aria-label="Next">›</button>
    <div id="v-caption" class="v-caption"></div>
  </div>

  <!-- Upload modal (drag & drop) -->
  <div id="upload-modal" class="modal" hidden>
    <div class="modal-card">
      <button id="upload-modal-close" class="modal-close" aria-label="Close">✕</button>
      <h2 class="card-h">Upload files</h2>
      <button id="modal-dropzone" class="dropzone" type="button">
        <span class="dropzone-icon" aria-hidden="true">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
        </span>
        <span class="dropzone-title">Drop files here, or click to choose</span>
        <span class="dropzone-sub">Photos, videos, audio, PDFs &amp; documents — encrypted in your browser first.</span>
      </button>
    </div>
  </div>

  <!-- Delete confirmation -->
  <div id="confirm-modal" class="modal" hidden>
    <div class="modal-card confirm-card">
      <div class="confirm-icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
        </svg>
      </div>
      <h2 class="card-h">Delete file?</h2>
      <p class="muted" id="confirm-text">This permanently removes it from your storage.</p>
      <div class="confirm-actions">
        <button id="confirm-cancel" type="button" class="btn-outline">Cancel</button>
        <button id="confirm-ok" type="button" class="btn-danger">Move to trash</button>
      </div>
    </div>
  </div>

  <!-- Trash modal -->
  <div id="trash-modal" class="modal" hidden>
    <div class="modal-card">
      <button id="trash-close" class="modal-close" aria-label="Close">✕</button>
      <h2 class="card-h">Trash</h2>
      <p class="account-p">Deleted files stay here — recoverable — until you delete them for good. They still occupy space in your own storage until then.</p>
      <ul id="trash-list" class="sessions-list"><li class="muted">Loading…</li></ul>
      <div class="row" id="trash-actions" hidden>
        <button id="trash-empty" class="btn-danger" type="button">Empty trash</button>
      </div>
      <p id="trash-msg" class="error" hidden></p>
    </div>
  </div>

  <!-- Account modal -->
  <div id="account-modal" class="modal" hidden>
    <div class="modal-card">
      <button id="account-close" class="modal-close" aria-label="Close">✕</button>
      <h2 class="card-h">Your account</h2>

      <dl class="profile-grid">
        <dt>Email</dt><dd id="profile-email">—</dd>
        <dt>Member since</dt><dd id="profile-since">—</dd>
        <dt>Files</dt><dd id="profile-items">—</dd>
        <dt>Used</dt><dd id="profile-used">—</dd>
        <dt>Storage</dt><dd id="profile-conns">—</dd>
      </dl>

      <div class="account-block">
        <h3 class="account-h">Change password</h3>
        <p class="account-p">You'll get a new recovery key after changing it — save it.</p>
        <form id="changepw-form" class="stack">
          <input id="cp-current" class="inp" type="password" placeholder="Current password" autocomplete="current-password" required />
          <input id="cp-new" class="inp" type="password" placeholder="New password" autocomplete="new-password" required minlength="8" />
          <input id="cp-new2" class="inp" type="password" placeholder="Confirm new password" autocomplete="new-password" required minlength="8" />
          <button class="btn-primary btn-block" type="submit">Change password</button>
        </form>
      </div>

      <div class="account-block">
        <h3 class="account-h">Two-factor authentication</h3>
        <p class="account-p">Add a second step at sign-in using an authenticator app (Google Authenticator, Authy, 1Password…). This protects access to your account; your files stay end-to-end encrypted either way.</p>
        <p id="twofa-state" class="twofa-state">Checking…</p>

        <!-- OFF → enable -->
        <button id="twofa-enable-start" class="btn-primary" type="button" hidden>Enable two-factor</button>

        <!-- Enrolment (QR + confirm) -->
        <div id="twofa-setup" class="twofa-setup" hidden>
          <p class="account-p">Scan this with your authenticator app, then enter the 6-digit code it shows to turn 2FA on.</p>
          <div id="twofa-qr" class="twofa-qr" aria-hidden="true"></div>
          <p class="twofa-secret">Can't scan? Enter this key: <code id="twofa-secret-text">—</code></p>
          <form id="twofa-enable-form" class="stack">
            <input id="twofa-enable-pw" class="inp" type="password" placeholder="Your password" autocomplete="current-password" required />
            <input id="twofa-enable-code" class="inp" inputmode="numeric" placeholder="6-digit code" required />
            <div class="row">
              <button class="btn-primary" type="submit">Turn on 2FA</button>
              <button id="twofa-setup-cancel" class="btn-outline" type="button">Cancel</button>
            </div>
          </form>
        </div>

        <!-- Backup codes (shown once after enabling) -->
        <div id="twofa-backup" class="twofa-backup" hidden>
          <p class="account-p"><strong>Save your backup codes.</strong> Each works once if you lose your authenticator. They won't be shown again.</p>
          <ul id="twofa-backup-list" class="backup-list"></ul>
          <div class="row">
            <button id="twofa-backup-copy" class="btn-outline" type="button">Copy codes</button>
            <button id="twofa-backup-done" class="btn-primary" type="button">Done</button>
          </div>
        </div>

        <!-- ON → disable -->
        <form id="twofa-disable-form" class="stack" hidden>
          <input id="twofa-disable-pw" class="inp" type="password" placeholder="Your password" autocomplete="current-password" required />
          <button class="btn-danger" type="submit">Turn off two-factor</button>
        </form>
        <p id="twofa-msg" class="error" hidden></p>
      </div>

      <div class="account-block">
        <h3 class="account-h">Active sessions</h3>
        <p class="account-p">Devices currently signed in to your account. Revoke any you don't recognize.</p>
        <ul id="sessions-list" class="sessions-list"><li class="muted">Loading…</li></ul>
        <button id="sessions-revoke-others" class="btn-outline" type="button" hidden>Sign out all other devices</button>
        <p id="sessions-msg" class="error" hidden></p>
      </div>

      <div class="account-block">
        <h3 class="account-h">Export your data</h3>
        <p class="account-p">Download everything we hold for you — your encrypted index, storage settings, and key envelopes — as a single JSON file. It's encrypted; useless without your password.</p>
        <a id="account-export" class="btn-ghost" href="/api/account/export">Download my data (JSON)</a>
      </div>

      <div class="account-block danger">
        <h3 class="account-h">Delete account</h3>
        <p class="account-p">Permanently removes your account and index from MediaVault. <strong>Your files in your own storage are not deleted</strong> — remove them there if you want them gone. This cannot be undone.</p>
        <button id="account-delete" class="btn-danger" type="button">Delete my account</button>
      </div>
      <p id="account-error" class="error" hidden></p>
    </div>
  </div>

  <Toast />
</BaseLayout>

<!-- Local QR generator (UMD global `qrcode`) for the 2FA enrolment code. Served
     from our own origin; the otpauth secret is rendered locally, never sent out. -->
<script src="/vendor/qrcode.js" is:inline></script>

<script>
  import { VaultClient, type Connection, type VaultItem, type Folder } from '../../lib/client/vault-client';
  import { makeThumbnail } from '../../lib/client/thumbnail';
  import { startDropboxAuth, exchangeDropboxCode } from '../../lib/storage/dropbox-oauth';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const toast = (type: 'success' | 'error' | 'info', message: string) =>
    document.dispatchEvent(new CustomEvent('toast', { detail: { type, message } }));

  const client = new VaultClient();
  const VIEWS = ['auth-view', 'reset-view', 'recovery-view', 'unlock-view', 'twofa-view', 'connect-view', 'vault-view'];
  function show(view: string) {
    for (const v of VIEWS) $(v).hidden = v !== view;
    $('appbar-actions').hidden = view !== 'vault-view';
    $('storage-label').hidden = view !== 'vault-view';
  }

  // Theme toggle (the marketing header's engine isn't loaded here). Saved theme
  // is already applied pre-paint by BaseLayout's inline script.
  (function () {
    const html = document.documentElement;
    const syncIcon = () => {
      const dark = (html.getAttribute('data-theme') || 'dark') === 'dark';
      const sun = $('app-icon-sun'), moon = $('app-icon-moon');
      if (sun) sun.style.display = dark ? 'block' : 'none';
      if (moon) moon.style.display = dark ? 'none' : 'block';
    };
    $('app-theme-toggle').addEventListener('click', () => {
      const next = (html.getAttribute('data-theme') || 'dark') === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('mv-theme', next);
      syncIcon();
    });
    syncIcon();
  })();

  let connections: Connection[] = [];
  let connMap: Record<string, Connection> = {};
  let items: VaultItem[] = [];
  let visible: VaultItem[] = [];
  let cursor: string | null = null;
  let mode: 'signin' | 'signup' = 'signin';
  let category = 'all';
  let sortKey = 'new';
  let folders: Folder[] = [];
  let folderFilter = '__all'; // '__all' | '__unfiled' | <folderId>
  let viewMode: 'grid' | 'list' = (localStorage.getItem('mv-view') as 'grid' | 'list') || 'grid';
  const thumbUrls = new Map<string, string>(); // id -> object URL (decrypted thumbnail)
  const connFor = (i: VaultItem) => connMap[i.connectionId] ?? connections[0];

  function fmtBytes(n: number): string {
    if (n < 1024) return `${n} B`;
    if (n < 1048576) return `${(n / 1024).toFixed(1)} KB`;
    if (n < 1073741824) return `${(n / 1048576).toFixed(1)} MB`;
    return `${(n / 1073741824).toFixed(2)} GB`;
  }
  const kind = (mime: string) => {
    const m = (mime || '').toLowerCase();
    if (m.startsWith('image/')) return 'image';
    if (m.startsWith('video/')) return 'video';
    if (m.startsWith('audio/')) return 'audio';
    if (m === 'application/pdf' || m.startsWith('text/') || /pdf|word|document|sheet|presentation|excel|powerpoint|rtf|epub|json|xml|csv|opendocument/.test(m)) return 'doc';
    return 'file';
  };
  // Tabs: "Docs" groups documents + anything non-media.
  const inCategory = (k: string, cat: string) => cat === 'all' || k === cat || (cat === 'doc' && (k === 'doc' || k === 'file'));

  // ── Stay-unlocked (opt-in, tab-scoped) ──────────────────────────────────────
  // Pref (whether to keep) lives in localStorage; the actual key lives ONLY in
  // sessionStorage (cleared when the tab closes). Off by default — security first.
  const KEEP_PREF = 'mv-keep';
  const SK_KEY = 'mv-sk';
  const keepEnabled = () => localStorage.getItem(KEEP_PREF) === '1';
  function persistKeyIfKept() {
    if (!keepEnabled()) return;
    const k = client.exportSessionKey();
    if (k) { try { sessionStorage.setItem(SK_KEY, k); } catch {} }
  }
  function clearKeptKey() { try { sessionStorage.removeItem(SK_KEY); } catch {} }

  // ── Boot ────────────────────────────────────────────────────────────────────
  async function boot() {
    let authed = false;
    try { authed = (await (await fetch('/api/auth/me')).json()).authenticated === true; } catch {}
    if (!authed) { clearKeptKey(); show('auth-view'); return; }

    // If the user opted to stay unlocked and the key is still in this tab, skip the prompt.
    const stored = sessionStorage.getItem(SK_KEY);
    if (stored && client.restoreSessionKey(stored)) {
      try { await afterUnlock(); return; } catch { clearKeptKey(); client.lock(); }
    }
    ($('unlock-email') as HTMLInputElement).value = localStorage.getItem('mv_email') ?? '';
    ($('keep-unlocked') as HTMLInputElement).checked = keepEnabled();
    show('unlock-view');
  }

  // ── Password strength (advisory; weak password = weak encryption) ───────────
  const COMMON_PW = ['password', '12345678', '123456789', 'qwerty', 'letmein', 'iloveyou', 'admin', 'welcome', 'monkey', 'dragon', '111111', 'abc123', 'password1', 'qwerty123'];
  function passwordStrength(pw: string) {
    const buckets = [
      { label: 'Too short', color: '#ef4444' },
      { label: 'Weak', color: '#ef4444' },
      { label: 'Fair', color: '#f59e0b' },
      { label: 'Good', color: '#3b82f6' },
      { label: 'Strong', color: '#10b981' },
      { label: 'Very strong', color: '#10b981' },
    ];
    let score = 0;
    if (pw.length >= 8) score++;
    if (pw.length >= 12) score++;
    if (/[a-z]/.test(pw) && /[A-Z]/.test(pw)) score++;
    if (/\d/.test(pw)) score++;
    if (/[^A-Za-z0-9]/.test(pw)) score++;
    if (COMMON_PW.some((c) => pw.toLowerCase().includes(c))) score = Math.min(score, 1);
    if (pw.length < 8) score = 0;
    const b = buckets[Math.min(score, 5)];
    return { label: b.label, color: b.color, pct: Math.min(100, (score / 5) * 100) };
  }
  function updatePwStrength() {
    const pw = ($('password') as HTMLInputElement).value;
    if (mode !== 'signup' || !pw) { $('pw-strength').hidden = true; return; }
    const s = passwordStrength(pw);
    $('pw-strength').hidden = false;
    ($('pw-fill') as HTMLElement).style.width = `${s.pct}%`;
    ($('pw-fill') as HTMLElement).style.background = s.color;
    $('pw-label').textContent = s.label;
    ($('pw-label') as HTMLElement).style.color = s.color;
  }
  $('password').addEventListener('input', updatePwStrength);

  // ── Auth ────────────────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.tab').forEach((t) =>
    t.addEventListener('click', () => {
      mode = t.dataset.tab as 'signin' | 'signup';
      document.querySelectorAll('.tab').forEach((x) => x.classList.toggle('active', x === t));
      ($('password2') as HTMLInputElement).hidden = mode !== 'signup';
      $('auth-submit').textContent = mode === 'signup' ? 'Create account' : 'Sign in';
      $('forgot-link').hidden = mode !== 'signin'; // recovery only makes sense on sign in
      updatePwStrength();
    }),
  );
  $('forgot-link').hidden = false; // default tab is sign in

  // ── Forgot password → reset with recovery key ───────────────────────────────
  $('forgot-link').addEventListener('click', () => {
    ($('reset-email') as HTMLInputElement).value = ($('email') as HTMLInputElement).value.trim() || (localStorage.getItem('mv_email') ?? '');
    $('reset-error').hidden = true;
    show('reset-view');
  });
  $('reset-back').addEventListener('click', () => show('auth-view'));

  $('reset-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    $('reset-error').hidden = true;
    const email = ($('reset-email') as HTMLInputElement).value.trim();
    const recKey = ($('reset-reckey') as HTMLTextAreaElement).value.trim();
    const pw = ($('reset-password') as HTMLInputElement).value;
    if (pw !== ($('reset-password2') as HTMLInputElement).value) { showErr('reset-error', new Error('Passwords do not match.')); return; }
    try {
      const { recoveryKey } = await client.resetWithRecovery(email, recKey, pw);
      localStorage.setItem('mv_email', email);
      $('recovery-key').textContent = recoveryKey;
      toast('success', 'Password reset — here is your new recovery key');
      show('recovery-view');
    } catch (err) {
      showErr('reset-error', err);
    }
  });

  $('auth-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    $('auth-error').hidden = true;
    const email = ($('email') as HTMLInputElement).value.trim();
    const pw = ($('password') as HTMLInputElement).value;
    const btn = $('auth-submit') as HTMLButtonElement;
    btn.disabled = true;
    const original = btn.textContent;
    btn.textContent = mode === 'signup' ? 'Creating…' : 'Signing in…';
    try {
      if (mode === 'signup') {
        if (pw !== ($('password2') as HTMLInputElement).value) throw new Error('Passwords do not match.');
        const { recoveryKey } = await client.signup(email, pw);
        localStorage.setItem('mv_email', email);
        $('recovery-key').textContent = recoveryKey;
        try { sessionStorage.setItem('mv_recovery_key', recoveryKey); } catch {}
        show('recovery-view');
      } else {
        const r = await client.login(email, pw);
        localStorage.setItem('mv_email', email);
        if (r.twofaRequired) startTwofa(pw, r.pendingToken!);
        else { await afterUnlock(); persistKeyIfKept(); }
      }
    } catch (err) {
      showErr('auth-error', err);
    } finally {
      btn.disabled = false;
      btn.textContent = original;
    }
  });

  $('recovery-continue').addEventListener('click', () => afterUnlock());
  $('copy-key').addEventListener('click', () =>
    navigator.clipboard?.writeText($('recovery-key').textContent ?? '').then(() => toast('success', 'Recovery key copied')),
  );

  $('unlock-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    $('unlock-error').hidden = true;
    const keep = ($('keep-unlocked') as HTMLInputElement).checked;
    localStorage.setItem(KEEP_PREF, keep ? '1' : '0');
    try {
      const email = ($('unlock-email') as HTMLInputElement).value.trim();
      const pw = ($('unlock-password') as HTMLInputElement).value;
      const r = await client.login(email, pw);
      localStorage.setItem('mv_email', email);
      if (r.twofaRequired) startTwofa(pw, r.pendingToken!);
      else { await afterUnlock(); persistKeyIfKept(); }
    } catch (err) {
      showErr('unlock-error', err);
    }
  });

  // ── Two-factor login step ───────────────────────────────────────────────────
  let twofaPending: { password: string; pendingToken: string } | null = null;
  function startTwofa(password: string, pendingToken: string) {
    twofaPending = { password, pendingToken };
    ($('twofa-code') as HTMLInputElement).value = '';
    $('twofa-error').hidden = true;
    show('twofa-view');
    ($('twofa-code') as HTMLInputElement).focus();
  }
  $('twofa-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    $('twofa-error').hidden = true;
    if (!twofaPending) return show('auth-view');
    const code = ($('twofa-code') as HTMLInputElement).value;
    const btn = ($('twofa-form').querySelector('button') as HTMLButtonElement);
    btn.disabled = true;
    try {
      await client.completeTwoFactorLogin(twofaPending.password, twofaPending.pendingToken, code);
      twofaPending = null;
      await afterUnlock();
      persistKeyIfKept();
    } catch (err) {
      showErr('twofa-error', err);
    } finally {
      btn.disabled = false;
    }
  });
  $('twofa-cancel').addEventListener('click', async () => {
    twofaPending = null;
    await client.logout().catch(() => {});
    show('auth-view');
  });
  $('unlock-logout').addEventListener('click', async () => { await commitPending(); clearKeptKey(); await client.logout(); show('auth-view'); });
  $('lock-btn').addEventListener('click', async () => { await commitPending(); clearKeptKey(); revokeThumbs(); await client.logout(); show('auth-view'); });

  // ── Account modal (profile / change password / export / delete) ─────────────
  $('account-btn').addEventListener('click', async () => {
    $('account-error').hidden = true;
    $('profile-email').textContent = localStorage.getItem('mv_email') ?? '—';
    $('profile-since').textContent = '…';
    $('profile-items').textContent = '…';
    $('profile-conns').textContent = '…';
    $('account-modal').hidden = false;
    // Storage used = sum of ciphertext sizes across the fully-loaded index (client-side).
    $('profile-used').textContent = fmtBytes(items.reduce((n, i) => n + (i.size || 0), 0));
    refreshTwofa();
    refreshSessions();
    try {
      const p = await client.getProfile();
      $('profile-email').textContent = p.email;
      $('profile-since').textContent = new Date(p.createdAt).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
      $('profile-items').textContent = `${p.itemCount}`;
      $('profile-conns').textContent = p.connectionCount ? `${p.connectionCount} connected` : 'none';
    } catch {
      $('profile-since').textContent = '—'; $('profile-items').textContent = '—'; $('profile-conns').textContent = '—';
    }
  });

  $('changepw-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    $('account-error').hidden = true;
    const email = localStorage.getItem('mv_email') ?? '';
    const cur = ($('cp-current') as HTMLInputElement).value;
    const nw = ($('cp-new') as HTMLInputElement).value;
    if (nw !== ($('cp-new2') as HTMLInputElement).value) { showErr('account-error', new Error('New passwords do not match.')); return; }
    try {
      const { recoveryKey } = await client.changePassword(email, cur, nw);
      (e.target as HTMLFormElement).reset();
      $('account-modal').hidden = true;
      $('recovery-key').textContent = recoveryKey;
      toast('success', 'Password changed — here is your new recovery key');
      show('recovery-view');
    } catch (err) {
      const msg = (err as Error).message;
      showErr('account-error', new Error(msg === 'invalid_credentials' ? 'Current password is incorrect.' : msg));
    }
  });

  // ── Two-factor enrolment (Account → Security) ───────────────────────────────
  const acctEmail = () => localStorage.getItem('mv_email') ?? '';
  function hide2faSubpanels() {
    $('twofa-setup').hidden = true;
    $('twofa-backup').hidden = true;
    $('twofa-disable-form').hidden = true;
    $('twofa-enable-start').hidden = true;
    $('twofa-msg').hidden = true;
  }
  async function refreshTwofa() {
    hide2faSubpanels();
    $('twofa-state').textContent = 'Checking…';
    try {
      const s = await client.twoFactorStatus();
      $('twofa-state').textContent = s.enabled ? 'Two-factor is ON for your account.' : 'Two-factor is off.';
      ($(s.enabled ? 'twofa-disable-form' : 'twofa-enable-start')).hidden = false;
    } catch {
      $('twofa-state').textContent = 'Could not load 2FA status.';
    }
  }
  function renderQr(el: HTMLElement, text: string) {
    el.innerHTML = '';
    try {
      // @ts-ignore — vendored UMD global
      const qr = qrcode(0, 'M');
      qr.addData(text);
      qr.make();
      // @ts-ignore
      el.innerHTML = qr.createSvgTag({ cellSize: 4, margin: 1 });
    } catch { el.textContent = 'QR unavailable — type the key below into your app.'; }
  }
  $('twofa-enable-start').addEventListener('click', async () => {
    $('twofa-msg').hidden = true;
    try {
      const { secret, otpauthUrl } = await client.twoFactorSetup();
      ($('twofa-secret-text')).textContent = secret;
      renderQr($('twofa-qr'), otpauthUrl);
      $('twofa-enable-start').hidden = true;
      $('twofa-setup').hidden = false;
      ($('twofa-enable-pw') as HTMLInputElement).value = '';
      ($('twofa-enable-code') as HTMLInputElement).value = '';
    } catch (err) { showErr('twofa-msg', err); }
  });
  $('twofa-setup-cancel').addEventListener('click', () => refreshTwofa());
  $('twofa-enable-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    $('twofa-msg').hidden = true;
    try {
      const { backupCodes } = await client.twoFactorEnable(
        acctEmail(),
        ($('twofa-enable-pw') as HTMLInputElement).value,
        ($('twofa-enable-code') as HTMLInputElement).value,
      );
      $('twofa-setup').hidden = true;
      const list = $('twofa-backup-list');
      list.innerHTML = '';
      for (const c of backupCodes) { const li = document.createElement('li'); li.textContent = c; list.appendChild(li); }
      $('twofa-backup').hidden = false;
      $('twofa-state').textContent = 'Two-factor is ON for your account.';
      toast('success', 'Two-factor authentication enabled');
    } catch (err) {
      const m = (err as Error).message;
      showErr('twofa-msg', new Error(
        m === 'invalid_credentials' ? 'Password is incorrect.'
        : m === 'twofa_invalid' ? 'That code is not valid — enter the current one from your app.'
        : m));
    }
  });
  $('twofa-backup-copy').addEventListener('click', () => {
    const codes = [...$('twofa-backup-list').querySelectorAll('li')].map((li) => li.textContent).join('\n');
    navigator.clipboard?.writeText(codes).then(() => toast('success', 'Backup codes copied'));
  });
  $('twofa-backup-done').addEventListener('click', () => refreshTwofa());
  $('twofa-disable-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    $('twofa-msg').hidden = true;
    try {
      await client.twoFactorDisable(acctEmail(), ($('twofa-disable-pw') as HTMLInputElement).value);
      ($('twofa-disable-pw') as HTMLInputElement).value = '';
      toast('success', 'Two-factor disabled');
      refreshTwofa();
    } catch (err) {
      const m = (err as Error).message;
      showErr('twofa-msg', new Error(m === 'invalid_credentials' ? 'Password is incorrect.' : m));
    }
  });

  // ── Active sessions (Account → Security) ────────────────────────────────────
  function fmtWhen(ts: number): string {
    const d = Date.now() - ts;
    if (d < 60000) return 'just now';
    if (d < 3600000) return `${Math.floor(d / 60000)} min ago`;
    if (d < 86400000) return `${Math.floor(d / 3600000)} h ago`;
    return new Date(ts).toLocaleDateString();
  }
  async function refreshSessions() {
    const list = $('sessions-list');
    list.innerHTML = '<li class="muted">Loading…</li>';
    $('sessions-revoke-others').hidden = true;
    $('sessions-msg').hidden = true;
    try {
      const sessions = await client.listSessions();
      list.innerHTML = '';
      for (const s of sessions) {
        const li = document.createElement('li');
        li.className = 'session-row';
        const info = document.createElement('div');
        const name = document.createElement('div');
        name.className = 'session-device';
        name.textContent = s.device + (s.current ? ' · this device' : '');
        const meta = document.createElement('div');
        meta.className = 'session-meta';
        meta.textContent = `${s.ip ?? 'unknown IP'} · active ${fmtWhen(s.lastSeen)}`;
        info.append(name, meta);
        li.appendChild(info);
        if (s.current) {
          const tag = document.createElement('span');
          tag.className = 'session-current';
          tag.textContent = 'current';
          li.appendChild(tag);
        } else {
          const btn = document.createElement('button');
          btn.className = 'btn-outline btn-sm';
          btn.textContent = 'Revoke';
          btn.addEventListener('click', async () => {
            btn.disabled = true;
            try { await client.revokeSession(s.id); refreshSessions(); }
            catch (err) { showErr('sessions-msg', err); btn.disabled = false; }
          });
          li.appendChild(btn);
        }
        list.appendChild(li);
      }
      if (sessions.length > 1) $('sessions-revoke-others').hidden = false;
    } catch (err) {
      list.innerHTML = '';
      showErr('sessions-msg', err);
    }
  }
  $('sessions-revoke-others').addEventListener('click', async () => {
    if (!confirm('Sign out of all other devices? They will need to log in again.')) return;
    try { await client.revokeOtherSessions(); toast('success', 'Signed out other devices'); refreshSessions(); }
    catch (err) { showErr('sessions-msg', err); }
  });

  $('account-close').addEventListener('click', () => { $('account-modal').hidden = true; });
  $('account-modal').addEventListener('click', (e) => { if (e.target === $('account-modal')) $('account-modal').hidden = true; });
  $('account-delete').addEventListener('click', async () => {
    if (!confirm('Permanently delete your MediaVault account and index?\n\nYour files in your own storage are NOT deleted. This cannot be undone.')) return;
    if (!confirm('Are you absolutely sure? There is no recovery.')) return;
    $('account-error').hidden = true;
    try {
      await client.deleteAccount();
      clearKeptKey();
      revokeThumbs();
      $('account-modal').hidden = true;
      localStorage.removeItem('mv_email');
      toast('success', 'Your account has been deleted');
      show('auth-view');
    } catch (err) {
      showErr('account-error', err);
    }
  });

  // ── Trash (soft-deleted files: restore or delete forever) ───────────────────
  let trashList: VaultItem[] = [];
  $('trash-btn').addEventListener('click', () => openTrash());
  $('trash-close').addEventListener('click', () => { $('trash-modal').hidden = true; });
  $('trash-modal').addEventListener('click', (e) => { if (e.target === $('trash-modal')) $('trash-modal').hidden = true; });

  async function openTrash() {
    await commitPending(); // make sure any in-flight "moving to trash" has landed
    $('trash-modal').hidden = false;
    $('trash-msg').hidden = true;
    $('trash-list').innerHTML = '<li class="muted">Loading…</li>';
    try {
      trashList = [];
      let cursor: string | null = null;
      do {
        const page = await client.listPage({ cursor, trashed: true, limit: 200 });
        trashList.push(...page.items);
        cursor = page.nextCursor;
      } while (cursor);
      renderTrash();
    } catch (err) { $('trash-list').innerHTML = ''; showErr('trash-msg', err); }
  }

  function renderTrash() {
    const list = $('trash-list');
    list.innerHTML = '';
    $('trash-actions').hidden = trashList.length === 0;
    if (trashList.length === 0) { list.innerHTML = '<li class="muted">Trash is empty.</li>'; return; }
    for (const item of trashList) {
      const li = document.createElement('li');
      li.className = 'session-row';
      const info = document.createElement('div');
      const name = document.createElement('div'); name.className = 'session-device'; name.textContent = item.metadata.name;
      const k = kind(item.metadata.mime);
      const meta = document.createElement('div'); meta.className = 'session-meta';
      meta.textContent = `${k === 'file' ? 'FILE' : k.toUpperCase()} · ${fmtBytes(item.metadata.size)}`;
      info.append(name, meta);
      li.appendChild(info);
      const actions = document.createElement('div'); actions.className = 'trash-row-actions';
      const restoreBtn = document.createElement('button'); restoreBtn.className = 'btn-outline btn-sm'; restoreBtn.textContent = 'Restore';
      restoreBtn.addEventListener('click', async () => {
        restoreBtn.disabled = true;
        try {
          await client.restore(item);
          trashList = trashList.filter((i) => i.id !== item.id);
          items = items.concat(item); // back into the live gallery
          renderTrash(); render();
          toast('success', 'Restored');
        } catch (err) { showErr('trash-msg', err); restoreBtn.disabled = false; }
      });
      const delBtn = document.createElement('button'); delBtn.className = 'btn-sm trash-del'; delBtn.textContent = 'Delete forever';
      delBtn.addEventListener('click', async () => {
        if (!confirm(`Permanently delete "${item.metadata.name}"? This removes it from your storage too and cannot be undone.`)) return;
        delBtn.disabled = true;
        try {
          await client.remove(item, connFor(item)); // purge bucket object + index row
          trashList = trashList.filter((i) => i.id !== item.id);
          renderTrash();
          toast('success', 'Deleted permanently');
        } catch (err) { showErr('trash-msg', err); delBtn.disabled = false; }
      });
      actions.append(restoreBtn, delBtn);
      li.appendChild(actions);
      list.appendChild(li);
    }
  }

  $('trash-empty').addEventListener('click', async () => {
    if (!trashList.length) return;
    if (!confirm(`Permanently delete all ${trashList.length} file(s) in the trash? This removes them from your storage and cannot be undone.`)) return;
    const btn = $('trash-empty') as HTMLButtonElement; btn.disabled = true;
    let failed = 0;
    for (const item of [...trashList]) {
      try { await client.remove(item, connFor(item)); trashList = trashList.filter((i) => i.id !== item.id); }
      catch { failed++; }
    }
    renderTrash(); btn.disabled = false;
    toast(failed ? 'error' : 'success', failed ? `${failed} could not be deleted` : 'Trash emptied');
  });

  // ── After unlock ──────────────────────────────────────────────────────────────
  async function afterUnlock() {
    try { connections = await client.getConnections(); } catch { connections = []; }
    connMap = Object.fromEntries(connections.map((c) => [c.id, c]));
    if (connections.length === 0) { show('connect-view'); return; }
    $('storage-label').textContent = connections[0].label || connections[0].provider.toUpperCase();
    show('vault-view');
    try { folders = await client.listFolders(); } catch { folders = []; }
    populateFolderSelect();
    await loadFirstPage();
  }

  // ── Folders ─────────────────────────────────────────────────────────────────
  function folderName(id: string): string { return folders.find((f) => f.id === id)?.name ?? 'Folder'; }
  function populateFolderSelect() {
    const sel = $('folder-select') as HTMLSelectElement;
    const counts = new Map<string, number>();
    let unfiled = 0;
    for (const i of items) { const f = folderOf(i); if (f) counts.set(f, (counts.get(f) ?? 0) + 1); else unfiled++; }
    const opts = [`<option value="__all">All files (${items.length})</option>`,
                  `<option value="__unfiled">Unfiled (${unfiled})</option>`];
    for (const f of folders) opts.push(`<option value="${f.id}">${escapeHtml(f.name)} (${counts.get(f.id) ?? 0})</option>`);
    // if the current folderFilter no longer exists, fall back to All
    if (folderFilter !== '__all' && folderFilter !== '__unfiled' && !folders.some((f) => f.id === folderFilter)) folderFilter = '__all';
    sel.innerHTML = opts.join('');
    sel.value = folderFilter;
    const realFolder = folderFilter !== '__all' && folderFilter !== '__unfiled';
    $('folder-rename').hidden = !realFolder;
    $('folder-delete').hidden = !realFolder;
  }
  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  }

  $('folder-select').addEventListener('change', (e) => {
    folderFilter = (e.target as HTMLSelectElement).value;
    populateFolderSelect(); // refresh rename/delete visibility
    render();
  });
  $('folder-new').addEventListener('click', async () => {
    const name = prompt('New folder name:')?.trim();
    if (!name) return;
    try {
      const f = await client.createFolder(name);
      folders.push(f);
      folderFilter = f.id;
      populateFolderSelect();
      render();
      toast('success', `Folder “${f.name}” created`);
    } catch (err) { toast('error', (err as Error).message || 'Could not create folder'); }
  });
  $('folder-rename').addEventListener('click', async () => {
    if (folderFilter === '__all' || folderFilter === '__unfiled') return;
    const cur = folderName(folderFilter);
    const name = prompt('Rename folder:', cur)?.trim();
    if (!name || name === cur) return;
    try {
      await client.renameFolder(folderFilter, name);
      const f = folders.find((x) => x.id === folderFilter); if (f) f.name = name;
      populateFolderSelect();
      toast('success', 'Folder renamed');
    } catch (err) { toast('error', (err as Error).message || 'Could not rename folder'); }
  });
  $('folder-delete').addEventListener('click', async () => {
    if (folderFilter === '__all' || folderFilter === '__unfiled') return;
    const id = folderFilter;
    const inThis = items.filter((i) => folderOf(i) === id);
    if (!confirm(`Delete folder “${folderName(id)}”? Its ${inThis.length} file${inThis.length === 1 ? '' : 's'} will move to All files (not deleted).`)) return;
    try {
      for (const item of inThis) await client.moveToFolder(item, null); // re-file to root first
      await client.deleteFolder(id);
      folders = folders.filter((f) => f.id !== id);
      folderFilter = '__all';
      populateFolderSelect();
      render();
      toast('success', 'Folder deleted');
    } catch (err) { toast('error', (err as Error).message || 'Could not delete folder'); }
  });

  $('connect-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    $('connect-error').hidden = true;
    const cfg = {
      kind: 's3' as const,
      endpoint: ($('c-endpoint') as HTMLInputElement).value.trim(),
      region: ($('c-region') as HTMLInputElement).value.trim() || 'auto',
      bucket: ($('c-bucket') as HTMLInputElement).value.trim(),
      accessKeyId: ($('c-key') as HTMLInputElement).value.trim(),
      secretAccessKey: ($('c-secret') as HTMLInputElement).value,
    };
    const label = ($('c-label') as HTMLInputElement).value.trim();
    try {
      await client.addConnection(cfg, label || undefined);
      toast('success', 'Storage connected');
      await afterUnlock();
    } catch (err) {
      showErr('connect-error', err);
    }
  });

  // ── Dropbox connect (OAuth PKCE via popup) ──────────────────────────────────
  // The whole flow stays in the browser: a popup gets the auth code, posts it
  // back here, and we exchange it for tokens with PKCE (no secret, no operator
  // round-trip). Tokens are then stored ENCRYPTED like any other connection.
  const DROPBOX_CLIENT_ID = import.meta.env.PUBLIC_DROPBOX_CLIENT_ID ?? '';
  const dropboxBtn = document.getElementById('connect-dropbox');
  if (dropboxBtn && DROPBOX_CLIENT_ID) {
    let pending: { state: string; verifier: string } | null = null;
    const redirectUri = `${location.origin}/app/connect/dropbox`;

    dropboxBtn.addEventListener('click', async () => {
      $('connect-error').hidden = true;
      try {
        const auth = await startDropboxAuth(DROPBOX_CLIENT_ID, redirectUri);
        pending = { state: auth.state, verifier: auth.verifier };
        const w = window.open(auth.url, 'mv-dropbox', 'width=560,height=720');
        if (!w) throw new Error('Popup blocked — allow popups for this site and try again.');
      } catch (err) {
        showErr('connect-error', err);
      }
    });

    window.addEventListener('message', async (ev: MessageEvent) => {
      if (ev.origin !== location.origin) return;
      const d = ev.data;
      if (!d || d.type !== 'mv-dropbox-oauth' || !pending) return;
      const { state, verifier } = pending;
      pending = null;
      try {
        if (d.error) throw new Error(d.error);
        if (!d.code || d.state !== state) throw new Error('Dropbox sign-in could not be verified — please retry.');
        const tokens = await exchangeDropboxCode(
          { clientId: DROPBOX_CLIENT_ID, code: d.code, verifier, redirectUri },
        );
        await client.addConnection(
          {
            kind: 'dropbox',
            clientId: DROPBOX_CLIENT_ID,
            accessToken: tokens.accessToken,
            refreshToken: tokens.refreshToken,
            expiresAt: tokens.expiresAt,
          },
          'Dropbox',
        );
        toast('success', 'Dropbox connected');
        await afterUnlock();
      } catch (err) {
        showErr('connect-error', err);
      }
    });
  }

  // ── List + render ─────────────────────────────────────────────────────────────
  // We load the ENTIRE encrypted index, not just one page. Names, types and
  // categories live inside each item's end-to-end-encrypted metadata, so the
  // server can't sort, filter or search by them without breaking zero-knowledge.
  // The index itself is tiny (opaque blobs), so the client pulls it all and does
  // sort/filter/search locally over the complete set — correct, not per-page.
  let loadingAll = false;
  async function loadFirstPage() {
    items = [];
    cursor = null;
    revokeThumbs();
    $('grid').innerHTML = '';
    await loadAll();
  }
  async function loadAll() {
    if (loadingAll) return;
    loadingAll = true;
    const status = $('lib-status');
    let first = true;
    try {
      do {
        const page = await client.listPage({ cursor, limit: 200 });
        items.push(...page.items);
        cursor = page.nextCursor;
        if (first) { render(); first = false; } // paint the first batch immediately
        if (cursor) {
          status.hidden = false;
          status.textContent = `Loading your library… ${items.length}`;
        }
      } while (cursor);
    } finally {
      loadingAll = false;
      status.hidden = true;
      render(); // final render over the full set → sort/filter/search now complete
      populateFolderSelect(); // now that item counts are known
    }
  }
  $('search').addEventListener('input', render);

  // Category tabs + sort
  document.querySelectorAll<HTMLButtonElement>('.cat-tab').forEach((t) =>
    t.addEventListener('click', () => {
      category = t.dataset.cat || 'all';
      document.querySelectorAll('.cat-tab').forEach((x) => x.classList.toggle('active', x === t));
      render();
    }),
  );
  $('sort-select').addEventListener('change', (e) => { sortKey = (e.target as HTMLSelectElement).value; render(); });

  // Grid / list view toggle (persisted). Shows the icon of the OTHER mode.
  const GRID_ICON = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>';
  const LIST_ICON = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>';
  function syncViewToggle() { $('view-toggle').innerHTML = viewMode === 'grid' ? LIST_ICON : GRID_ICON; }
  syncViewToggle();
  $('view-toggle').addEventListener('click', () => {
    viewMode = viewMode === 'grid' ? 'list' : 'grid';
    localStorage.setItem('mv-view', viewMode);
    syncViewToggle();
    render();
  });

  // Lazy-load thumbnails only as cards scroll into view (scales to big libraries).
  const thumbObserver = new IntersectionObserver(
    (entries) => {
      for (const en of entries) {
        if (en.isIntersecting) {
          thumbObserver.unobserve(en.target);
          loadThumb(en.target as HTMLElement);
        }
      }
    },
    { rootMargin: '200px' },
  );

  const TRASH_SVG = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>';

  function sortFiltered(list: VaultItem[]): VaultItem[] {
    const byName = (a: VaultItem, b: VaultItem) => a.metadata.name.localeCompare(b.metadata.name);
    const cmp: Record<string, (a: VaultItem, b: VaultItem) => number> = {
      new: (a, b) => b.createdAt - a.createdAt,
      old: (a, b) => a.createdAt - b.createdAt,
      az: byName,
      za: (a, b) => byName(b, a),
      big: (a, b) => b.metadata.size - a.metadata.size,
      small: (a, b) => a.metadata.size - b.metadata.size,
    };
    const by = cmp[sortKey] || cmp.new;
    return [...list].sort((a, b) => {
      if (a.bookmarked !== b.bookmarked) return a.bookmarked ? -1 : 1; // bookmarked first
      return by(a, b);
    });
  }

  const folderOf = (i: VaultItem) => (i.metadata.folderId as string | undefined) || null;
  function inFolder(i: VaultItem): boolean {
    if (folderFilter === '__all') return true;
    if (folderFilter === '__unfiled') return folderOf(i) === null;
    return folderOf(i) === folderFilter;
  }
  function render() {
    const q = ($('search') as HTMLInputElement).value.toLowerCase();
    let list = items.filter(inFolder);
    if (q) list = list.filter((i) => i.metadata.name.toLowerCase().includes(q));
    list = list.filter((i) => inCategory(kind(i.metadata.mime), category));
    visible = sortFiltered(list);

    $('empty').hidden = items.length !== 0;            // first-run dropzone
    $('filter-bar').hidden = items.length === 0;
    $('folder-bar').hidden = items.length === 0 && folders.length === 0;
    $('more-bar').hidden = items.length === 0;
    $('no-match').hidden = items.length === 0 || visible.length !== 0; // have files but filter empties them
    const grid = $('grid');
    grid.className = viewMode === 'list' ? 'list' : 'grid';
    grid.innerHTML = '';
    visible.forEach((item, idx) => {
      const k = kind(item.metadata.mime);
      const card = document.createElement('div');
      card.className = 'tile' + (selected.has(item.id) ? ' selected' : '');
      card.dataset.id = item.id;

      const media = document.createElement('div');
      media.className = `tile-media kind-${k}`;
      if (thumbUrls.has(item.id)) media.style.backgroundImage = `url(${thumbUrls.get(item.id)})`;

      const check = document.createElement('button');
      check.className = 'tile-check';
      check.setAttribute('aria-label', 'Select file');
      check.addEventListener('click', (ev) => { ev.stopPropagation(); toggleSelect(item.id); });

      const fav = document.createElement('button');
      fav.className = 'tile-fav' + (item.bookmarked ? ' on' : '');
      fav.textContent = item.bookmarked ? '★' : '☆';
      fav.title = 'Bookmark';
      fav.addEventListener('click', (ev) => { ev.stopPropagation(); toggleStar(item); });

      const del = document.createElement('button');
      del.className = 'tile-del';
      del.title = 'Delete';
      del.innerHTML = TRASH_SVG;
      del.addEventListener('click', (ev) => { ev.stopPropagation(); remove(item); });

      const type = document.createElement('span');
      type.className = 'tile-type';
      type.textContent = (k === 'doc' || k === 'file') ? 'DOC' : k.toUpperCase();

      media.append(check, fav, del, type);
      if (k === 'video') { const ind = document.createElement('span'); ind.className = 'tile-play'; media.appendChild(ind); }
      else if (k === 'audio') { const ind = document.createElement('span'); ind.className = 'tile-note'; media.appendChild(ind); }
      else if (k === 'doc' || k === 'file') { const ind = document.createElement('span'); ind.className = 'tile-doc'; media.appendChild(ind); }
      card.appendChild(media);

      const foot = document.createElement('div');
      foot.className = 'tile-foot';
      const name = document.createElement('div');
      name.className = 'tile-name';
      name.textContent = item.metadata.name; // textContent — XSS-safe
      name.title = item.metadata.name;
      const sub = document.createElement('div');
      sub.className = 'tile-sub';
      sub.textContent = `${k === 'file' ? 'document' : k} · ${fmtBytes(item.metadata.size)}`;
      foot.append(name, sub);
      card.appendChild(foot);

      card.addEventListener('click', () => {
        if (selected.size > 0) toggleSelect(item.id); // in selection mode, click toggles
        else openViewer(idx);
      });
      grid.appendChild(card);
      if (item.thumbKey && !thumbUrls.has(item.id)) thumbObserver.observe(card);
    });
    updateSelectBar();
  }

  // ── Multi-select ────────────────────────────────────────────────────────────
  const selected = new Set<string>();
  function toggleSelect(id: string) {
    if (selected.has(id)) selected.delete(id);
    else selected.add(id);
    const card = $('grid').querySelector<HTMLElement>(`.tile[data-id="${id}"]`);
    card?.classList.toggle('selected', selected.has(id));
    updateSelectBar();
  }
  function updateSelectBar() {
    const n = selected.size;
    $('select-bar').hidden = n === 0;
    $('select-count').textContent = `${n} selected`;
  }
  $('select-clear').addEventListener('click', () => { selected.clear(); render(); });
  $('select-delete').addEventListener('click', () => {
    const batch = items.filter((i) => selected.has(i.id));
    askDelete(batch);
  });

  // Styled confirmation before deleting (then the 5s-undo soft delete runs).
  let confirmBatch: VaultItem[] = [];
  function askDelete(batch: VaultItem[]) {
    if (!batch.length) return;
    confirmBatch = batch;
    $('confirm-modal').querySelector('.card-h')!.textContent = batch.length === 1 ? 'Move to trash?' : `Move ${batch.length} files to trash?`;
    $('confirm-text').textContent = batch.length === 1
      ? `“${batch[0].metadata.name}” will move to the Trash. You can restore it later, or delete it for good from there.`
      : `These ${batch.length} files will move to the Trash. You can restore them later, or delete them for good from there.`;
    $('confirm-modal').hidden = false;
  }
  function closeConfirm() { $('confirm-modal').hidden = true; confirmBatch = []; }
  $('confirm-cancel').addEventListener('click', closeConfirm);
  $('confirm-modal').addEventListener('click', (e) => { if (e.target === $('confirm-modal')) closeConfirm(); });
  $('confirm-ok').addEventListener('click', () => {
    const batch = confirmBatch;
    closeConfirm();
    if (batch.length) softDelete(batch);
  });

  // ── Delete with a 5-second undo (Gmail-style; replaces the JS confirm) ────────
  // The item disappears immediately and the real storage+index removal only runs
  // after 5s, so "Undo" is instant and can't fail.
  let pendingDelete: { items: VaultItem[]; timer: number; interval: number } | null = null;

  async function commitPending(): Promise<void> {
    if (!pendingDelete) return;
    const batch = pendingDelete.items;
    clearTimeout(pendingDelete.timer);
    clearInterval(pendingDelete.interval);
    pendingDelete = null;
    ($('undo-btn') as HTMLButtonElement).hidden = true;
    $('undo-text').textContent = `Moving ${batch.length} file${batch.length === 1 ? '' : 's'} to trash…`;
    $('undo-bar').hidden = false;
    let done = 0;
    for (const item of batch) {
      try {
        await client.trash(item); // soft-delete: recoverable from Trash, bytes stay put
        const u = thumbUrls.get(item.id); if (u) { URL.revokeObjectURL(u); thumbUrls.delete(item.id); }
        done++;
      } catch { /* leave it; it will reappear on next refresh */ }
    }
    $('undo-bar').hidden = true;
    ($('undo-btn') as HTMLButtonElement).hidden = false;
    if (done) toast('success', `Moved ${done} file${done === 1 ? '' : 's'} to trash`);
    if (done < batch.length) toast('error', `${batch.length - done} could not be moved`);
  }

  async function softDelete(batch: VaultItem[]) {
    if (!batch.length) return;
    await commitPending(); // finish any prior pending batch first
    const ids = new Set(batch.map((i) => i.id));
    items = items.filter((i) => !ids.has(i.id));
    batch.forEach((i) => selected.delete(i.id));
    render();
    let secs = 5;
    const label = () => { $('undo-text').textContent = `Moved ${batch.length} file${batch.length === 1 ? '' : 's'} to trash · undo (${secs}s)`; };
    label();
    ($('undo-btn') as HTMLButtonElement).hidden = false;
    $('undo-bar').hidden = false;
    const interval = window.setInterval(() => { secs--; if (secs >= 1) label(); }, 1000);
    const timer = window.setTimeout(() => { commitPending(); }, 5000);
    pendingDelete = { items: batch, timer, interval };
  }

  $('undo-btn').addEventListener('click', () => {
    if (!pendingDelete) return;
    clearTimeout(pendingDelete.timer);
    clearInterval(pendingDelete.interval);
    items = items.concat(pendingDelete.items);
    pendingDelete = null;
    $('undo-bar').hidden = true;
    render();
    toast('info', 'Restored');
  });

  async function loadThumb(card: HTMLElement) {
    const item = items.find((i) => i.id === card.dataset.id);
    if (!item || !item.thumbKey) return;
    try {
      const bytes = await client.getThumbnail(item, connFor(item));
      if (!bytes) return;
      const url = URL.createObjectURL(new Blob([bytes], { type: 'image/jpeg' }));
      thumbUrls.set(item.id, url);
      const el = card.querySelector<HTMLElement>('.tile-media');
      if (el) el.style.backgroundImage = `url(${url})`;
    } catch {}
  }
  function revokeThumbs() {
    for (const u of thumbUrls.values()) URL.revokeObjectURL(u);
    thumbUrls.clear();
  }

  async function toggleStar(item: VaultItem) {
    try { await client.setBookmark(item, !item.bookmarked); item.bookmarked = !item.bookmarked; render(); }
    catch { toast('error', 'Could not update bookmark'); }
  }
  function remove(item: VaultItem) {
    askDelete([item]); // confirm first, then soft-delete with 5s undo
  }

  // ── Viewer ────────────────────────────────────────────────────────────────────
  let viewerIdx = -1;
  let viewerUrl: string | null = null;
  const registeredStreams = new Set<string>();
  function clearViewerUrl() { if (viewerUrl) { URL.revokeObjectURL(viewerUrl); viewerUrl = null; } }

  function sw(): ServiceWorker | null {
    return ('serviceWorker' in navigator && navigator.serviceWorker.controller) || null;
  }
  function unregisterStreams() {
    const c = sw();
    if (c) for (const id of registeredStreams) c.postMessage({ type: 'mv-unregister-stream', id });
    registeredStreams.clear();
  }

  // Register an item with the SW so <video>/<audio> can stream seekable,
  // decrypted bytes from /__mv_stream/<id> (only the watched part is fetched).
  async function streamUrlFor(item: VaultItem): Promise<string | null> {
    const c = sw();
    if (!c) return null; // SW not controlling this load yet → fall back to full download
    try {
      const p = await client.getStreamParams(item, connFor(item));
      c.postMessage({
        type: 'mv-register-stream', id: item.id,
        config: p.config, objectKey: p.objectKey, fileKey: p.fileKey,
        chunkSize: p.header.chunkSize, baseNonce: p.header.baseNonce,
        plaintextSize: p.plaintextSize, mime: p.mime,
      });
      registeredStreams.add(item.id);
      return `/__mv_stream/${item.id}`;
    } catch {
      return null;
    }
  }

  async function openViewer(idx: number) {
    viewerIdx = idx;
    $('viewer').hidden = false;
    document.body.style.overflow = 'hidden';
    await renderViewer();
  }
  function closeViewer() {
    $('viewer').hidden = true;
    document.body.style.overflow = '';
    $('v-stage').innerHTML = '<div id="v-spin" class="v-spin">Decrypting…</div>';
    clearViewerUrl();
    unregisterStreams();
  }
  // Viewer caption: filename + type/size/date, with inline rename.
  function renderCaption(item: VaultItem) {
    const cap = $('v-caption');
    cap.innerHTML = '';
    const row = document.createElement('div');
    row.className = 'v-name-row';
    const name = document.createElement('span');
    name.className = 'v-name';
    name.textContent = item.metadata.name; // textContent — XSS-safe
    const dl = document.createElement('button');
    dl.className = 'v-icon-btn';
    dl.title = 'Download';
    dl.setAttribute('aria-label', 'Download');
    dl.textContent = '⬇';
    dl.addEventListener('click', async (e) => {
      e.stopPropagation();
      dl.disabled = true;
      try {
        const { bytes } = await client.download(item, connFor(item));
        const url = URL.createObjectURL(new Blob([bytes], { type: item.metadata.mime || 'application/octet-stream' }));
        const a = document.createElement('a');
        a.href = url; a.download = item.metadata.name;
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 10000);
      } catch (err) { toast('error', (err as Error).message || 'Download failed'); }
      finally { dl.disabled = false; }
    });
    const mv = document.createElement('button');
    mv.className = 'v-icon-btn';
    mv.title = 'Move to folder';
    mv.setAttribute('aria-label', 'Move to folder');
    mv.textContent = '🗂';
    mv.addEventListener('click', (e) => { e.stopPropagation(); enterMove(item); });
    const edit = document.createElement('button');
    edit.className = 'v-icon-btn';
    edit.title = 'Rename';
    edit.setAttribute('aria-label', 'Rename');
    edit.textContent = '✎';
    edit.addEventListener('click', (e) => { e.stopPropagation(); enterRename(item); });
    row.append(name, mv, dl, edit);
    const k = kind(item.metadata.mime);
    const meta = document.createElement('div');
    meta.className = 'v-meta';
    meta.textContent = `${k === 'file' ? 'FILE' : k.toUpperCase()} · ${fmtBytes(item.metadata.size)} · ${new Date(item.createdAt).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })}`;
    cap.append(row, meta);
  }
  function enterRename(item: VaultItem) {
    const cap = $('v-caption');
    cap.innerHTML = '';
    const wrap = document.createElement('div');
    wrap.className = 'v-name-edit';
    const input = document.createElement('input');
    input.className = 'v-name-input';
    input.value = item.metadata.name;
    input.setAttribute('aria-label', 'New file name');
    const save = document.createElement('button');
    save.className = 'v-icon-btn'; save.textContent = '✓'; save.title = 'Save';
    const cancel = document.createElement('button');
    cancel.className = 'v-icon-btn'; cancel.textContent = '✕'; cancel.title = 'Cancel';
    const doSave = async () => {
      const val = input.value.trim();
      if (!val || val === item.metadata.name) return renderCaption(item);
      save.disabled = true;
      try {
        await client.rename(item, val);
        renderCaption(item);
        render();               // reflect the new name in the grid tile
        toast('success', 'Renamed');
      } catch (err) { toast('error', (err as Error).message || 'Rename failed'); save.disabled = false; }
    };
    save.addEventListener('click', (e) => { e.stopPropagation(); doSave(); });
    cancel.addEventListener('click', (e) => { e.stopPropagation(); renderCaption(item); });
    input.addEventListener('click', (e) => e.stopPropagation());
    input.addEventListener('keydown', (e) => {
      e.stopPropagation();      // don't let the viewer's arrow/Escape nav fire while typing
      if (e.key === 'Enter') { e.preventDefault(); doSave(); }
      else if (e.key === 'Escape') renderCaption(item);
    });
    wrap.append(input, save, cancel);
    cap.appendChild(wrap);
    input.focus();
    input.select();
  }
  // Inline "move to folder" picker in the viewer caption.
  function enterMove(item: VaultItem) {
    const cap = $('v-caption');
    cap.innerHTML = '';
    const wrap = document.createElement('div');
    wrap.className = 'v-name-edit';
    const label = document.createElement('span'); label.className = 'v-meta'; label.textContent = 'Move to:';
    const sel = document.createElement('select');
    sel.className = 'v-name-input';
    sel.setAttribute('aria-label', 'Move to folder');
    const cur = folderOf(item);
    sel.add(new Option('Unfiled', '__unfiled', false, cur === null));
    for (const f of folders) sel.add(new Option(f.name, f.id, false, cur === f.id));
    sel.add(new Option('＋ New folder…', '__new'));
    const cancel = document.createElement('button');
    cancel.className = 'v-icon-btn'; cancel.textContent = '✕'; cancel.title = 'Cancel';
    cancel.addEventListener('click', (e) => { e.stopPropagation(); renderCaption(item); });
    sel.addEventListener('click', (e) => e.stopPropagation());
    sel.addEventListener('keydown', (e) => e.stopPropagation());
    sel.addEventListener('change', async () => {
      let target = sel.value;
      if (target === '__new') {
        const name = prompt('New folder name:')?.trim();
        if (!name) return renderCaption(item);
        try { const f = await client.createFolder(name); folders.push(f); target = f.id; }
        catch (err) { toast('error', (err as Error).message || 'Could not create folder'); return renderCaption(item); }
      }
      const folderId = target === '__unfiled' ? null : target;
      try {
        await client.moveToFolder(item, folderId);
        renderCaption(item);
        populateFolderSelect();
        render(); // it may leave the currently-filtered folder view
        toast('success', folderId ? `Moved to “${folderName(folderId)}”` : 'Moved to All files');
      } catch (err) { toast('error', (err as Error).message || 'Move failed'); renderCaption(item); }
    });
    wrap.append(label, sel, cancel);
    cap.appendChild(wrap);
    sel.focus();
  }
  async function renderViewer() {
    const item = visible[viewerIdx];
    if (!item) return;
    const stage = $('v-stage');
    stage.innerHTML = '<div class="v-spin">Decrypting…</div>';
    renderCaption(item);
    clearViewerUrl();
    const k = kind(item.metadata.mime);

    // Full download + decrypt — used for images, non-streamable types, and as a
    // fallback when Service-Worker streaming hiccups (provider range/CORS error).
    const playByDownload = async () => {
      const { bytes } = await client.download(item, connFor(item));
      const url = URL.createObjectURL(new Blob([bytes], { type: item.metadata.mime || 'application/octet-stream' }));
      viewerUrl = url;
      stage.innerHTML = '';
      const mime = (item.metadata.mime || '').toLowerCase();
      const downloadLink = () => {
        const link = document.createElement('a');
        link.href = url; link.download = item.metadata.name; link.className = 'btn-primary';
        link.textContent = `Download ${item.metadata.name}`;
        return link;
      };
      let el: HTMLElement;
      if (k === 'image') { const i = document.createElement('img'); i.src = url; i.className = 'v-media'; el = i; }
      else if (k === 'video') { const v = document.createElement('video'); v.src = url; v.controls = true; v.autoplay = true; v.className = 'v-media'; el = v; }
      else if (k === 'audio') { const a = document.createElement('audio'); a.src = url; a.controls = true; a.autoplay = true; el = a; }
      else if (mime === 'application/pdf') { const f = document.createElement('iframe'); f.src = url; f.className = 'v-doc-frame'; el = f; }
      else if (mime.startsWith('text/') || /json|xml|csv|markdown/.test(mime)) {
        const pre = document.createElement('pre'); pre.className = 'v-doc-text';
        pre.textContent = new TextDecoder().decode(bytes); // XSS-safe (textContent)
        el = pre;
      }
      else { el = downloadLink(); }
      stage.appendChild(el);
    };

    try {
      // Video & audio: stream via the Service Worker (seekable, no full download).
      if (k === 'video' || k === 'audio') {
        const streamUrl = await streamUrlFor(item);
        if (streamUrl) {
          stage.innerHTML = '';
          const el = document.createElement(k) as HTMLMediaElement;
          el.src = streamUrl;
          el.controls = true;
          el.autoplay = true;
          if (k === 'video') el.className = 'v-media';
          let fellBack = false;
          el.addEventListener('error', () => {
            if (fellBack) return;
            fellBack = true;
            stage.innerHTML = '<div class="v-spin">Buffering…</div>';
            playByDownload().catch((e) => {
              stage.innerHTML = `<div class="v-spin">Could not open: ${(e as Error).message}</div>`;
            });
          });
          stage.appendChild(el);
          return;
        }
      }
      await playByDownload();
    } catch (err) {
      stage.innerHTML = `<div class="v-spin">Could not open: ${(err as Error).message}</div>`;
    }
  }
  function step(d: number) {
    if (!visible.length) return;
    viewerIdx = (viewerIdx + d + visible.length) % visible.length;
    renderViewer();
  }
  $('v-close').addEventListener('click', closeViewer);
  $('v-prev').addEventListener('click', () => step(-1));
  $('v-next').addEventListener('click', () => step(1));
  $('viewer').addEventListener('click', (e) => { if (e.target === $('viewer')) closeViewer(); });
  document.addEventListener('keydown', (e) => {
    if ($('viewer').hidden) return;
    if (e.key === 'Escape') closeViewer();
    else if (e.key === 'ArrowLeft') step(-1);
    else if (e.key === 'ArrowRight') step(1);
  });

  // ── Upload (button + drag & drop) ───────────────────────────────────────────
  // ONE progress row, reused for every file: as each finishes, the same bar
  // advances to the next file (no stack of N rows for N files).
  async function uploadFiles(files: File[]) {
    if (!files.length || !connections.length) return;
    // Large files now stream (flat memory); just flag that very large ones take a while.
    const HUGE = 2 * 1024 * 1024 * 1024;
    const huge = files.filter((f) => f.size > HUGE).length;
    if (huge) toast('info', `${huge} very large file${huge === 1 ? '' : 's'} (over 2 GB) — encryption may take a few minutes; keep this tab open.`);
    const conn = connections[0];
    const panel = $('upload-status');
    $('empty').hidden = true; // don't show the dropzone behind the progress card
    panel.hidden = false;
    panel.innerHTML = `
      <div class="up-head"></div>
      <div class="up-row">
        <div class="up-row-top"><span class="up-name"></span><span class="up-stage"></span></div>
        <div class="up-track"><div class="up-fill"></div></div>
      </div>`;
    const head = panel.querySelector('.up-head') as HTMLElement;
    const row = panel.querySelector('.up-row') as HTMLElement;
    const nameEl = panel.querySelector('.up-name') as HTMLElement;
    const stageEl = panel.querySelector('.up-stage') as HTMLElement;
    const fillEl = panel.querySelector('.up-fill') as HTMLElement;

    let done = 0, failed = 0;
    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      // Reset the single row for this file.
      row.classList.remove('up-done', 'up-failed');
      nameEl.textContent = file.name;
      stageEl.textContent = 'Encrypting…';
      fillEl.style.width = '0%';
      head.textContent = files.length === 1 ? 'Uploading…' : `Uploading file ${i + 1} of ${files.length}`;

      try {
        const thumbnail = await makeThumbnail(file); // never blocks: times out → null
        // uploadFile streams large files (slice→encrypt→upload) so memory stays flat.
        await client.uploadFile(
          conn,
          { file, name: file.name, mime: file.type || 'application/octet-stream', thumbnail },
          (loaded: number, total: number) => {
            stageEl.textContent = `Uploading ${fmtBytes(loaded)} / ${fmtBytes(total)}`;
            fillEl.style.width = `${total ? Math.min(100, (loaded / total) * 100) : 0}%`;
          },
        );
        fillEl.style.width = '100%';
        row.classList.add('up-done');
        stageEl.textContent = 'Uploaded ✓';
        done++;
      } catch (err) {
        row.classList.add('up-failed');
        stageEl.textContent = (err as Error).message || 'failed';
        failed++;
        await sleep(1200); // let the user see which file failed before moving on
      }
    }

    head.textContent = failed ? `Done — ${done} uploaded, ${failed} failed` : `All ${done} uploaded ✓`;
    if (done) toast('success', `Uploaded ${done} file${done === 1 ? '' : 's'}`);
    if (failed) toast('error', `${failed} file${failed === 1 ? '' : 's'} failed`);
    await loadFirstPage();
    setTimeout(() => { panel.hidden = true; panel.innerHTML = ''; render(); }, failed ? 8000 : 2200);
  }
  function sleep(ms: number): Promise<void> { return new Promise((r) => setTimeout(r, ms)); }

  $('file-input').addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    const files = Array.from(input.files ?? []);
    input.value = '';
    $('upload-modal').hidden = true; // close the picker dialog if it was open
    uploadFiles(files);
  });

  // Empty-state dropzone (first run) → open the file picker directly.
  $('empty').addEventListener('click', () => ($('file-input') as HTMLInputElement).click());

  // Upload popup: opened from the toolbar button and the "upload more" link.
  const openUploadModal = () => { $('upload-modal').hidden = false; };
  $('upload-open').addEventListener('click', openUploadModal);
  $('upload-more').addEventListener('click', openUploadModal);
  $('upload-modal-close').addEventListener('click', () => { $('upload-modal').hidden = true; });
  $('upload-modal').addEventListener('click', (e) => { if (e.target === $('upload-modal')) $('upload-modal').hidden = true; });
  $('modal-dropzone').addEventListener('click', () => ($('file-input') as HTMLInputElement).click());
  // Drag & drop onto the modal dropzone.
  const mdz = $('modal-dropzone');
  ['dragenter', 'dragover'].forEach((ev) => mdz.addEventListener(ev, (e) => { e.preventDefault(); mdz.classList.add('drag-over'); }));
  mdz.addEventListener('dragleave', () => mdz.classList.remove('drag-over'));
  mdz.addEventListener('drop', (e) => {
    e.preventDefault();
    mdz.classList.remove('drag-over');
    $('upload-modal').hidden = true;
    uploadFiles(Array.from((e as DragEvent).dataTransfer?.files ?? []));
  });

  const vaultView = $('vault-view');
  const overlay = $('drop-overlay');
  let dragDepth = 0;
  ['dragenter', 'dragover'].forEach((ev) =>
    vaultView.addEventListener(ev, (e) => { e.preventDefault(); if (ev === 'dragenter') dragDepth++; overlay.hidden = false; }),
  );
  vaultView.addEventListener('dragleave', (e) => { e.preventDefault(); if (--dragDepth <= 0) { dragDepth = 0; overlay.hidden = true; } });
  vaultView.addEventListener('drop', (e) => {
    e.preventDefault();
    dragDepth = 0;
    overlay.hidden = true;
    uploadFiles(Array.from((e as DragEvent).dataTransfer?.files ?? []));
  });

  function showErr(id: string, err: unknown) {
    const el = $(id);
    const msg = (err as Error).message || String(err);
    const friendly: Record<string, string> = {
      invalid_credentials: 'Incorrect email or password.',
      rate_limited: 'Too many attempts. Try again in 15 minutes.',
      email_taken: 'An account with this email already exists.',
      unlock_failed: 'Incorrect password.',
      login_failed: 'Incorrect email or password.',
      twofa_invalid: 'That code is not valid. Enter the current 6-digit code or a backup code.',
      twofa_expired: 'That sign-in attempt expired. Please log in again.',
    };
    el.textContent = friendly[msg] ?? msg;
    el.hidden = false;
  }

  boot();
</script>

