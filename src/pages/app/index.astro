  .cat-tab { border: none; background: transparent; color: var(--text-muted); font: inherit; font-size: 13px; font-weight: 500; padding: 7px 16px; border-radius: 100px; cursor: pointer; transition: color .15s ease, background .15s ease; }
  .cat-tab:hover { color: var(--text-primary); }
  .cat-tab.active { background: var(--surface); color: var(--text-primary); box-shadow: var(--shadow-sm); }
  .sort-select { background: var(--surface); border: 1px solid var(--border-med); border-radius: 9px; padding: 8px 12px; font: inherit; font-size: 13px; color: var(--text-primary); cursor: pointer; }
  .fb-right { display: flex; align-items: center; gap: 8px; }
  .view-toggle { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; background: var(--surface); border: 1px solid var(--border-med); border-radius: 9px; color: var(--text-muted); cursor: pointer; }
  .view-toggle:hover { color: var(--text-primary); border-color: var(--border-strong, var(--border)); }
  .sort-select:focus { outline: none; border-color: var(--accent); }

  /* Undo banner */
  .undo-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; background: var(--text-primary); color: var(--bg); border-radius: 12px; padding: 11px 16px; margin-bottom: 16px; }
  .undo-text { font-size: 13px; font-weight: 500; }
  .undo-btn { color: var(--bg) !important; border: 1px solid color-mix(in srgb, var(--bg) 40%, transparent); }
  .undo-btn:hover { background: color-mix(in srgb, var(--bg) 15%, transparent) !important; }

  .more-bar { text-align: center; margin: 28px 0 8px; font-size: 13px; color: var(--text-muted); }
  .lib-status { display: inline-block; margin: 18px 0 8px; font-size: 12.5px; color: var(--text-muted); }
  .no-match { text-align: center; padding: 48px 0; }

  /* Empty-state dropzone */
  .dropzone { width: 100%; display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 56px 24px; margin: 8px 0; background: color-mix(in srgb, var(--surface) 70%, transparent); border: 2px dashed var(--border-strong, var(--border)); border-radius: 16px; cursor: pointer; font-family: inherit; transition: border-color .15s ease, background .15s ease; }
  .dropzone:hover, .dropzone.drag-over { border-color: var(--accent); background: var(--accent-subtle, rgba(59,130,246,0.08)); }
  .dropzone-icon { color: var(--accent); }
  .dropzone-title { font-size: 15px; font-weight: 600; color: var(--text-primary); }
  .dropzone-sub { font-size: 12.5px; color: var(--text-muted); max-width: 360px; text-align: center; line-height: 1.5; }

  .empty { text-align: center; padding: 60px 0; }
  .center { text-align: center; margin-top: 24px; }

  .drop-overlay { position: fixed; inset: 0; background: color-mix(in srgb, var(--accent) 16%, transparent); backdrop-filter: blur(2px); display: flex; align-items: center; justify-content: center; z-index: 40; }
  .drop-inner { border: 2px dashed var(--accent); border-radius: 16px; padding: 40px 56px; font-size: 18px; font-weight: 600; color: var(--text-primary); background: var(--surface); }

  .viewer { position: fixed; inset: 0; background: rgba(0,0,0,.92); z-index: 50; display: flex; align-items: center; justify-content: center; }
  .v-stage { max-width: 92vw; max-height: 82vh; display: flex; align-items: center; justify-content: center; }
  .v-close { position: absolute; top: 18px; right: 22px; background: none; border: none; color: #fff; font-size: 26px; cursor: pointer; line-height: 1; }
  .v-nav { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(255,255,255,.1); border: none; color: #fff; font-size: 34px; width: 52px; height: 52px; border-radius: 50%; cursor: pointer; }
  .v-prev { left: 20px; }
  .v-next { right: 20px; }
  .v-caption { position: absolute; bottom: 20px; left: 0; right: 0; text-align: center; color: #ddd; font-size: 13px; padding: 0 24px; }
  .v-name-row { display: inline-flex; align-items: center; gap: 8px; max-width: 100%; }
  .v-name { font-weight: 500; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 70vw; }
  .v-meta { margin-top: 4px; color: #9aa; font-size: 11.5px; letter-spacing: .02em; }
  .v-icon-btn { background: rgba(255,255,255,.12); border: none; color: #fff; width: 26px; height: 26px; border-radius: 50%; cursor: pointer; font-size: 13px; line-height: 1; display: inline-flex; align-items: center; justify-content: center; flex: none; }
  .v-icon-btn:hover { background: rgba(255,255,255,.22); }
  .v-icon-btn:disabled { opacity: .5; cursor: default; }
  .v-name-edit { display: inline-flex; align-items: center; gap: 8px; max-width: 100%; }
  .v-name-input { background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.3); border-radius: 8px; color: #fff; font: inherit; padding: 6px 10px; min-width: 220px; max-width: 60vw; }
  .v-name-input:focus { outline: none; border-color: rgba(255,255,255,.6); }
  @media (max-width: 600px) { .v-nav { width: 40px; height: 40px; font-size: 26px; } }
</style>

<!-- GLOBAL: these elements are created in JS (document.createElement), so Astro's
     scoped styles never reach them. Class names are app-specific (no leakage). -->
<style is:global>
  /* ── Gallery grid ─────────────────────────────────────────────────────────── */
  #grid.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 18px; }

  /* List view: reflow the same tiles into compact rows. Making .tile-media
     `position: static` re-anchors its absolute action buttons to the row. */
  #grid.list { display: flex; flex-direction: column; gap: 8px; }
  #grid.list .tile { display: flex; align-items: center; gap: 14px; padding: 8px 12px; border-radius: 12px; max-width: none; }
  #grid.list .tile:hover { transform: none; }
  #grid.list .tile-media { position: static; aspect-ratio: auto; width: 52px; height: 52px; flex: none; border-radius: 8px; }
  #grid.list .tile-foot { flex: 1; min-width: 0; padding: 0; padding-right: 84px; }
  #grid.list .tile-name { font-size: 14px; }
  #grid.list .tile-sub { margin-top: 2px; }
  #grid.list .tile-check, #grid.list .tile-type { display: none; }
  #grid.list .tile-play, #grid.list .tile-note { transform: scale(.62); }
  #grid.list .tile-doc::after { font-size: 24px; }
  #grid.list .tile-fav { top: 50%; right: 46px; bottom: auto; transform: translateY(-50%); }
  #grid.list .tile-del { top: 50%; right: 10px; bottom: auto; transform: translateY(-50%); }

  #grid .tile {
    position: relative; background: var(--surface); border: 1px solid var(--border);
    border-radius: 14px; overflow: hidden; cursor: pointer;
    transition: transform .18s cubic-bezier(.16,1,.3,1), box-shadow .18s ease, border-color .18s ease;
  }
  #grid .tile:hover { transform: translateY(-3px); border-color: var(--border-strong); box-shadow: var(--shadow-lg); }
  #grid .tile.selected { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent); }

  #grid .tile-media {
    position: relative; aspect-ratio: 1 / 1; background-size: cover; background-position: center;
    display: flex; align-items: center; justify-content: center;
  }
  #grid .tile-media.kind-image { background: var(--bg-inset); }
  #grid .tile-media.kind-video { background: linear-gradient(135deg, #1e293b, #0f172a); }
  #grid .tile-media.kind-audio { background: linear-gradient(135deg, #6d28d9, #4c1d95); }
  #grid .tile-media.kind-doc   { background: linear-gradient(135deg, #0ea5e9, #2563eb); }
  #grid .tile-media.kind-file  { background: linear-gradient(135deg, #0ea5e9, #2563eb); }
  #grid .tile-doc::after { content: '📄'; font-size: 40px; }

  /* Video play badge + audio note (centered) */
  #grid .tile-play { width: 48px; height: 48px; border-radius: 50%; background: rgba(0,0,0,.45); backdrop-filter: blur(3px); display: flex; align-items: center; justify-content: center; }
  #grid .tile-play::after { content: ''; width: 0; height: 0; border-left: 15px solid #fff; border-top: 9px solid transparent; border-bottom: 9px solid transparent; margin-left: 3px; }
  #grid .tile-note::after { content: '♪'; font-size: 42px; color: rgba(255,255,255,.92); }

  /* Type chip (bottom-left) */
  #grid .tile-type { position: absolute; bottom: 8px; left: 8px; font-family: 'JetBrains Mono', monospace; font-size: 9px; font-weight: 600; letter-spacing: .06em; color: #fff; background: rgba(0,0,0,.55); padding: 3px 7px; border-radius: 6px; backdrop-filter: blur(2px); }

  /* Favorite (top-right) */
  #grid .tile-fav { position: absolute; top: 8px; right: 8px; width: 30px; height: 30px; border-radius: 50%; border: none; background: rgba(0,0,0,.4); color: #fff; font-size: 15px; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity .15s ease, background .15s ease; backdrop-filter: blur(2px); }
  #grid .tile:hover .tile-fav { opacity: 1; }
  #grid .tile-fav.on { opacity: 1; color: #fbbf24; }
  #grid .tile-fav:hover { background: rgba(0,0,0,.65); }

  /* Selection checkbox (top-left) */
  #grid .tile-check { position: absolute; top: 8px; left: 8px; width: 22px; height: 22px; border-radius: 6px; border: 2px solid rgba(255,255,255,.85); background: rgba(0,0,0,.3); cursor: pointer; opacity: 0; transition: opacity .15s ease; padding: 0; }
  #grid .tile:hover .tile-check { opacity: 1; }
  #grid .tile.selected .tile-check { opacity: 1; background: var(--accent); border-color: var(--accent); }
  #grid .tile.selected .tile-check::after { content: '✓'; color: #fff; font-size: 13px; font-weight: 700; display: flex; align-items: center; justify-content: center; height: 100%; }

  /* Delete (bottom-right, hover) */
  #grid .tile-del { position: absolute; bottom: 8px; right: 8px; width: 30px; height: 30px; border-radius: 50%; border: none; background: rgba(0,0,0,.45); color: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity .15s ease, background .15s ease; backdrop-filter: blur(2px); }
  #grid .tile:hover .tile-del { opacity: 1; }
  #grid .tile-del:hover { background: #ef4444; }

  #grid .tile-foot { padding: 10px 12px; }
  #grid .tile-name { font-size: 13px; font-weight: 500; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; letter-spacing: -0.01em; }
  #grid .tile-sub { font-size: 11px; color: var(--text-muted); margin-top: 3px; text-transform: capitalize; }

  /* ── Upload progress card ─────────────────────────────────────────────────── */
  #upload-status { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 16px 18px; margin-bottom: 20px; box-shadow: var(--shadow-md); }
  #upload-status .up-head { font-size: 13.5px; font-weight: 600; color: var(--text-primary); margin-bottom: 14px; }
  #upload-status .up-list { display: flex; flex-direction: column; gap: 10px; max-height: 380px; overflow-y: auto; }
  #upload-status .up-row { background: var(--bg-inset); border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; }
  #upload-status .up-row-top { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 8px; font-size: 12.5px; }
  #upload-status .up-name { color: var(--text-primary); font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #upload-status .up-stage { color: var(--text-muted); font-family: 'JetBrains Mono', monospace; font-size: 11px; white-space: nowrap; }
  #upload-status .up-track { height: 6px; background: var(--bg); border-radius: 100px; overflow: hidden; }
  #upload-status .up-fill { height: 100%; width: 0%; border-radius: 100px; background: linear-gradient(90deg, var(--accent), #8b5cf6); transition: width .2s ease; }
  #upload-status .up-done .up-fill { background: var(--success, #00a854); }
  #upload-status .up-done .up-stage { color: var(--success, #00a854); }
  #upload-status .up-failed .up-fill { background: #ef4444; width: 100% !important; }
  #upload-status .up-failed .up-stage { color: #ef4444; }

  /* ── Viewer media (img/video/audio/doc injected into #v-stage) ────────────── */
  #v-stage .v-media { max-width: 92vw; max-height: 82vh; border-radius: 8px; }
  #v-stage .v-spin { color: #ccc; font-size: 14px; font-family: 'JetBrains Mono', monospace; }
  #v-stage .v-doc-frame { width: 90vw; height: 82vh; border: none; border-radius: 8px; background: #fff; }
  #v-stage .v-doc-text { max-width: 880px; width: 90vw; max-height: 82vh; overflow: auto; background: var(--surface); color: var(--text-primary); border-radius: 10px; padding: 24px; font-family: 'JetBrains Mono', monospace; font-size: 13px; line-height: 1.6; white-space: pre-wrap; word-break: break-word; text-align: left; }
</style>
