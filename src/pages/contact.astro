---
import PublicLayout from '../layouts/PublicLayout.astro';

const origin = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '') || Astro.url.origin;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contact MediaVault',
    url: origin + '/contact',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: origin + '/' },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: origin + '/contact' },
    ],
  },
];
---

<PublicLayout
  title="Contact MediaVault — Support, Feedback & Security Reports"
  description="Questions about MediaVault, end-to-end encrypted media storage, or a security issue to report? Reach the MediaVault team by email — we read everything."
  jsonLd={jsonLd}
>
  <section class="contact-page">
    <div class="container-sm">
      <header class="contact-header">
        <span class="page-eyebrow">Get In Touch</span>
        <h1 class="page-title">Contact Us.</h1>
        <p class="page-lead">
          Have a question, feedback, or need help with setting up MediaVault? Let us know.
        </p>
      </header>

      <div class="contact-card">
        <div class="contact-details">
          <h3>Official Mailbox</h3>
          <p class="email-desc">For all general inquiries, bug reports, or security reviews, send an email to:</p>
          <a href="mailto:fantasyfalcoon91@gmail.com" class="email-link">fantasyfalcoon91@gmail.com</a>
          <p class="meta-note">We aim to respond to all technical queries within 24 to 48 hours.</p>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>

<style>
  .container-sm {
    max-width: 640px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .contact-page {
    padding: 120px 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .contact-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .page-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--accent);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 12px;
  }

  .page-title {
    font-size: clamp(32px, 5vw, 44px);
    font-weight: 600;
    letter-spacing: -0.04em;
    color: var(--text-primary);
    line-height: 1.1;
    margin-bottom: 16px;
  }

  .page-lead {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-body);
  }

  .contact-card {
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 16px;
    padding: 40px 32px;
    box-shadow: var(--shadow-lg);
    text-align: center;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .contact-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-xl);
  }

  .contact-details h3 {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 12px;
  }

  .email-desc {
    font-size: 13.5px;
    color: var(--text-body);
    margin-bottom: 24px;
    line-height: 1.5;
  }

  .email-link {
    display: inline-block;
    font-size: clamp(20px, 4vw, 26px);
    font-weight: 600;
    color: var(--accent);
    text-decoration: underline;
    margin-bottom: 24px;
    word-break: break-all;
    transition: color 0.15s ease;
  }

  .email-link:hover {
    color: var(--accent-hover);
  }

  .meta-note {
    font-size: 12px;
    color: var(--text-muted);
    margin: 0;
  }
</style>
