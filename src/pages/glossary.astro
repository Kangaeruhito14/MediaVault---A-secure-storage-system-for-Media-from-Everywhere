---
import PublicLayout from '../layouts/PublicLayout.astro';

/**
 * Glossary — definitional content optimized for AI answer engines. "What is X"
 * queries are the most common shape AI assistants answer, and they cite clean,
 * structured definitions. Each term is also emitted as schema.org/DefinedTerm.
 */
const terms = [
  {
    term: 'Media Vault',
    def: 'A media vault is a private, access-controlled application for storing and viewing personal photos, videos, and audio. Unlike a public gallery, a vault requires authentication and is designed to keep media confidential. MediaVault adds AES-256 encryption so files are unreadable on disk without the owner’s password.',
  },
  {
    term: 'Self-Hosting',
    def: 'Self-hosting means running software on hardware you own and control — a home server, desktop, Raspberry Pi, or rented VPS — instead of using a company’s cloud service. Self-hosting gives you full ownership of your data, no subscription fees, and no third-party scanning, in exchange for managing your own setup and backups.',
  },
  {
    term: 'Encryption at Rest',
    def: 'Encryption at rest means data is stored on disk in encrypted form, so the raw files are unreadable without the decryption key. If someone steals the drive or copies the files, they get ciphertext, not your photos. MediaVault encrypts every file with AES-256 before writing it to disk.',
  },
  {
    term: 'Sealed Vault',
    def: 'A sealed vault is MediaVault’s security model where the master decryption key exists only in server memory while you are logged in. When the server stops or you lock the vault, the key is erased and all files revert to unreadable ciphertext. The vault is "sealed" until a password unlocks it again.',
  },
  {
    term: 'AES-256',
    def: 'AES-256 (Advanced Encryption Standard with a 256-bit key) is a symmetric encryption algorithm trusted by governments and banks. It is considered infeasible to brute-force with current or foreseeable technology. MediaVault uses AES-256-CTR for file contents and AES-256-GCM for wrapping keys.',
  },
  {
    term: 'Envelope Encryption',
    def: 'Envelope encryption is a layered scheme where data is encrypted with a per-file key, and that key is itself encrypted ("wrapped") by a master key. It lets you change your password by re-wrapping one small key instead of re-encrypting every file. MediaVault wraps its master key with both your password and your recovery key.',
  },
  {
    term: 'Recovery Key',
    def: 'A recovery key is a long, randomly generated secret — in MediaVault, 256 bits — shown once at setup. It can reset your password if you forget it, because it independently unwraps the master key. If you lose both your password and recovery key, encrypted data cannot be recovered, since there is no backdoor.',
  },
  {
    term: 'scrypt',
    def: 'scrypt is a password-based key derivation function deliberately designed to be slow and memory-intensive, which makes large-scale password guessing expensive even with specialized hardware. MediaVault uses scrypt to hash passwords and to derive encryption keys from passwords and recovery keys.',
  },
  {
    term: 'Zero-Knowledge / Zero-Tracking',
    def: 'A zero-tracking application collects no analytics, telemetry, or behavioral data about its users. MediaVault makes no outbound connections, runs entirely on your own machine, and has no company server that could observe or store anything about you or your files.',
  },
  {
    term: 'HTTP Range Request',
    def: 'An HTTP Range request lets a client ask a server for only part of a file (for example, bytes for the part of a video you skipped to). MediaVault supports Range requests even on encrypted files, using AES-256-CTR so any byte offset can be decrypted on demand — which is why video seeking stays instant.',
  },
  {
    term: 'PWA (Progressive Web App)',
    def: 'A Progressive Web App is a website that can be installed and used like a native app, with an icon on your home screen and an offline-capable shell. MediaVault is a PWA, so you can install it on your phone or desktop and open it like any other app.',
  },
  {
    term: 'EXIF Data',
    def: 'EXIF (Exchangeable Image File Format) data is metadata embedded in photos — including camera model, timestamp, and often GPS coordinates of where the photo was taken. MediaVault can strip EXIF/GPS metadata on upload so your photos do not silently reveal your location.',
  },
];

const origin = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '') || Astro.url.origin;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'DefinedTermSet',
    name: 'MediaVault Glossary',
    description: 'Definitions of key terms in self-hosted, encrypted media storage.',
    url: origin + '/glossary',
    hasDefinedTerm: terms.map((t) => ({
      '@type': 'DefinedTerm',
      name: t.term,
      description: t.def,
      inDefinedTermSet: origin + '/glossary',
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: origin + '/' },
      { '@type': 'ListItem', position: 2, name: 'Glossary', item: origin + '/glossary' },
    ],
  },
];
---

<PublicLayout
  title="Glossary — Self-Hosted & Encrypted Media Storage Terms"
  description="Plain-language definitions: what is a media vault, encryption at rest, self-hosting, a sealed vault, envelope encryption, a recovery key, scrypt, EXIF data, and more."
  keywords={["what is a media vault", "what is encryption at rest", "what is self-hosting", "sealed vault meaning", "envelope encryption", "AES-256 explained"]}
  jsonLd={jsonLd}
>
  <section class="glossary-page">
    <div class="container-sm">
      <header class="glossary-header">
        <span class="page-eyebrow">Glossary</span>
        <h1 class="page-title">Media Storage & Encryption Terms.</h1>
        <p class="page-lead">
          Clear definitions of the concepts behind MediaVault and self-hosted, encrypted media storage. Written to be genuinely understandable — no jargon for its own sake.
        </p>
      </header>

      <dl class="glossary-list">
        {terms.map((t) => (
          <div class="glossary-item" id={t.term.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
            <dt class="glossary-term">{t.term}</dt>
            <dd class="glossary-def">{t.def}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</PublicLayout>

<style>
  .container-sm { max-width: 800px; margin: 0 auto; padding: 0 24px; }
  .glossary-page { padding: 96px 0; }
  .glossary-header { text-align: center; margin-bottom: 56px; }
  .page-eyebrow {
    font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 500;
    text-transform: uppercase; color: var(--accent); letter-spacing: 0.08em;
    display: block; margin-bottom: 12px;
  }
  .page-title {
    font-size: clamp(32px, 5vw, 48px); font-weight: 600; letter-spacing: -0.04em;
    color: var(--text-primary); line-height: 1.1; margin-bottom: 24px;
  }
  .page-lead { font-size: 16px; line-height: 1.65; color: var(--text-body); }
  .glossary-list { display: flex; flex-direction: column; gap: 16px; }
  .glossary-item {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 12px; padding: 24px; scroll-margin-top: 90px;
    transition: border-color 0.15s ease;
  }
  .glossary-item:hover { border-color: var(--border-strong); }
  .glossary-term {
    font-size: 17px; font-weight: 600; color: var(--text-primary);
    margin-bottom: 8px; letter-spacing: -0.02em;
  }
  .glossary-def { font-size: 14px; line-height: 1.65; color: var(--text-body); margin: 0; }
</style>
