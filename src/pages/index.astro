---
import PublicLayout from '../layouts/PublicLayout.astro';

// Static CTAs — auth happens client-side in the /app area (E2EE).
const primaryCtaText = 'Get Started';
const primaryCtaPath = '/app';
const secondaryCtaText = 'How it works';
const secondaryCtaPath = '/about';

const origin = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '') || Astro.url.origin;

// Alternate names people actually search for — surfaced as schema.org alternateName
// so the same product can match many "media vault / store / locker / archive" queries.
const aliases = [
  'Media Reservoir', 'Media Vault', 'MediaVault', 'Open Media Vault',
  'Media Store', 'Media Storage', 'Media Repository', 'Media Archive',
  'Media Library', 'Media Locker', 'Media Safe', 'Media Reserve',
  'Media Cloud', 'Media Backup', 'Media Hub', 'Media Depot', 'Media Trove', 'Media Haven',
  'Asset Vault', 'Asset Reserve', 'Asset Haven', 'Asset Locker', 'Digital Asset Vault',
  'Photo Vault', 'Video Vault', 'Encrypted Media Vault', 'Encrypted Photo Vault',
  'Secure Media Storage', 'Private Media Library', 'Zero-Knowledge Vault',
  'Encrypted Cloud Storage', 'Private Cloud Storage',
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Media Reservoir',
    alternateName: aliases,
    url: origin,
    description:
      'Free, open-source, end-to-end encrypted vault — a private Google Photos & cloud-drive alternative that encrypts photos, videos, audio, PDFs, and documents in your browser and stores them in cloud storage you own.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Media Reservoir',
    alternateName: aliases,
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any modern web browser',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description:
      'End-to-end encrypted vault for photos, videos, audio, PDFs, and documents. Files are encrypted in the browser and stored in your own S3-compatible cloud; the operator can never read them. Includes seekable encrypted streaming, in-app document/PDF viewing, and recovery-key reset.',
    featureList: [
      'End-to-end encryption — keys never leave your device',
      'Bring your own storage (Cloudflare R2, Backblaze B2, Wasabi, S3)',
      'Zero-knowledge: the operator stores only ciphertext',
      'Seekable encrypted video & audio streaming',
      'Encrypted thumbnails for fast galleries',
      'Recovery-key password reset; multi-device; installable PWA',
    ],
    url: origin,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Media Reservoir',
    alternateName: aliases,
    url: origin,
    logo: origin + '/og-image.png',
    description:
      'Free, open-source, end-to-end encrypted media vault — a private alternative to Google Photos that stores your files in storage you own.',
    sameAs: [
      'https://github.com/Kangaeruhito14/MediaVault---A-secure-storage-system-for-Media-from-Everywhere',
    ],
  },
];
---

<PublicLayout
  title="Media Reservoir — End-to-End Encrypted Media, on Storage You Own"
  description="Media Reservoir encrypts your photos, videos, audio, PDFs, and documents in your browser, then stores them in your own cloud (Cloudflare R2, Backblaze B2, Wasabi, S3). The keys never leave your device — so not even we can read your files. Free, open-source, multi-device."
  jsonLd={jsonLd}
>

  <!-- ── HERO SECTION ── -->
  <section class="hero-section mesh-gradient">
    <!-- Atmospheric Blurred Orbs for Premium Depth -->
    <div class="glow-orb orb-1"></div>
    <div class="glow-orb orb-2"></div>

    <div class="section-container hero-container">
      <!-- Eyebrow Pill -->
      <div class="eyebrow-pill" data-reveal>
        <span class="mono-badge">END-TO-END ENCRYPTED · YOUR STORAGE · ZERO KNOWLEDGE</span>
      </div>

      <!-- Headline -->
      <h1 class="hero-title" data-reveal data-reveal-delay="60">
        Your media, locked before<br class="hero-br" /> it leaves your device.
      </h1>

      <!-- Description -->
      <p class="hero-description" data-reveal data-reveal-delay="120">
        Media Reservoir encrypts your photos, videos, audio and documents right in your browser —
        then hands the sealed files to a cloud bucket <strong>you own</strong>. The keys never touch
        our servers, so no one else can open them. Not advertisers. Not hackers.
        <strong>Not even us.</strong>
      </p>

      <!-- Action Button Row -->
      <div class="cta-row" data-reveal data-reveal-delay="180">
        <a href={primaryCtaPath} class="btn-primary-hero">
          {primaryCtaText}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href={secondaryCtaPath} class="btn-secondary-hero">
          {secondaryCtaText}
        </a>
      </div>

      <!-- Floating App Mockup — 3D tilt reacts to scroll + pointer -->
      <div class="mockup-stage" data-reveal data-reveal-delay="240">
        <div class="mockup-glow"></div>
        <div class="mockup-frame">
        <div class="mockup-header">
          <div class="mockup-dots">
            <span class="dot-red"></span>
            <span class="dot-yellow"></span>
            <span class="dot-green"></span>
          </div>
          <div class="mockup-address">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span>your encrypted vault</span>
          </div>
          <div class="mockup-spacer"></div>
        </div>
        
        <!-- Inside Mockup: Media vault layout representation -->
        <div class="mockup-body">
          <div class="mockup-sidebar">
            <div class="sidebar-item active">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2.5h8a2 2 0 0 1 2 2V18a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
              All Media
            </div>
            <div class="sidebar-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 17l-5.2 2.6 1-5.8-4.3-4.1 5.9-.9z"/></svg>
              Bookmarks
            </div>
            <div class="sidebar-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="m4 17 5-5 4 4 3-3 4 4"/></svg>
              Images
            </div>
            <div class="sidebar-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="5.5" width="14" height="13" rx="2.5"/><path d="m16.5 9.5 5-2.5v10l-5-2.5z"/></svg>
              Videos
            </div>
            <div class="sidebar-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V6l10-2v11"/><circle cx="6" cy="18" r="3"/><circle cx="16" cy="15" r="3"/></svg>
              Audio
            </div>
          </div>
          <div class="mockup-content">
            <div class="mockup-toolbar">
              <div class="mockup-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/></svg>
                Search media…
              </div>
              <div class="mockup-upload">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                Upload
              </div>
            </div>
            <div class="mockup-grid">
              <div class="mockup-card">
                <div class="card-thumb thumb-a"><span class="thumb-lock"></span></div>
                <div class="card-info"><div class="card-title">sunset.jpg</div><div class="card-meta">1.2 MB</div></div>
              </div>
              <div class="mockup-card">
                <div class="card-thumb thumb-b"><span class="thumb-play"></span><span class="thumb-lock"></span></div>
                <div class="card-info"><div class="card-title">travel_vlog.mp4</div><div class="card-meta">18.4 MB</div></div>
              </div>
              <div class="mockup-card">
                <div class="card-thumb thumb-c"><span class="thumb-wave"></span><span class="thumb-lock"></span></div>
                <div class="card-info"><div class="card-title">live_set.mp3</div><div class="card-meta">4.1 MB</div></div>
              </div>
              <div class="mockup-card">
                <div class="card-thumb thumb-d"><span class="thumb-lock"></span></div>
                <div class="card-info"><div class="card-title">portrait.png</div><div class="card-meta">2.8 MB</div></div>
              </div>
              <div class="mockup-card">
                <div class="card-thumb thumb-e"><span class="thumb-play"></span><span class="thumb-lock"></span></div>
                <div class="card-info"><div class="card-title">birthday.mov</div><div class="card-meta">31.2 MB</div></div>
              </div>
              <div class="mockup-card">
                <div class="card-thumb thumb-f"><span class="thumb-lock"></span></div>
                <div class="card-info"><div class="card-title">mountains.jpg</div><div class="card-meta">3.5 MB</div></div>
              </div>
            </div>
          </div>
        </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── STATS SECTION ── -->
  <section class="stats-section">
    <div class="section-container stats-grid">
      <div class="stat-card" data-reveal>
        <div class="stat-num">0</div>
        <p class="stat-label">Files we can read. Your keys never leave your device.</p>
      </div>
      <div class="stat-card" data-reveal data-reveal-delay="80">
        <div class="stat-num">100%</div>
        <p class="stat-label">End-to-end encrypted — before anything is uploaded.</p>
      </div>
      <div class="stat-card" data-reveal data-reveal-delay="160">
        <div class="stat-num">&infin;</div>
        <p class="stat-label">Bring your own storage — any S3-compatible cloud.</p>
      </div>
    </div>
  </section>

  <!-- ── ENCRYPTION FLOW (animated centerpiece) ── -->
  <section class="flow-section">
    <div class="section-container">
      <div class="section-header" data-reveal>
        <span class="section-eyebrow">Zero-knowledge by design</span>
        <h2 class="section-title">Sealed before we ever touch it.</h2>
        <p class="section-lead">Encryption happens on your device. Everything downstream — the network, our servers, your cloud — only ever handles ciphertext. There is nothing for us to read, leak, or hand over.</p>
      </div>

      <div class="flow-diagram" data-reveal data-reveal-delay="80">
        <div class="flow-node">
          <div class="flow-icon flow-device">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><circle cx="8.5" cy="9" r="1.4"/><path d="m4 15 4.5-4 3.5 3 3-2.5 4 3.5"/></svg>
          </div>
          <div class="flow-label">Your device</div>
          <div class="flow-sub">The original file</div>
        </div>

        <div class="flow-link"><span class="flow-dot"></span><span class="flow-dot"></span><span class="flow-dot"></span></div>

        <div class="flow-node flow-node-hl">
          <div class="flow-icon flow-lock">
            <span class="flow-pulse"></span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4.5" y="11" width="15" height="9.5" rx="2.2"/><path d="M8 11V7.5a4 4 0 0 1 8 0V11"/><circle cx="12" cy="15.5" r="1.4"/></svg>
          </div>
          <div class="flow-label">Encrypted in your browser</div>
          <div class="flow-sub">AES-256 · your key never leaves</div>
        </div>

        <div class="flow-link flow-link-cipher"><span class="flow-dot"></span><span class="flow-dot"></span><span class="flow-dot"></span></div>

        <div class="flow-node">
          <div class="flow-icon flow-cloud">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19a4.5 4.5 0 0 0 .8-8.93A6 6 0 0 0 6.6 9.2 4 4 0 0 0 6.5 19z"/></svg>
          </div>
          <div class="flow-label">Your cloud bucket</div>
          <div class="flow-sub">Ciphertext, in storage you own</div>
        </div>
      </div>

      <div class="flow-callout" data-reveal data-reveal-delay="160">
        <span class="flow-callout-dot"></span>
        <span class="flow-callout-label">All our servers ever see:</span>
        <code class="flow-cipher" id="flow-cipher">a3f9c1e08b2d47…</code>
      </div>
    </div>
  </section>

  <!-- ── FEATURES GRID ── -->
  <section class="features-section">
    <div class="section-container">
      <div class="section-header" data-reveal>
        <span class="section-eyebrow">How it protects you</span>
        <h2 class="section-title">Private by architecture, not by promise.</h2>
      </div>

      <div class="features-grid">
        <!-- Feature 1 -->
        <div class="feature-card" data-reveal>
          <div class="feature-icon feat-a">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><rect x="9.5" y="11" width="5" height="4.5" rx="1"/><path d="M10.25 11V9.5a1.75 1.75 0 0 1 3.5 0V11"/></svg>
          </div>
          <h3 class="feature-name">End-to-end encrypted</h3>
          <p class="feature-desc">Every file is sealed in your browser with AES-256 before it's uploaded. We only ever hold ciphertext we cannot read.</p>
        </div>
        <!-- Feature 2 -->
        <div class="feature-card" data-reveal data-reveal-delay="60">
          <div class="feature-icon feat-b">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19a4.5 4.5 0 0 0 .8-8.93A6 6 0 0 0 6.6 9.2 4 4 0 0 0 6.5 19z"/><path d="M12 12.5v4"/><path d="m10 14.5 2-2 2 2"/></svg>
          </div>
          <h3 class="feature-name">Your own storage</h3>
          <p class="feature-desc">Connect your own Cloudflare R2, Backblaze B2, Wasabi, Dropbox, or S3 bucket. Files live in your account — never on our servers.</p>
        </div>
        <!-- Feature 3 -->
        <div class="feature-card" data-reveal data-reveal-delay="120">
          <div class="feature-icon feat-c">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4.5 13H11l-1 9 8.5-11H12z"/></svg>
          </div>
          <h3 class="feature-name">Seekable streaming</h3>
          <p class="feature-desc">Range-based decryption reads only the slice you're watching, so you can jump anywhere in a multi-GB video instantly.</p>
        </div>
        <!-- Feature 4 -->
        <div class="feature-card" data-reveal>
          <div class="feature-icon feat-d">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2.5"/><circle cx="8.5" cy="9.5" r="1.6"/><path d="m4 18 5-5 4 4 3-3 4 4"/></svg>
          </div>
          <h3 class="feature-name">Encrypted thumbnails</h3>
          <p class="feature-desc">Previews are generated and encrypted in your browser, so galleries load fast without ever downloading the full files.</p>
        </div>
        <!-- Feature 5 -->
        <div class="feature-card" data-reveal data-reveal-delay="60">
          <div class="feature-icon feat-e">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="15.5" r="4"/><path d="m10.4 12.6 8.1-8.1 2 2-1.8 1.8-1.7-1.7M16.9 8.9l-2 2"/></svg>
          </div>
          <h3 class="feature-name">Recovery key</h3>
          <p class="feature-desc">Forgot your password? A one-time recovery key restores access. Lose both and not even we can help — that's the whole point.</p>
        </div>
        <!-- Feature 6 -->
        <div class="feature-card" data-reveal data-reveal-delay="120">
          <div class="feature-icon feat-f">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4" width="14" height="10" rx="1.5"/><path d="M2.5 17.5h14"/><rect x="18" y="9" width="4" height="11" rx="1.2"/></svg>
          </div>
          <h3 class="feature-name">Every device</h3>
          <p class="feature-desc">Sign in from any device; your library syncs through a tiny encrypted index. Installable as an app (PWA) on phone and desktop.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── WORKFLOW / HOW IT WORKS ── -->
  <section class="workflow-section">
    <div class="section-container">
      <div class="section-header" data-reveal>
        <span class="section-eyebrow">Quick Start</span>
        <h2 class="section-title">Three steps to a private library.</h2>
      </div>

      <div class="workflow-steps">
        <div class="workflow-step" data-reveal>
          <div class="step-badge">1</div>
          <h3 class="step-title">Create your account</h3>
          <p class="step-desc">Sign up — your password derives your encryption key right in the browser. Save your one-time recovery key.</p>
        </div>
        <div class="workflow-step" data-reveal data-reveal-delay="80">
          <div class="step-badge">2</div>
          <h3 class="step-title">Connect your storage</h3>
          <p class="step-desc">Link your own cloud bucket (R2, Backblaze B2, Wasabi, S3). Files go straight there — never through us.</p>
        </div>
        <div class="workflow-step" data-reveal data-reveal-delay="160">
          <div class="step-badge">3</div>
          <h3 class="step-title">Upload &amp; enjoy</h3>
          <p class="step-desc">Drag in photos and videos — encrypted locally, then streamed, searched, and viewed across all your devices.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── "CALL IT WHAT YOU LIKE" (readable synonym coverage for search) ── -->
  <section class="aka-section">
    <div class="section-container aka-inner" data-reveal>
      <span class="aka-eyebrow">Call it what you like</span>
      <p class="aka-text">
        An <strong>encrypted photo vault</strong>. A <strong>private media library</strong>. A
        <strong>zero-knowledge asset locker</strong>. A <strong>secure media store</strong> on cloud
        you own. A <strong>Google Photos alternative</strong> that genuinely can't read your files.
        However you found it — that's <strong>Media Reservoir</strong>.
      </p>
    </div>
  </section>

  <!-- ── CTA BANNER ── -->
  <section class="cta-banner-section">
    <div class="section-container cta-banner-container" data-reveal>
      <h2 class="cta-banner-title">Take back your memories.</h2>
      <p class="cta-banner-desc">Free, open-source, end-to-end encrypted. Your media, your cloud, your keys — not the tech giants'.</p>
      <div class="cta-banner-actions">
        <a href={primaryCtaPath} class="btn-primary-hero invert">
          {primaryCtaText}
        </a>
      </div>
    </div>
  </section>

</PublicLayout>

<script>
  // Hero mockup 3D tilt: rotateX eases from tilted → flat as it scrolls into
  // view, plus a gentle pointer parallax. Disabled for reduced-motion and on
  // small/touch screens. Re-inits after each View Transition (astro:page-load).
  function initHeroMockup() {
    const stage = document.querySelector<HTMLElement>('.mockup-stage');
    const frame = document.querySelector<HTMLElement>('.mockup-frame');
    if (!stage || !frame) return;

    // Clean up any previous instance (page-load fires again after transitions).
    (window as any).__heroTiltCleanup?.();

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || window.innerWidth < 700) {
      frame.style.transform = 'rotateX(6deg) scale(0.98)';
      return;
    }

    let base = 14; // scroll-driven rotateX (deg)
    let rx = 0, ry = 0; // pointer offsets (deg)
    let raf = 0;

    const render = () => {
      frame.style.transform =
        `rotateX(${(base + rx).toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) scale(0.97)`;
    };
    const onScroll = () => {
      const r = stage.getBoundingClientRect();
      const vh = window.innerHeight || 1;
      const p = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.9)));
      base = 14 - p * 13; // 14deg → ~1deg as it rises
      if (!raf) raf = requestAnimationFrame(() => { raf = 0; render(); });
    };
    const onMove = (e: MouseEvent) => {
      const r = stage.getBoundingClientRect();
      ry = ((e.clientX - (r.left + r.width / 2)) / r.width) * 9;
      rx = -((e.clientY - (r.top + r.height / 2)) / r.height) * 5;
      if (!raf) raf = requestAnimationFrame(() => { raf = 0; render(); });
    };
    const onLeave = () => { rx = 0; ry = 0; render(); };

    window.addEventListener('scroll', onScroll, { passive: true });
    stage.addEventListener('mousemove', onMove);
    stage.addEventListener('mouseleave', onLeave);
    (window as any).__heroTiltCleanup = () => {
      window.removeEventListener('scroll', onScroll);
      stage.removeEventListener('mousemove', onMove);
      stage.removeEventListener('mouseleave', onLeave);
    };
    onScroll();
  }
  // Live "ciphertext" scramble in the encryption-flow callout — cycles hex while
  // in view for a sense of active encryption. Paused off-screen + for reduced-motion.
  function initCipherScramble() {
    const el = document.getElementById('flow-cipher');
    if (!el) return;
    (window as any).__cipherCleanup?.();
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const hex = '0123456789abcdef';
    let timer = 0;
    const tick = () => {
      let s = '';
      for (let i = 0; i < 12; i++) s += hex[(Math.random() * 16) | 0];
      el.textContent = s + '…';
    };
    const io = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting && !timer) timer = window.setInterval(tick, 90);
      else if (!entries[0].isIntersecting && timer) { clearInterval(timer); timer = 0; }
    }, { threshold: 0.25 });
    io.observe(el);
    (window as any).__cipherCleanup = () => { if (timer) clearInterval(timer); io.disconnect(); };
  }

  function initHomeMotion() { initHeroMockup(); initCipherScramble(); }
  document.addEventListener('astro:page-load', initHomeMotion);
</script>

<style>
  /* Base Layout Container */
  .section-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 2;
  }

  /* ── HERO ── */
  .hero-section {
    position: relative;
    padding: 128px 0 96px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  /* Subtle dot grid, faded out toward the edges for depth. */
  .hero-section::before {
    content: '';
