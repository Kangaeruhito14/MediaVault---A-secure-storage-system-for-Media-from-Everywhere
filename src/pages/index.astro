---
import PublicLayout from '../layouts/PublicLayout.astro';
import { isAuthenticated, isPasswordSet } from '../lib/auth';

const authed = isAuthenticated(Astro.request);
const passwordSet = isPasswordSet();

let primaryCtaText = 'Get Started';
let primaryCtaPath = '/login';
let secondaryCtaText = 'How it works';
let secondaryCtaPath = '/about';

if (authed) {
  primaryCtaText = 'Access Vault';
  primaryCtaPath = '/vault';
} else if (!passwordSet) {
  primaryCtaText = 'Set Up Vault';
  primaryCtaPath = '/login?setup=1';
}

const origin = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '') || Astro.url.origin;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'MediaVault',
    url: origin,
    description:
      'Free, self-hosted, encrypted media vault — a private Google Photos alternative that stores photos, videos, and audio on your own hardware.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'MediaVault',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Linux, macOS, Windows (Node.js 22+)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description:
      'Self-hosted encrypted photo, video, and audio vault with AES-256 sealed-at-rest encryption, recovery-key reset, and streaming playback.',
    featureList: [
      'AES-256 encryption at rest (sealed vault)',
      'Self-hosted — your hardware, your data',
      'Encrypted video & audio streaming with seeking',
      'Recovery-key password reset',
      'Drag & drop uploads up to 5 GB per file',
      'Dark & light themes, responsive on all devices',
    ],
    url: origin,
  },
];
---

<PublicLayout
  title="MediaVault — Free Self-Hosted Encrypted Photo & Video Vault"
  description="Store private photos, videos, and audio on your own hardware with AES-256 sealed-at-rest encryption. MediaVault is the free, open-source, self-hosted Google Photos alternative that cannot read your files."
  jsonLd={jsonLd}
>
  
  <!-- ── HERO SECTION ── -->
  <section class="hero-section mesh-gradient">
    <!-- Atmospheric Blurred Orbs for Premium Depth -->
    <div class="glow-orb orb-1"></div>
    <div class="glow-orb orb-2"></div>
    
    <div class="section-container hero-container">
      <!-- Eyebrow Pill -->
      <div class="eyebrow-pill" data-aos="fade-up">
        <span class="mono-badge">SECURE · LOCAL · ZERO TRACKING</span>
      </div>

      <!-- Headline -->
      <h1 class="hero-title" data-aos="fade-up">
        Your personal media vault.
      </h1>

      <!-- Description -->
      <p class="hero-description" data-aos="fade-up">
        A premium, self-hosted space for your images, videos, and audio files. 
        Zero third-party analytics, zero cloud leaks. Just pure, secure ownership of your memories.
      </p>

      <!-- Action Button Row -->
      <div class="cta-row" data-aos="fade-up">
        <a href={primaryCtaPath} class="btn-primary-hero">
          {primaryCtaText}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href={secondaryCtaPath} class="btn-secondary-hero">
          {secondaryCtaText}
        </a>
      </div>

      <!-- Floating App Mockup (Visual wow factor) -->
      <div class="mockup-frame" data-aos="fade-up">
        <div class="mockup-header">
          <div class="mockup-dots">
            <span class="dot-red"></span>
            <span class="dot-yellow"></span>
            <span class="dot-green"></span>
          </div>
          <div class="mockup-address">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span>localhost:4321/vault</span>
          </div>
          <div class="mockup-spacer"></div>
        </div>
        
        <!-- Inside Mockup: Media vault layout representation -->
        <div class="mockup-body">
          <div class="mockup-sidebar">
            <div class="sidebar-item active">📂 All Media</div>
            <div class="sidebar-item">⭐ Bookmarks</div>
            <div class="sidebar-item">🖼️ Images</div>
            <div class="sidebar-item">🎥 Videos</div>
            <div class="sidebar-item">🎵 Audio</div>
          </div>
          <div class="mockup-content">
            <div class="mockup-toolbar">
              <div class="mockup-search">🔍 Search media...</div>
              <div class="mockup-upload">+ Upload File</div>
            </div>
            <div class="mockup-grid">
              <!-- Card 1 -->
              <div class="mockup-card">
                <div class="card-thumb image-thumb">
                  <span>🏔️ sunset.jpg</span>
                </div>
                <div class="card-info">
                  <div class="card-title">sunset.jpg</div>
                  <div class="card-meta">1.2 MB</div>
                </div>
              </div>
              <!-- Card 2 -->
              <div class="mockup-card">
                <div class="card-thumb video-thumb">
                  <span>🎥 travel_vlog.mp4</span>
                </div>
                <div class="card-info">
                  <div class="card-title">travel_vlog.mp4</div>
                  <div class="card-meta">18.4 MB</div>
                </div>
              </div>
              <!-- Card 3 -->
              <div class="mockup-card">
                <div class="card-thumb audio-thumb">
                  <span>🎵 background_track.mp3</span>
                </div>
                <div class="card-info">
                  <div class="card-title">background_track.mp3</div>
                  <div class="card-meta">4.1 MB</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── STATS SECTION ── -->
  <section class="stats-section">
    <div class="section-container stats-grid">
      <div class="stat-card">
        <h3 class="stat-num">0</h3>
        <p class="stat-label">Cloud database dependency. Fully local storage.</p>
      </div>
      <div class="stat-card">
        <h3 class="stat-num">100%</h3>
        <p class="stat-label">Privacy standard. No external tracking scripts.</p>
      </div>
      <div class="stat-card">
        <h3 class="stat-num">&infin;</h3>
        <p class="stat-label">Media formats supported. Clean previews instantly.</p>
      </div>
    </div>
  </section>

  <!-- ── FEATURES GRID ── -->
  <section class="features-section">
    <div class="section-container">
      <div class="section-header">
        <span class="section-eyebrow">Enterprise Grade</span>
        <h2 class="section-title">Designed for privacy, built for speed.</h2>
      </div>

      <div class="features-grid">
        <!-- Feature 1 -->
        <div class="feature-card">
          <div class="feature-icon">🔒</div>
          <h3 class="feature-name">Local Authentication</h3>
          <p class="feature-desc">Protected by cryptographically hashed passwords and a physical recovery key you print or save locally.</p>
        </div>
        <!-- Feature 2 -->
        <div class="feature-card">
          <div class="feature-icon">⚡</div>
          <h3 class="feature-name">Instant Streams</h3>
          <p class="feature-desc">Integrated partial byte-range streaming. Skip forward instantly in heavy HD videos or high-res audio tracks.</p>
        </div>
        <!-- Feature 3 -->
        <div class="feature-card">
          <div class="feature-icon">📁</div>
          <h3 class="feature-name">Universal Files</h3>
          <p class="feature-desc">Accepts all standard media types. Easily view metadata, download original copies, or delete with undo support.</p>
        </div>
        <!-- Feature 4 -->
        <div class="feature-card">
          <div class="feature-icon">🎨</div>
          <h3 class="feature-name">Aesthetic Control</h3>
          <p class="feature-desc">Stunning responsive layout with micro-animations, glassmorphism filters, and a dark/light mode toggle.</p>
        </div>
        <!-- Feature 5 -->
        <div class="feature-card">
          <div class="feature-icon">🔄</div>
          <h3 class="feature-name">Smooth Sorting</h3>
          <p class="feature-desc">Sort by size, date added, file names, or filter by specific media categories instantly with zero page reloads.</p>
        </div>
        <!-- Feature 6 -->
        <div class="feature-card">
          <div class="feature-icon">🌐</div>
          <h3 class="feature-name">Self-Hosted</h3>
          <p class="feature-desc">Runs entirely on Node.js inside Astro. You deploy it on your local network, your VPS, or behind your home router.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── WORKFLOW / HOW IT WORKS ── -->
  <section class="workflow-section">
    <div class="section-container">
      <div class="section-header">
        <span class="section-eyebrow">Quick Start</span>
        <h2 class="section-title">Three steps to peace of mind.</h2>
      </div>

      <div class="workflow-steps">
        <div class="workflow-step">
          <div class="step-badge">1</div>
          <h3 class="step-title">Initialize Password</h3>
          <p class="step-desc">Establish your master password. Print or download your secure recovery key in case you lose it.</p>
        </div>
        <div class="workflow-step">
          <div class="step-badge">2</div>
          <h3 class="step-title">Upload Media</h3>
          <p class="step-desc">Drag and drop images, video clips, or audio files into the drag-zone. Uploads stream directly to local disk.</p>
        </div>
        <div class="workflow-step">
          <div class="step-badge">3</div>
          <h3 class="step-title">Organize & Enjoy</h3>
          <p class="step-desc">Bookmark favorites, filter by type, play audio files inline, and inspect media details inside clean dialog drawers.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA BANNER ── -->
  <section class="cta-banner-section">
    <div class="section-container cta-banner-container">
      <h2 class="cta-banner-title">Start protecting your media today.</h2>
      <p class="cta-banner-desc">Take back control of your photos, home videos, and recordings from tech giants.</p>
      <div class="cta-banner-actions">
        <a href={primaryCtaPath} class="btn-primary-hero invert">
          {primaryCtaText}
        </a>
      </div>
    </div>
  </section>

</PublicLayout>

<style>
  /* Base Layout Container */
  .section-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 2;
  }

  /* ── HERO ── */
  .hero-section {
    position: relative;
    padding: 128px 0 96px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.15;
    z-index: 1;
    pointer-events: none;
  }

  .orb-1 {
    top: -10%;
    left: 10%;
    width: 400px;
    height: 400px;
    background: #0070f3;
  }

  .orb-2 {
    bottom: 5%;
    right: 10%;
    width: 350px;
    height: 350px;
    background: #eb367f;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow-pill {
    margin-bottom: 24px;
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mono-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    background: var(--bg-inset);
    border: 1px solid var(--border);
    padding: 6px 16px;
    border-radius: 100px;
    letter-spacing: 0.08em;
  }

  .hero-title {
    font-size: clamp(38px, 6vw, 64px);
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.04em;
    line-height: 1.05;
    max-width: 800px;
    margin-bottom: 24px;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-description {
    font-size: clamp(16px, 2.5vw, 19px);
    color: var(--text-body);
    line-height: 1.6;
    max-width: 620px;
    margin-bottom: 40px;
    animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-row {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-bottom: 72px;
    animation: fadeInUp 1.1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (max-width: 480px) {
    .cta-row {
      flex-direction: column;
      width: 100%;
    }
  }

  .btn-primary-hero {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 48px;
    padding: 0 28px;
    border-radius: 100px;
    font-size: 15px;
    font-weight: 500;
    background: var(--text-primary);
    color: var(--bg);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
    transition: all 0.2s ease;
  }

  .btn-primary-hero:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
    opacity: 0.95;
  }

  .btn-primary-hero.invert {
    background: var(--bg);
    color: var(--text-primary);
  }

  .btn-primary-hero.invert:hover {
    background: var(--surface);
  }

  .btn-primary-hero:active {
    transform: translateY(0);
  }

  .btn-secondary-hero {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 28px;
    border-radius: 100px;
    font-size: 15px;
    font-weight: 500;
    background: var(--surface);
    color: var(--text-primary);
    border: 1px solid var(--border-med);
    transition: all 0.2s ease;
  }

  .btn-secondary-hero:hover {
    border-color: var(--border-strong);
    background: var(--bg-inset);
    transform: translateY(-1px);
  }

  /* ── MOCKUP ── */
  .mockup-frame {
    width: 100%;
    max-width: 900px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-align: left;
    transform: translateY(0);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    animation: fadeInUp 1.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mockup-frame:hover {
    transform: translateY(-4px);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.15);
  }

  .mockup-header {
    height: 40px;
    background: var(--bg-inset);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    padding: 0 16px;
  }

  .mockup-dots {
    display: flex;
    gap: 6px;
    width: 60px;
  }

  .mockup-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot-red { background: #ff5f56; }
  .dot-yellow { background: #ffbd2e; }
  .dot-green { background: #27c93f; }

  .mockup-address {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--text-muted);
    padding: 4px 16px;
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0 auto;
    width: 200px;
    justify-content: center;
  }

  .mockup-spacer {
    width: 60px;
  }

  .mockup-body {
    display: flex;
    height: 360px;
  }

  .mockup-sidebar {
    width: 160px;
    border-right: 1px solid var(--border);
    background: var(--bg-inset);
    padding: 16px 8px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  @media (max-width: 600px) {
    .mockup-sidebar {
      display: none;
    }
  }

  .sidebar-item {
    font-size: 12px;
    padding: 6px 12px;
    border-radius: 6px;
    color: var(--text-body);
    font-weight: 500;
  }

  .sidebar-item.active {
    background: var(--surface);
    color: var(--text-primary);
    box-shadow: var(--shadow-sm);
  }

  .mockup-content {
    flex-grow: 1;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .mockup-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .mockup-search {
    font-size: 11px;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 6px 12px;
    border-radius: 6px;
    width: 160px;
    background: var(--bg-inset);
  }

  .mockup-upload {
    font-size: 11px;
    background: var(--text-primary);
    color: var(--bg);
    padding: 6px 12px;
    border-radius: 6px;
    font-weight: 500;
  }

  .mockup-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    flex-grow: 1;
  }

  @media (max-width: 480px) {
    .mockup-grid {
      grid-template-columns: 1fr;
    }
  }

  .mockup-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--surface);
  }

  .card-thumb {
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    color: #fff;
    padding: 10px;
    text-align: center;
  }

  .image-thumb { background: linear-gradient(135deg, #6366f1, #a855f7); }
  .video-thumb { background: linear-gradient(135deg, #ec4899, #f43f5e); }
  .audio-thumb { background: linear-gradient(135deg, #10b981, #059669); }

  .card-info {
    padding: 8px 10px;
    border-top: 1px solid var(--border);
  }

  .card-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-meta {
    font-size: 9px;
    color: var(--text-muted);
  }

  /* ── STATS ── */
  .stats-section {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--bg-inset);
    padding: 48px 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    text-align: center;
  }

  @media (max-width: 768px) {
    .stats-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .stat-num {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .stat-label {
    font-size: 13px;
    color: var(--text-body);
    max-width: 240px;
    margin: 0 auto;
  }

  /* ── FEATURES ── */
  .features-section {
    padding: 96px 0;
    background: var(--bg);
  }

  .section-header {
    text-align: center;
    margin-bottom: 64px;
  }

  .section-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--accent);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 8px;
  }

  .section-title {
    font-size: clamp(28px, 4vw, 36px);
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.03em;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 960px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }

  .feature-card {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 32px 24px;
    border-radius: 12px;
    transition: all 0.2s ease;
    box-shadow: var(--shadow-sm);
  }

  .feature-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .feature-icon {
    font-size: 24px;
    margin-bottom: 16px;
  }

  .feature-name {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .feature-desc {
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-body);
  }

  /* ── WORKFLOW ── */
  .workflow-section {
    padding: 96px 0;
    background: var(--bg-inset);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .workflow-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  @media (max-width: 768px) {
    .workflow-steps {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  .workflow-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
  }

  .step-badge {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--text-primary);
    color: var(--bg);
    font-size: 14px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .step-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .step-desc {
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-body);
    max-width: 280px;
  }

  /* ── CTA BANNER ── */
  .cta-banner-section {
    padding: 120px 24px;
    background: var(--text-primary);
    color: var(--bg);
    text-align: center;
  }

  .cta-banner-container {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .cta-banner-title {
    font-size: clamp(28px, 5vw, 44px);
    font-weight: 600;
    color: var(--bg);
    letter-spacing: -0.04em;
    margin: 0;
  }

