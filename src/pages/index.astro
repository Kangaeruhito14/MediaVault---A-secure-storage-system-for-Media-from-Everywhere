---
import PublicLayout from '../layouts/PublicLayout.astro';

// Static CTAs — auth happens client-side in the /app area (E2EE).
const primaryCtaText = 'Get Started';
const primaryCtaPath = '/app';
const secondaryCtaText = 'How it works';
const secondaryCtaPath = '/about';

const origin = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '') || Astro.url.origin;

// Alternate names people actually search for — surfaced as schema.org alternateName
// so the same product can match many "media vault / store / locker / archive" queries.
const aliases = [
  'Media Reservoir', 'Media Vault', 'MediaVault', 'Open Media Vault',
  'Media Store', 'Media Storage', 'Media Repository', 'Media Archive',
  'Media Library', 'Media Locker', 'Media Safe', 'Media Reserve',
  'Media Cloud', 'Media Backup', 'Media Hub', 'Media Depot', 'Media Trove', 'Media Haven',
  'Asset Vault', 'Asset Reserve', 'Asset Haven', 'Asset Locker', 'Digital Asset Vault',
  'Photo Vault', 'Video Vault', 'Encrypted Media Vault', 'Encrypted Photo Vault',
  'Secure Media Storage', 'Private Media Library', 'Zero-Knowledge Vault',
  'Encrypted Cloud Storage', 'Private Cloud Storage',
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Media Reservoir',
    alternateName: aliases,
    url: origin,
    description:
      'Free, open-source, end-to-end encrypted vault — a private Google Photos & cloud-drive alternative that encrypts photos, videos, audio, PDFs, and documents in your browser and stores them in cloud storage you own.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Media Reservoir',
    alternateName: aliases,
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any modern web browser',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description:
      'End-to-end encrypted vault for photos, videos, audio, PDFs, and documents. Files are encrypted in the browser and stored in your own S3-compatible cloud; the operator can never read them. Includes seekable encrypted streaming, in-app document/PDF viewing, and recovery-key reset.',
    featureList: [
      'End-to-end encryption — keys never leave your device',
      'Bring your own storage (Cloudflare R2, Backblaze B2, Wasabi, S3)',
      'Zero-knowledge: the operator stores only ciphertext',
      'Seekable encrypted video & audio streaming',
      'Encrypted thumbnails for fast galleries',
      'Recovery-key password reset; multi-device; installable PWA',
    ],
    url: origin,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Media Reservoir',
    alternateName: aliases,
    url: origin,
    logo: origin + '/og-image.png',
    description:
      'Free, open-source, end-to-end encrypted media vault — a private alternative to Google Photos that stores your files in storage you own.',
    sameAs: [
      'https://github.com/Kangaeruhito14/MediaVault---A-secure-storage-system-for-Media-from-Everywhere',
    ],
  },
];
---

<PublicLayout
  title="Media Reservoir — End-to-End Encrypted Media, on Storage You Own"
  description="Media Reservoir encrypts your photos, videos, audio, PDFs, and documents in your browser, then stores them in your own cloud (Cloudflare R2, Backblaze B2, Wasabi, S3). The keys never leave your device — so not even we can read your files. Free, open-source, multi-device."
  jsonLd={jsonLd}
>

  <!-- ══ HERO ══ -->
  <section class="hero">
    <div class="section-container hero-inner">
      <div class="eyebrow" data-reveal>
        <img src="/logo.png" alt="" width="18" height="18" />
        <span>End-to-end encrypted · Zero-knowledge · Your storage</span>
      </div>

      <h1 class="hero-title" data-reveal data-reveal-delay="60">
        Your media, locked before<br class="hero-br" /> it leaves your device.
      </h1>

      <p class="hero-lead" data-reveal data-reveal-delay="120">
        Media Reservoir seals your photos, videos, audio and documents in your browser —
        then hands the encrypted files to a cloud bucket <strong>you own</strong>. The keys
        never touch our servers, so no one else can open them. Not advertisers. Not hackers.
        <strong>Not even us.</strong>
      </p>

      <div class="cta-row" data-reveal data-reveal-delay="180">
        <a href={primaryCtaPath} class="btn-hero-primary">
          {primaryCtaText}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href={secondaryCtaPath} class="btn-hero-ghost">{secondaryCtaText}</a>
      </div>

      <ul class="trust-row" data-reveal data-reveal-delay="220">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>AES-256 in your browser</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Bring your own storage</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Free &amp; open-source</li>
      </ul>

      <figure class="hero-visual" data-reveal data-reveal-delay="280">
        <img
          class="hero-img"
          src="/hero.png"
          width="1536" height="1024"
          alt="A glowing encrypted vault holding photos, video, and audio — sealed with a lock and key, floating in cloud storage you own."
          fetchpriority="high" decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- ══ STATS BAND ══ -->
  <section class="stats">
    <div class="section-container stats-grid">
      <div class="stat" data-reveal>
        <div class="stat-num">0</div>
        <p class="stat-label">Files we can read. Your keys never leave your device.</p>
      </div>
      <div class="stat" data-reveal data-reveal-delay="80">
        <div class="stat-num">100%</div>
        <p class="stat-label">End-to-end encrypted — before anything is uploaded.</p>
      </div>
      <div class="stat" data-reveal data-reveal-delay="160">
        <div class="stat-num">&infin;</div>
        <p class="stat-label">Bring your own storage — any S3-compatible cloud.</p>
      </div>
    </div>
  </section>

  <!-- ══ FEATURES (icons from illustrations.png) ══ -->
  <section class="features">
    <div class="section-container">
      <header class="section-head" data-reveal>
        <span class="eyebrow-mono">How it protects you</span>
        <h2 class="section-title">Private by architecture, not by promise.</h2>
        <p class="section-lead">Security you don't have to take on faith. The design itself makes your files
          unreadable to us — there is nothing to trust, only math to verify.</p>
      </header>

      <div class="features-grid">
        <article class="feature" data-reveal>
          <span class="fi fi-shield" aria-hidden="true"></span>
          <h3>Zero-knowledge encryption</h3>
          <p>Every file is sealed in your browser with AES-256 before it's uploaded. We only ever hold ciphertext we cannot read.</p>
        </article>
        <article class="feature" data-reveal data-reveal-delay="60">
          <span class="fi fi-cloud" aria-hidden="true"></span>
          <h3>Bring your own storage</h3>
          <p>Connect Cloudflare R2, Backblaze B2, Wasabi, Dropbox, or any S3 bucket. Files live in your account — never on our servers.</p>
        </article>
        <article class="feature" data-reveal data-reveal-delay="120">
          <span class="fi fi-stream" aria-hidden="true"></span>
          <h3>Seekable streaming</h3>
          <p>Range-based decryption reads only the slice you're watching, so you can jump anywhere in a multi-GB video instantly.</p>
        </article>
        <article class="feature" data-reveal>
          <span class="fi fi-photo" aria-hidden="true"></span>
          <h3>Encrypted thumbnails</h3>
          <p>Previews are generated and encrypted in your browser, so galleries load fast without ever exposing the full files.</p>
        </article>
        <article class="feature" data-reveal data-reveal-delay="60">
          <span class="fi fi-key" aria-hidden="true"></span>
          <h3>Recovery key</h3>
          <p>Forgot your password? A one-time recovery key restores access. Lose both and not even we can help — that's the whole point.</p>
        </article>
        <article class="feature" data-reveal data-reveal-delay="120">
          <span class="fi fi-devices" aria-hidden="true"></span>
          <h3>Every device</h3>
          <p>Sign in from any device; your library syncs through a tiny encrypted index. Installable as an app (PWA) on phone and desktop.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ══ ENCRYPTION FLOW ══ -->
  <section class="flow">
    <div class="section-container">
      <header class="section-head" data-reveal>
        <span class="eyebrow-mono">Zero-knowledge by design</span>
        <h2 class="section-title">Sealed before we ever touch it.</h2>
        <p class="section-lead">Encryption happens on your device. Everything downstream — the network, our
          servers, your cloud — only ever handles ciphertext. There is nothing for us to read, leak, or hand over.</p>
      </header>

      <div class="flow-diagram" data-reveal data-reveal-delay="80">
        <div class="flow-node">
          <div class="flow-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><circle cx="8.5" cy="9" r="1.4"/><path d="m4 15 4.5-4 3.5 3 3-2.5 4 3.5"/></svg>
          </div>
          <div class="flow-label">Your device</div>
          <div class="flow-sub">The original file</div>
        </div>

        <div class="flow-link"><span class="flow-dot"></span><span class="flow-dot"></span><span class="flow-dot"></span></div>

        <div class="flow-node flow-node-hl">
          <div class="flow-icon flow-lock">
            <span class="flow-pulse"></span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4.5" y="11" width="15" height="9.5" rx="2.2"/><path d="M8 11V7.5a4 4 0 0 1 8 0V11"/><circle cx="12" cy="15.5" r="1.4"/></svg>
          </div>
          <div class="flow-label">Encrypted in your browser</div>
          <div class="flow-sub">AES-256 · your key never leaves</div>
        </div>

        <div class="flow-link flow-link-cipher"><span class="flow-dot"></span><span class="flow-dot"></span><span class="flow-dot"></span></div>

        <div class="flow-node">
          <div class="flow-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19a4.5 4.5 0 0 0 .8-8.93A6 6 0 0 0 6.6 9.2 4 4 0 0 0 6.5 19z"/></svg>
          </div>
          <div class="flow-label">Your cloud bucket</div>
          <div class="flow-sub">Ciphertext, in storage you own</div>
        </div>
      </div>

      <div class="flow-callout" data-reveal data-reveal-delay="160">
        <span class="flow-callout-dot"></span>
        <span class="flow-callout-label">All our servers ever see:</span>
        <code class="flow-cipher" id="flow-cipher">a3f9c1e08b2d47…</code>
      </div>
    </div>
  </section>

  <!-- ══ HOW IT WORKS ══ -->
  <section class="workflow">
    <div class="section-container">
      <header class="section-head" data-reveal>
        <span class="eyebrow-mono">Quick start</span>
        <h2 class="section-title">Three steps to a private library.</h2>
      </header>

      <div class="workflow-steps">
        <div class="workflow-step" data-reveal>
          <div class="step-badge">1</div>
          <h3>Create your account</h3>
          <p>Sign up — your password derives your encryption key right in the browser. Save your one-time recovery key.</p>
        </div>
        <div class="workflow-step" data-reveal data-reveal-delay="80">
          <div class="step-badge">2</div>
          <h3>Connect your storage</h3>
          <p>Link your own cloud bucket (R2, Backblaze B2, Wasabi, S3). Files go straight there — never through us.</p>
        </div>
        <div class="workflow-step" data-reveal data-reveal-delay="160">
          <div class="step-badge">3</div>
          <h3>Upload &amp; enjoy</h3>
          <p>Drag in photos and videos — encrypted locally, then streamed, searched, and viewed across all your devices.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ "CALL IT WHAT YOU LIKE" (readable synonym coverage for search) ══ -->
  <section class="aka">
    <div class="section-container aka-inner" data-reveal>
      <span class="eyebrow-mono">Call it what you like</span>
      <p class="aka-text">
        An <strong>encrypted photo vault</strong>. A <strong>private media library</strong>. A
        <strong>zero-knowledge asset locker</strong>. A <strong>secure media store</strong> on cloud
        you own. A <strong>Google Photos alternative</strong> that genuinely can't read your files.
        However you found it — that's <strong>Media Reservoir</strong>.
      </p>
    </div>
  </section>

  <!-- ══ CTA BANNER (aurora backdrop) ══ -->
  <section class="cta-banner">
    <div class="section-container cta-banner-inner" data-reveal>
      <h2 class="cta-banner-title">Take back your memories.</h2>
      <p class="cta-banner-desc">Free, open-source, end-to-end encrypted. Your media, your cloud, your keys — not the tech giants'.</p>
      <a href={primaryCtaPath} class="btn-hero-primary btn-cta">{primaryCtaText}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </section>

</PublicLayout>

<script>
  // Live "ciphertext" scramble in the encryption-flow callout — cycles hex while
  // in view for a sense of active encryption. Paused off-screen + for reduced-motion.
  function initCipherScramble() {
    const el = document.getElementById('flow-cipher');
    if (!el) return;
    (window as any).__cipherCleanup?.();
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const hex = '0123456789abcdef';
    let timer = 0;
    const tick = () => {
      let s = '';
      for (let i = 0; i < 12; i++) s += hex[(Math.random() * 16) | 0];
      el.textContent = s + '…';
    };
    const io = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting && !timer) timer = window.setInterval(tick, 90);
      else if (!entries[0].isIntersecting && timer) { clearInterval(timer); timer = 0; }
    }, { threshold: 0.25 });
    io.observe(el);
    (window as any).__cipherCleanup = () => { if (timer) clearInterval(timer); io.disconnect(); };
  }
  document.addEventListener('astro:page-load', initCipherScramble);
</script>

<style>
  .section-container {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 2;
  }

  /* Shared section headers */
  .section-head { text-align: center; max-width: 680px; margin: 0 auto 60px; }
  .eyebrow-mono {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 500; text-transform: uppercase;
    color: var(--accent); letter-spacing: 0.14em; display: block; margin-bottom: 14px;
  }
  .section-title {
    font-size: clamp(27px, 3.6vw, 38px); font-weight: 600;
    color: var(--text-primary); letter-spacing: -0.035em; line-height: 1.12; margin: 0;
  }
  .section-lead {
    font-size: 16px; line-height: 1.65; color: var(--text-body); margin: 18px auto 0; max-width: 600px;
  }

  /* ══ HERO ══ */
  .hero {
    position: relative;
    padding: 128px 0 96px;
    text-align: center;
    overflow: hidden;
    /* Aurora backdrop (owner's ornament.png) fading into the page background,
       with a dark scrim so text stays legible. Composited in one property. */
    background:
      linear-gradient(180deg, rgba(10,10,10,0.62) 0%, rgba(10,10,10,0.35) 34%, rgba(10,10,10,0.86) 78%, #0a0a0a 100%),
      radial-gradient(ellipse 90% 60% at 50% 0%, rgba(99,102,241,0.18), transparent 70%),
      url('/ornament.png') center top / cover no-repeat;
  }

  .hero-inner { display: flex; flex-direction: column; align-items: center; }

  .eyebrow {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 7px 16px 7px 10px; margin-bottom: 26px;
    border: 1px solid var(--border-med); border-radius: 100px;
    background: rgba(255,255,255,0.04); backdrop-filter: blur(8px);
    font-size: 12.5px; font-weight: 500; color: var(--text-body); letter-spacing: 0.01em;
  }
  .eyebrow img { display: block; filter: drop-shadow(0 1px 4px rgba(124,58,237,0.5)); }

  .hero-title {
    font-size: clamp(38px, 6.2vw, 66px); font-weight: 600;
    color: var(--text-primary); letter-spacing: -0.045em; line-height: 1.04;
    max-width: 860px; margin: 0 0 24px;
  }

  .hero-lead {
    font-size: clamp(16px, 2.4vw, 19px); color: var(--text-body);
    line-height: 1.62; max-width: 640px; margin: 0 0 36px;
  }
  .hero-lead strong { color: var(--text-primary); font-weight: 600; }

  .cta-row { display: flex; gap: 14px; align-items: center; justify-content: center; }
  @media (max-width: 480px) { .cta-row { flex-direction: column; width: 100%; } }

  .btn-hero-primary {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    height: 50px; padding: 0 30px; border-radius: 100px;
    font-size: 15px; font-weight: 600; letter-spacing: -0.01em;
    background: linear-gradient(135deg, #6366f1, #7c3aed);
    color: #fff;
    box-shadow: 0 10px 30px -8px rgba(109, 74, 232, 0.6), inset 0 1px 0 rgba(255,255,255,0.18);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .btn-hero-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 40px -10px rgba(109, 74, 232, 0.75), inset 0 1px 0 rgba(255,255,255,0.22);
    color: #fff;
  }
  .btn-hero-primary:active { transform: translateY(0); }

  .btn-hero-ghost {
    display: inline-flex; align-items: center; justify-content: center;
    height: 50px; padding: 0 28px; border-radius: 100px;
    font-size: 15px; font-weight: 500;
    background: rgba(255,255,255,0.05); color: var(--text-primary);
    border: 1px solid var(--border-med);
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }
  .btn-hero-ghost:hover {
    border-color: var(--border-strong); background: rgba(255,255,255,0.08);
    transform: translateY(-1px); color: var(--text-primary);
  }
  @media (max-width: 480px) { .btn-hero-primary, .btn-hero-ghost { width: 100%; } }

  .trust-row {
    list-style: none; margin: 30px 0 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 10px 26px; justify-content: center;
  }
  .trust-row li {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 13.5px; color: var(--text-body);
  }
  .trust-row svg { width: 15px; height: 15px; color: #34d399; flex: none; }

  /* Hero centerpiece image (owner's glass-vault). Edge-masked + glow so its dark
     background dissolves into the section. */
  .hero-visual { position: relative; width: 100%; max-width: 780px; margin: 66px auto 0; }
  .hero-visual::before {
    content: ''; position: absolute; inset: 6% 8% 10%;
    background: radial-gradient(ellipse at 50% 48%, rgba(96,132,255,0.42), rgba(124,58,237,0.20) 46%, transparent 72%);
    filter: blur(78px); z-index: 0; pointer-events: none;
  }
  .hero-img {
    position: relative; z-index: 1; width: 100%; height: auto; display: block;
    -webkit-mask: radial-gradient(ellipse 84% 82% at 50% 48%, #000 62%, transparent 100%);
            mask: radial-gradient(ellipse 84% 82% at 50% 48%, #000 62%, transparent 100%);
    animation: heroFloat 8s ease-in-out infinite;
  }
  @keyframes heroFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-14px); } }
  @media (prefers-reduced-motion: reduce) { .hero-img { animation: none; } }

  /* ══ STATS ══ */
  .stats {
    border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
    background: var(--bg-inset); padding: 46px 0;
  }
  .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; text-align: center; }
  @media (max-width: 768px) { .stats-grid { grid-template-columns: 1fr; gap: 30px; } }
  .stat { display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .stat-num {
    font-size: clamp(36px, 5vw, 52px); font-weight: 700; letter-spacing: -0.04em; line-height: 1;
    background: linear-gradient(135deg, #ededed 20%, #7c8cff);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
  }
  .stat-label { font-size: 13px; color: var(--text-body); max-width: 240px; margin: 0; }

  /* ══ FEATURES ══ */
  .features { padding: 100px 0; }
  .features-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  @media (max-width: 940px) { .features-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .features-grid { grid-template-columns: 1fr; } }

  .feature {
    background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));
    border: 1px solid var(--border); border-radius: 18px;
    padding: 30px 26px;
    transition: transform 0.3s cubic-bezier(0.16,1,0.3,1), border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .feature:hover {
    transform: translateY(-4px); border-color: var(--border-strong);
    box-shadow: 0 20px 50px -24px rgba(99,102,241,0.55);
  }
  .feature h3 { font-size: 16px; font-weight: 600; color: var(--text-primary); margin: 0 0 8px; }
  .feature p { font-size: 13.5px; line-height: 1.55; color: var(--text-body); margin: 0; }

  /* Feature icons sliced from the owner's illustrations.png (3 cols × 2 rows).
     The 2:3-aspect window keeps a 300%×200% background square (no distortion);
     mix-blend-mode: screen drops the image's black backdrop over the card. */
  .fi {
    display: block; width: 58px; height: 87px; margin: -6px 0 14px -4px;
    background-image: url('/illustrations.png');
    background-repeat: no-repeat; background-size: 300% 200%;
    mix-blend-mode: screen;
  }
  .fi-shield  { background-position: 0%   0%;   }
  .fi-cloud   { background-position: 50%  0%;   }
  .fi-stream  { background-position: 100% 0%;   }
  .fi-photo   { background-position: 0%   100%; }
  .fi-key     { background-position: 50%  100%; }
  .fi-devices { background-position: 100% 100%; }

  /* ══ ENCRYPTION FLOW ══ */
  .flow { padding: 100px 0; background: var(--bg-inset); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .flow-diagram { display: flex; align-items: flex-start; justify-content: center; gap: 8px; margin: 0 auto; max-width: 900px; }
  .flow-node { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 11px; width: 210px; flex: none; }
