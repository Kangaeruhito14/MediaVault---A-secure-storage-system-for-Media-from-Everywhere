---
import PublicLayout from '../layouts/PublicLayout.astro';

const origin = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '') || Astro.url.origin;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: origin + '/' },
      { '@type': 'ListItem', position: 2, name: 'Report Abuse', item: origin + '/report' },
    ],
  },
];
---

<PublicLayout
  title="Report Abuse — Media Reservoir"
  description="How to report abuse or illegal use of Media Reservoir, and an honest explanation of what an end-to-end encrypted, zero-knowledge service can and cannot do about it."
  keywords={["report abuse", "Media Reservoir abuse", "DMCA", "report illegal content"]}
  jsonLd={jsonLd}
>
  <section class="legal-page">
    <div class="container-sm">
      <header class="legal-header">
        <span class="page-eyebrow">Trust &amp; Safety</span>
        <h1 class="page-title">Report Abuse.</h1>
        <p class="last-updated">We take reports seriously — and we tell you honestly what we can do.</p>
      </header>

      <div class="legal-content">
        <section class="legal-section">
          <h2>How to report</h2>
          <p>
            To report abuse, illegal use, or a violation of our <a href="/terms">Terms</a>, email
            <a href="mailto:fantasyfalcoon91@gmail.com">fantasyfalcoon91@gmail.com</a> with as much
            detail as you can. If your report concerns a specific account, include the account email
            address involved. We review every report.
          </p>
        </section>

        <section class="legal-section">
          <h2>What we can — and can't — do</h2>
          <p>
            Media Reservoir is <strong>end-to-end encrypted and zero-knowledge</strong>. Files are encrypted
            in the user's browser and stored in the user's own cloud; we never hold the keys or the file
            contents. That has real consequences for moderation, and we won't pretend otherwise:
          </p>
          <ul>
            <li><strong>We cannot see, scan, or hand over file contents</strong> — there is no key on our side, by design.</li>
            <li><strong>There is no public sharing or public links</strong> in Media Reservoir, so files are not exposed to others through the service.</li>
            <li><strong>We can act on accounts</strong>: where an account violates our Terms or the law, we can suspend or terminate it and remove its index from our systems.</li>
            <li><strong>We cannot delete files from a user's own storage</strong> — those live in a bucket we don't control. The account holder, or their storage provider, controls those.</li>
          </ul>
        </section>

        <section class="legal-section">
          <h2>Copyright (DMCA-style) notices</h2>
          <p>
            If you believe content is being stored in violation of your copyright, email us with the
            details and proof of ownership. Because we can't read encrypted content, we act at the
            account level and will cooperate with valid legal requests to the extent our zero-knowledge
            architecture allows.
          </p>
        </section>

        <section class="legal-section">
          <h2>Security vulnerabilities</h2>
          <p>
            Found a security issue? Please report it responsibly. See our
            <a href="/.well-known/security.txt">security.txt</a> (RFC 9116) for the disclosure contact,
            or email the address above. Security reports are especially welcome.
          </p>
        </section>
      </div>
    </div>
  </section>
</PublicLayout>

<style>
  .container-sm { max-width: 720px; margin: 0 auto; padding: 0 24px; }
  .legal-page { padding: 96px 0; }
  .legal-header {
    text-align: left; margin-bottom: 48px;
    border-bottom: 1px solid var(--border); padding-bottom: 24px;
  }
  .page-eyebrow {
    font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 500;
    text-transform: uppercase; color: var(--accent); letter-spacing: 0.08em;
    display: block; margin-bottom: 12px;
  }
  .page-title {
    font-size: clamp(32px, 5vw, 40px); font-weight: 600; letter-spacing: -0.04em;
    color: var(--text-primary); line-height: 1.1; margin-bottom: 8px;
  }
  .last-updated { font-size: 12px; color: var(--text-muted); }
  .legal-content { display: flex; flex-direction: column; gap: 32px; }
  .legal-section h2 {
    font-size: 18px; font-weight: 600; color: var(--text-primary);
    margin-bottom: 12px; letter-spacing: -0.02em;
  }
  .legal-section p { font-size: 14px; line-height: 1.65; color: var(--text-body); }
  .legal-section ul {
    margin-left: 20px; margin-top: 8px; font-size: 14px; line-height: 1.65;
    color: var(--text-body); display: flex; flex-direction: column; gap: 8px;
  }
  .legal-section a { color: var(--accent); text-decoration: underline; }
  .legal-section a:hover { color: var(--accent-hover); }
</style>
