---
import PublicLayout from '../layouts/PublicLayout.astro';

const origin = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '') || Astro.url.origin;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: origin + '/' },
      { '@type': 'ListItem', position: 2, name: 'Terms & Conditions', item: origin + '/terms' },
    ],
  },
];
---

<PublicLayout
  title="Terms & Conditions — Self-Hosting MediaVault"
  description="The terms for running MediaVault: free for personal self-hosting, your data stays yours, no warranty, and your responsibilities as the operator of your own vault."
  jsonLd={jsonLd}
>
  <section class="legal-page">
    <div class="container-sm">
      <header class="legal-header">
        <span class="page-eyebrow">Legal Document</span>
        <h1 class="page-title">Terms & Conditions.</h1>
        <p class="last-updated">Last updated: June 9, 2026</p>
      </header>

      <div class="legal-content">
        <section class="legal-section">
          <h2>1. Agreement to Terms</h2>
          <p>
            By downloading, installing, self-hosting, or operating the MediaVault application (the "Software"), you agree to be bound by these Terms and Conditions. If you do not agree to these terms, do not install or use the Software.
          </p>
        </section>

        <section class="legal-section">
          <h2>2. License to Use</h2>
          <p>
            MediaVault is provided as free, open-source software. You are granted the right to run, copy, modify, distribute, and compile the Software for personal or commercial use, provided that you retain all original copyright indicators.
          </p>
        </section>

        <section class="legal-section">
          <h2>3. Host Responsibility</h2>
          <p>
            Because MediaVault is self-hosted:
          </p>
          <ul>
            <li>You are solely responsible for securing the server or system hosting the Software.</li>
            <li>You are responsible for implementing access restrictions, network security, firewalls, and updates.</li>
            <li>You acknowledge that you retain sole responsibility for backing up your data to prevent accidental loss.</li>
          </ul>
        </section>

        <section class="legal-section">
          <h2>4. No Warranty</h2>
          <p class="warning-text">
            THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
          </p>
        </section>

        <section class="legal-section">
          <h2>5. User Content</h2>
          <p>
            MediaVault does not access, collect, index, parse, or transmit any user content uploaded to your private vault. You retain absolute ownership of all files. We have no mechanism to view or recover files stored on your machine.
          </p>
        </section>

        <section class="legal-section">
          <h2>6. Changes to Terms</h2>
          <p>
            These terms may be updated from time to time as new software releases occur. You are responsible for reviewing terms packaged in newer versions of the Software.
          </p>
        </section>

        <section class="legal-section">
          <h2>7. Contact Information</h2>
          <p>
            If you have questions about these Terms, you can contact the project maintainer at <a href="mailto:fantasyfalcoon91@gmail.com">fantasyfalcoon91@gmail.com</a>.
          </p>
        </section>
      </div>
    </div>
  </section>
</PublicLayout>

<style>
  .container-sm {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .legal-page {
    padding: 96px 0;
  }

  .legal-header {
    text-align: left;
    margin-bottom: 48px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 24px;
  }

  .page-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--accent);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 12px;
  }

  .page-title {
    font-size: clamp(32px, 5vw, 40px);
    font-weight: 600;
    letter-spacing: -0.04em;
    color: var(--text-primary);
    line-height: 1.1;
    margin-bottom: 8px;
  }

  .last-updated {
    font-size: 12px;
    color: var(--text-muted);
  }

  .legal-content {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .legal-section h2 {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 12px;
    letter-spacing: -0.02em;
  }

  .legal-section p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-body);
  }

  .legal-section ul {
    margin-left: 20px;
    margin-bottom: 16px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-body);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .warning-text {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    background: var(--bg-inset);
    border: 1px solid var(--border);
    padding: 16px;
    border-radius: 8px;
    color: var(--text-primary);
  }

  .legal-section a {
    color: var(--accent);
    text-decoration: underline;
  }

  .legal-section a:hover {
    color: var(--accent-hover);
  }
</style>
