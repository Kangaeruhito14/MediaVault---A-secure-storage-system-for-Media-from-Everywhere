---
import VaultLayout from '../../layouts/VaultLayout.astro';
import Toast from '../../components/Toast.astro';
import { getMediaById, formatBytes, mediaTypeFromMime } from '../../lib/storage';
import { isAuthenticated } from '../../lib/auth';

if (!isAuthenticated(Astro.request)) {
  return Astro.redirect('/login');
}

const { id } = Astro.params;
if (!id) return Astro.redirect('/vault');

const item = getMediaById(id);
if (!item) return Astro.redirect('/vault');

const type      = mediaTypeFromMime(item.mimeType);
const humanSize = formatBytes(item.size);
const uploadDate = new Date(item.uploadedAt).toLocaleString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric',
  hour: 'numeric', minute: '2-digit',
});
const mediaUrl = `/api/media/${item.id}`;

const typeLabel  = type === 'image' ? 'IMAGE' : type === 'video' ? 'VIDEO' : type === 'audio' ? 'AUDIO' : 'FILE';
const badgeClass = `badge badge-${type}`;
---

<VaultLayout title={item.originalName}>
  <div class="detail-outer" style="max-width: 1200px; margin: 0 auto; padding: 28px 24px 80px;">

    <!-- Breadcrumb -->
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 24px;">
      <a href="/vault" style="
        display: flex; align-items: center; gap: 6px;
        font-size: 13px; color: var(--text-muted);
        text-decoration: none; transition: color 0.15s;
      "
        onmouseenter="this.style.color='var(--text-primary)'"
        onmouseleave="this.style.color='var(--text-muted)'"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M9 12L4 7L9 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        My Vault
      </a>
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" style="color: var(--border-strong);">
        <path d="M4 2l4 4-4 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      </svg>
      <span style="font-size: 13px; color: var(--text-body); max-width: 280px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title={item.originalName}>
        {item.originalName}
      </span>
    </div>

    <!-- Main layout: viewer + sidebar -->
    <div id="viewer-layout" style="display: grid; grid-template-columns: 1fr 300px; gap: 20px; align-items: start;">

      <!-- ── MEDIA VIEWER ────────────────────────────────────────── -->
      <div style="
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        overflow: hidden;
        box-shadow: var(--card-shadow);
      ">

        {/* IMAGE */}
        {type === 'image' && (
          <div id="image-container" style="
            position: relative;
            min-height: 360px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--bg-inset);
            overflow: hidden;
            cursor: zoom-in;
          ">
            <img
              id="main-image"
              src={mediaUrl}
              alt={item.originalName}
              style="
                max-width: 100%;
                max-height: 72vh;
                object-fit: contain;
                display: block;
                transition: transform 0.25s ease;
                user-select: none;
              "
            />
            <!-- Zoom hint -->
            <div id="zoom-hint" style="
              position: absolute; bottom: 12px; right: 12px;
              background: rgba(0,0,0,0.55); backdrop-filter: blur(4px);
              color: #fff; font-size: 11px; padding: 4px 10px;
              border-radius: 100px; font-family: 'JetBrains Mono', monospace;
              pointer-events: none;
            ">Click to zoom</div>
            <!-- Zoom controls -->
            <div style="
              position: absolute; bottom: 12px; left: 12px;
              display: flex; gap: 6px;
            ">
              <button id="zoom-in-btn" title="Zoom in" style="
                width: 30px; height: 30px; border-radius: 50%;
                background: rgba(0,0,0,0.55); backdrop-filter: blur(4px);
                border: 1px solid rgba(255,255,255,0.15);
                color: #fff; cursor: pointer; font-size: 16px;
                display: flex; align-items: center; justify-content: center;
                transition: background 0.15s;
              ">+</button>
              <button id="zoom-out-btn" title="Zoom out" style="
                width: 30px; height: 30px; border-radius: 50%;
                background: rgba(0,0,0,0.55); backdrop-filter: blur(4px);
                border: 1px solid rgba(255,255,255,0.15);
                color: #fff; cursor: pointer; font-size: 18px; line-height: 1;
                display: flex; align-items: center; justify-content: center;
                transition: background 0.15s;
              ">−</button>
              <button id="zoom-reset-btn" title="Reset zoom" style="
                height: 30px; padding: 0 10px; border-radius: 100px;
                background: rgba(0,0,0,0.55); backdrop-filter: blur(4px);
                border: 1px solid rgba(255,255,255,0.15);
                color: #fff; cursor: pointer; font-size: 11px;
                font-family: 'JetBrains Mono', monospace;
                display: flex; align-items: center;
                transition: background 0.15s;
              ">Reset</button>
            </div>
          </div>
        )}

        {/* VIDEO */}
        {type === 'video' && (
          <div style="
            background: #000;
            display: flex; align-items: center; justify-content: center;
            min-height: 360px;
            border-radius: var(--radius-xl);
          ">
            <video
              id="video-player"
              src={mediaUrl}
              controls
              preload="metadata"
              style="
                width: 100%;
                max-height: 72vh;
                display: block;
                border-radius: var(--radius-xl);
              "
            >
              Your browser does not support the video element.
            </video>
          </div>
        )}

        {/* AUDIO */}
        {type === 'audio' && (
          <div style="
            padding: 48px 32px;
            display: flex; flex-direction: column; align-items: center; gap: 28px;
            background: linear-gradient(135deg, var(--bg-inset) 0%, var(--card) 100%);
          ">
            <!-- Album art animation -->
            <div id="disc" style="
              width: 180px; height: 180px; border-radius: 50%;
              background: radial-gradient(circle at 40% 35%, #2a2a2a 0%, #0a0a0a 70%);
              display: flex; align-items: center; justify-content: center;
              box-shadow: 0 12px 40px rgba(0,0,0,0.4), 0 4px 8px rgba(0,0,0,0.3), inset 0 1px 1px rgba(255,255,255,0.08);
              position: relative;
              transition: transform 0.3s ease;
            ">
              <!-- Grooves -->
              <div style="position:absolute;inset:0;border-radius:50%;background:repeating-conic-gradient(rgba(255,255,255,0.015) 0deg, transparent 0.5deg, transparent 2deg);"></div>
              <!-- Center hole -->
              <div style="
                width: 48px; height: 48px; border-radius: 50%;
                background: var(--bg); border: 3px solid var(--border-med);
                display: flex; align-items: center; justify-content: center;
                z-index: 1;
              ">
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
                  <path d="M8 16V7l11-2.5v9M8 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM19 13a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" stroke="var(--text-muted)" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
              </div>
              <!-- Highlight -->
              <div style="position:absolute;top:15%;left:20%;width:30%;height:20%;background:radial-gradient(ellipse,rgba(255,255,255,0.06) 0%,transparent 80%);border-radius:50%;"></div>
            </div>

            <!-- Track name -->
            <div style="text-align: center;">
              <p style="font-size: 17px; font-weight: 600; color: var(--text-primary); letter-spacing: -0.04em; margin: 0 0 4px;">{item.originalName.replace(/\.[^.]+$/, '')}</p>
              <p style="font-size: 12px; color: var(--text-muted); font-family: 'JetBrains Mono', monospace; margin: 0;">{humanSize}</p>
            </div>

            <!-- Audio player -->
            <audio
              id="audio-player"
              src={mediaUrl}
              controls
              preload="metadata"
              style="width: 100%; max-width: 420px;"
            >
              Your browser does not support the audio element.
            </audio>
          </div>
        )}

        {/* OTHER */}
        {type === 'other' && (
          <div style="
            padding: 72px 48px;
            display: flex; flex-direction: column; align-items: center; gap: 20px;
            background: var(--bg-inset);
          ">
            <div style="
              width: 80px; height: 80px;
              background: var(--card); border: 1px solid var(--border-med);
              border-radius: 20px;
              display: flex; align-items: center; justify-content: center;
              box-shadow: var(--shadow-md);
            ">
              <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
                <path d="M8 4h16l8 8v20a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" stroke="var(--border-strong)" stroke-width="1.4"/>
                <path d="M24 4v8h8" stroke="var(--border-strong)" stroke-width="1.4"/>
              </svg>
            </div>
            <div style="text-align: center;">
              <p style="font-size: 15px; font-weight: 500; color: var(--text-primary); margin: 0 0 6px;">Preview unavailable</p>
              <p style="font-size: 13px; color: var(--text-muted); margin: 0;">This file type cannot be previewed in the browser.</p>
            </div>
            <a href={mediaUrl} download={item.originalName} class="btn-primary" style="text-decoration: none;">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M7 2v7M4.5 6.5L7 9 9.5 6.5M2 12h10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Download file
            </a>
          </div>
        )}
      </div>

      <!-- ── INFO SIDEBAR ────────────────────────────────────────── -->
      <div style="
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        padding: 20px;
        box-shadow: var(--card-shadow);
        display: flex; flex-direction: column; gap: 16px;
      ">
        <!-- Type badge + name -->
        <div>
          <span class={badgeClass} style="margin-bottom: 8px; display: inline-flex;">{typeLabel}</span>
          <p style="margin: 0; font-size: 14px; font-weight: 500; color: var(--text-primary); word-break: break-word; letter-spacing: -0.02em; line-height: 1.4;">
            {item.originalName}
          </p>
        </div>

        <div class="divider"></div>

        <!-- Metadata -->
        <div style="display: flex; flex-direction: column; gap: 12px;">
          {[
            { label: 'MIME TYPE', value: item.mimeType },
            { label: 'SIZE',      value: humanSize },
            { label: 'UPLOADED',  value: uploadDate },
          ].map(({ label, value }) => (
            <div>
              <p style="margin: 0 0 3px; font-size: 10px; color: var(--text-faint); font-family: 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: 0.08em;">{label}</p>
              <p style="margin: 0; font-size: 12px; color: var(--text-body); word-break: break-all; font-family: 'JetBrains Mono', monospace;">{value}</p>
            </div>
          ))}
        </div>

        <div class="divider"></div>

        <!-- Actions -->
        <div style="display: flex; flex-direction: column; gap: 8px;">
          <a
            href={mediaUrl}
            download={item.originalName}
            class="btn-primary"
            style="text-decoration: none; justify-content: center; width: 100%;"
          >
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M7 2v7M4.5 6.5L7 9 9.5 6.5M2 12h10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Download
          </a>

          <button
            id="bookmark-btn"
            data-id={item.id}
            data-bookmarked={String(!!item.bookmarked)}
            style="
              width: 100%; height: 36px;
              display: flex; align-items: center; justify-content: center; gap: 6px;
              font-size: 13px; font-weight: 500; font-family: inherit;
              color: var(--text-body);
              background: var(--card);
              border: 1px solid var(--border-med);
              border-radius: var(--radius-full);
              cursor: pointer; transition: all 0.15s;
            "
            onmouseenter="this.style.borderColor='var(--border-strong)';"
            onmouseleave="this.style.borderColor='var(--border-med)';"
          >
            <svg id="detail-star-icon" width="13" height="13" viewBox="0 0 16 16" fill={item.bookmarked ? "#fbbf24" : "none"} stroke={item.bookmarked ? "#fbbf24" : "currentColor"} stroke-width="1.3">
              <path d="M8 12.05l-3.8 2.3.7-4.27-3.1-3 4.3-.63L8 2.5l1.9 3.95 4.3.63-3.1 3 .7 4.27z"/>
            </svg>
            <span id="bookmark-text">{item.bookmarked ? 'Remove bookmark' : 'Bookmark file'}</span>
          </button>

          <button
            id="delete-btn"
            data-id={item.id}
            data-name={item.originalName}
            style="
              width: 100%; height: 36px;
              display: flex; align-items: center; justify-content: center; gap: 6px;
              font-size: 13px; font-weight: 500; font-family: inherit;
              color: var(--destructive);
              background: var(--destructive-bg);
              border: 1px solid transparent;
              border-radius: var(--radius-full);
              cursor: pointer; transition: all 0.15s;
            "
            onmouseenter="this.style.filter='brightness(1.1)'; this.style.borderColor='rgba(248,113,113,0.2)'"
            onmouseleave="this.style.filter=''; this.style.borderColor='transparent'"
          >
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
              <path d="M2 3.5h9M5 3.5v-1.5h3v1.5M5.5 5.5v4M7.5 5.5v4M3 3.5l.5 7.5h6l.5-7.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
            Delete file
          </button>
        </div>
      </div>
    </div>
  </div>

  <Toast />

  <!-- ── Delete confirmation modal ──────────────────────────── -->
  <div id="delete-modal" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title" style="display:none;">
    <div class="dm-backdrop" id="delete-modal-backdrop"></div>
    <div class="dm-panel">
      <div class="dm-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6M10 11v6M14 11v6" stroke="#f87171" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <h3 id="delete-modal-title" class="dm-title">Delete file?</h3>
      <p class="dm-body">Permanently delete<br/><strong class="dm-filename">{item.originalName}</strong>?<br/><span class="dm-warn">This action cannot be undone.</span></p>
      <div class="dm-actions">
        <button type="button" id="dm-cancel" class="dm-btn dm-btn-cancel">Cancel</button>
        <button type="button" id="dm-confirm" class="dm-btn dm-btn-confirm">
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
            <path d="M2 3.5h9M5 3.5v-1.5h3v1.5M5.5 5.5v4M7.5 5.5v4M3 3.5l.5 7.5h6l.5-7.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          </svg>
          Delete file
        </button>
      </div>
    </div>
  </div>

</VaultLayout>

<style>
  @media (max-width: 768px) {
    #viewer-layout {
      grid-template-columns: 1fr !important;
    }
  }
  @media (max-width: 480px) {
    .detail-outer {
      padding: 16px 12px 64px !important;
    }
    #viewer-layout {
      gap: 12px !important;
    }
  }
  /* Spinning disc animation when audio plays */
  @keyframes spin-disc {
    to { transform: rotate(360deg); }
  }
  #disc.playing {
    animation: spin-disc 4s linear infinite;
  }
  /* Delete modal */
  .dm-backdrop {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(6px);
    z-index: 9000;
    animation: dm-fade-in 0.18s ease;
  }
  .dm-panel {
    position: fixed;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    z-index: 9001;
    background: var(--card);
    border: 1px solid var(--border-med);
    border-radius: 20px;
    padding: 32px 28px 24px;
    width: min(90vw, 380px);
    box-shadow: 0 32px 80px rgba(0,0,0,0.5), 0 0 0 1px rgba(248,113,113,0.08);
    display: flex; flex-direction: column; align-items: center;
    gap: 12px;
    animation: dm-slide-in 0.22s cubic-bezier(0.34,1.56,0.64,1);
  }
  .dm-icon {
    width: 56px; height: 56px;
    border-radius: 50%;
    background: rgba(248,113,113,0.1);
    border: 1px solid rgba(248,113,113,0.2);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 4px;
  }
  .dm-title { font-size: 17px; font-weight: 700; color: var(--text-primary); letter-spacing: -0.04em; margin: 0; }
  .dm-body  { font-size: 13px; color: var(--text-muted); text-align: center; line-height: 1.6; margin: 0; }
  .dm-filename { color: var(--text-primary); font-weight: 500; word-break: break-all; }
  .dm-warn { font-size: 11.5px; color: var(--text-faint); font-family: 'JetBrains Mono', monospace; }
  .dm-actions { display: flex; gap: 8px; width: 100%; margin-top: 4px; }
  .dm-btn {
    flex: 1; height: 38px;
    display: flex; align-items: center; justify-content: center; gap: 6px;
    border-radius: 100px; font-size: 13px; font-weight: 500; font-family: inherit;
    cursor: pointer; transition: all 0.15s; border: 1px solid transparent;
  }
  .dm-btn-cancel { background: var(--bg-inset); border-color: var(--border-med); color: var(--text-body); }
  .dm-btn-cancel:hover { background: var(--hover-bg); border-color: var(--border-strong); }
  .dm-btn-confirm { background: rgba(248,113,113,0.15); border-color: rgba(248,113,113,0.3); color: #f87171; }
  .dm-btn-confirm:hover { background: rgba(248,113,113,0.25); border-color: rgba(248,113,113,0.5); }
  .dm-btn-confirm:disabled { opacity: 0.6; cursor: not-allowed; }
  @keyframes dm-fade-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes dm-slide-in {
    from { opacity: 0; transform: translate(-50%, -48%) scale(0.94); }
    to   { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  }
</style>

<script>
// ── Image zoom ────────────────────────────────────────────────────────────────
const imgContainer  = document.getElementById('image-container');
const mainImg       = document.getElementById('main-image') as HTMLImageElement | null;
const zoomHintEl    = document.getElementById('zoom-hint');
const zoomInBtn     = document.getElementById('zoom-in-btn');
const zoomOutBtn    = document.getElementById('zoom-out-btn');
const zoomResetBtn  = document.getElementById('zoom-reset-btn');

if (imgContainer && mainImg) {
  let scale = 1;

  function applyZoom() {
    mainImg!.style.transform = scale === 1 ? '' : `scale(${scale})`;
    imgContainer!.style.cursor = scale > 1 ? 'zoom-out' : 'zoom-in';
    if (zoomHintEl) zoomHintEl.textContent = scale > 1 ? `${Math.round(scale * 100)}%` : 'Click to zoom';
  }

  imgContainer.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('button')) return;
    scale = scale === 1 ? 2 : 1;
    applyZoom();
  });

  zoomInBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    scale = Math.min(scale + 0.5, 5);
    applyZoom();
  });
  zoomOutBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    scale = Math.max(scale - 0.5, 0.5);
    applyZoom();
  });
  zoomResetBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    scale = 1;
    applyZoom();
  });
}

// ── Spinning disc for audio ───────────────────────────────────────────────────
const audioPlayer = document.getElementById('audio-player') as HTMLAudioElement | null;
const disc        = document.getElementById('disc');
if (audioPlayer && disc) {
  audioPlayer.addEventListener('play',  () => disc.classList.add('playing'));
  audioPlayer.addEventListener('pause', () => disc.classList.remove('playing'));
  audioPlayer.addEventListener('ended', () => disc.classList.remove('playing'));
}

// ── Delete ───────────────────────────────────────────────────────────────────
const dmModal    = document.getElementById('delete-modal')!;
const dmBackdrop = document.getElementById('delete-modal-backdrop')!;
const dmCancel   = document.getElementById('dm-cancel')!;
const dmConfirm  = document.getElementById('dm-confirm')!;

function openDeleteModal(): Promise<boolean> {
  return new Promise((resolve) => {
    dmModal.style.display = 'block';
    document.body.style.overflow = 'hidden';
    function close(ok: boolean) {
      dmModal.style.display = 'none';
      document.body.style.overflow = '';
      dmCancel.removeEventListener('click', onNo);
      dmConfirm.removeEventListener('click', onYes);
      dmBackdrop.removeEventListener('click', onNo);
      document.removeEventListener('keydown', onKey);
      resolve(ok);
    }
    const onNo  = () => close(false);
    const onYes = () => close(true);
    const onKey = (ev: KeyboardEvent) => { if (ev.key === 'Escape') close(false); };
    dmCancel.addEventListener('click', onNo);
    dmConfirm.addEventListener('click', onYes);
    dmBackdrop.addEventListener('click', onNo);
    document.addEventListener('keydown', onKey);
  });
}

document.getElementById('delete-btn')?.addEventListener('click', async (e) => {
  const btn  = e.currentTarget as HTMLButtonElement;
  const id   = btn.dataset.id!;

  if (!(await openDeleteModal())) return;

  btn.disabled = true;
  btn.textContent = 'Deleting…';

  try {
    const res = await fetch(`/api/media/${id}`, { method: 'DELETE' });
    if (!res.ok) {
      const err = await res.json() as { error: string };
      document.dispatchEvent(new CustomEvent('toast', { detail: { type: 'error', message: err.error ?? 'Failed to delete.' } }));
      btn.disabled = false;
      btn.textContent = 'Delete file';
      return;
    }
    window.location.href = '/vault';
  } catch {
    document.dispatchEvent(new CustomEvent('toast', { detail: { type: 'error', message: 'Network error.' } }));
    btn.disabled = false;
    btn.textContent = 'Delete file';
  }
});

// ── Bookmark ─────────────────────────────────────────────────────────────────
const bookmarkBtn  = document.getElementById('bookmark-btn') as HTMLButtonElement | null;
const starIcon     = document.getElementById('detail-star-icon');
const bookmarkText = document.getElementById('bookmark-text');

bookmarkBtn?.addEventListener('click', async () => {
  const id = bookmarkBtn.dataset.id!;
  bookmarkBtn.disabled = true;

  try {
    const res = await fetch('/api/media/bookmark', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id })
    });
    const data = await res.json() as { ok?: boolean; bookmarked?: boolean; error?: string };
    if (!res.ok) {
      document.dispatchEvent(new CustomEvent('toast', { detail: { type: 'error', message: data.error ?? 'Failed to bookmark.' } }));
      return;
    }

    const nextBookmarked = !!data.bookmarked;
    bookmarkBtn.dataset.bookmarked = String(nextBookmarked);
    if (bookmarkText) bookmarkText.textContent = nextBookmarked ? 'Remove bookmark' : 'Bookmark file';
    if (starIcon) {
      starIcon.setAttribute('fill', nextBookmarked ? '#fbbf24' : 'none');
      starIcon.setAttribute('stroke', nextBookmarked ? '#fbbf24' : 'currentColor');
    }

    document.dispatchEvent(new CustomEvent('toast', {
      detail: { type: 'success', message: nextBookmarked ? 'File bookmarked.' : 'Bookmark removed.' }
    }));
  } catch {
    document.dispatchEvent(new CustomEvent('toast', { detail: { type: 'error', message: 'Network error.' } }));
  } finally {
    bookmarkBtn.disabled = false;
  }
});
</script>
