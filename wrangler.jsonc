{
  // MediaVault — Cloudflare bindings. The @astrojs/cloudflare adapter manages
  // the Worker entry/assets; we only declare bindings here. Resource IDs are
  // filled at provision time (validated with the wrangler skill before any run).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mediavault",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // Encrypted metadata index (no media, no readable user data).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mediavault",
      "database_id": "PLACEHOLDER_FILL_AT_PROVISION",
      "migrations_dir": "migrations"
    }
  ],

  // Rate-limit counters + Astro session store (fast edge reads).
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "PLACEHOLDER_FILL_AT_PROVISION"
    }
  ],

  "observability": {
    "enabled": true
  }
}
